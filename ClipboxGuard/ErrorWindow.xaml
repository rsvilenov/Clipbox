<Window
    x:Class="ClipboxGuard.ErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Clipbox.Core;assembly=Clipbox.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:ClipboxGuard"
    xmlns:localEnums="clr-namespace:ClipboxGuard.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Clipbox Guard"
    Width="625"
    Height="420"
    Background="#2d364c"
    BorderBrush="#007acc"
    BorderThickness="1"
    Foreground="Black"
    Icon="Resources/Icons/Logo.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Topmost="True"
    Visibility="Visible"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClipboxGuard;component/Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource MinimalisticScrollBarStyle}" TargetType="ScrollBar">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Margin" Value="0,5,2,5" />
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding
            Key="F4"
            Command="{Binding Path=DataContext.CloseWindowCommand, ElementName=mainGrid}"
            Modifiers="Alt" />
    </Window.InputBindings>
    <Grid x:Name="mainGrid" Margin="10,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  title bar  -->
        <Grid
            Grid.Row="0"
            Background="Transparent"
            MouseDown="CaptionGrid_MouseDown">
            <StackPanel
                Height="24"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ContentControl
                    Height="20"
                    Foreground="#f0f0f0"
                    Template="{StaticResource LogoIcon}" />
                <TextBlock
                    Margin="10,0,0,0"
                    FontSize="16"
                    Foreground="#f0f0f0"
                    Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=Title}" />
            </StackPanel>

            <Button
                Name="BtnCloseWindow"
                Width="35"
                Height="35"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding CloseWindowCommand}"
                Style="{StaticResource BtnWindowClose}" />
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl
                Grid.Column="0"
                Height="25"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="Red"
                Template="{StaticResource ErrorIconThin}" />
            <TextBlock
                Grid.Column="1"
                Margin="20,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Foreground="Red">
                <Run Text="{x:Static core:ProductConstants.PRODUCT_NAME}" /><Run Text=":" />
                <Run Text="{loc:Localize LBL_FATAL_ERROR, ResourceLookupMode=CurrentAssembly}" />
            </TextBlock>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            Orientation="Vertical">
            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                Foreground="LightGray"
                Text="{loc:Localize LBL_FAILED_COMPONENT,
                                    ResourceLookupMode=CurrentAssembly}" />
            <TextBlock
                FontSize="14"
                Foreground="LightGray"
                Text="{Binding ErrorOriginLabel}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid
            Grid.Row="3"
            Margin="0,15,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Bottom"
                FontSize="14"
                FontWeight="Bold"
                Foreground="LightGray"
                Text="{loc:Localize Key=LBL_ERROR_DETAILS,
                                    ResourceLookupMode=CurrentAssembly}"
                TextWrapping="Wrap" />
            <Button
                Grid.Row="0"
                Grid.Column="1"
                Width="35"
                Height="35"
                Margin="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Gray"
                BorderThickness="1"
                Command="{Binding CopyErrorDetailsCommand}"
                Foreground="White"
                Style="{StaticResource IconButton}"
                ToolTip="{loc:Localize BTN_COPY_ERROR_DETAILS}">
                <ContentControl Margin="5" Template="{StaticResource CopyIcon}" />
            </Button>
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,3,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="Black"
                BorderThickness="1">

                <ScrollViewer
                    Margin="5,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Visible">
                    <TextBlock
                        Foreground="LightGray"
                        Text="{Binding ErrorText}"
                        TextWrapping="Wrap" />
                </ScrollViewer>

            </Border>
        </Grid>

        <CheckBox
            Grid.Row="4"
            Height="30"
            Margin="0,10,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            FontSize="14"
            Foreground="#f0f0bd"
            IsChecked="{Binding IsRestartRequested}"
            Style="{StaticResource CheckBox}"
            Visibility="{Binding ShowRestartOption, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{loc:Localize CB_REQUEST_RESTART, ResourceLookupMode=CurrentAssembly}" />
        </CheckBox>
        <CheckBox
            Grid.Row="5"
            Height="30"
            Margin="0,5,5,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            FontSize="14"
            Foreground="#f0f0bd"
            IsChecked="{Binding IsSubmitErrorRequested}"
            Style="{StaticResource CheckBox}"
            Visibility="{Binding ShowSubmitOption, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{loc:Localize CB_SEND_ERROR, ResourceLookupMode=CurrentAssembly}" />
        </CheckBox>
        <ContentControl Grid.Row="6" Margin="0,5,5,5">
            <ContentControl.Template>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ProgressBar
                            x:Name="progressBar"
                            Grid.Row="0"
                            Grid.Column="0"
                            Height="10"
                            Background="#1e2434"
                            Foreground="#7ed5fa"
                            IsIndeterminate="True" />
                        <TextBlock
                            x:Name="statusTextBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,3,0,0"
                            Foreground="White" />
                        <TextBlock
                            x:Name="submitErrorTextBox"
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,3,0,0"
                            Foreground="Red"
                            Text="{Binding ReportSubmitErrorText}"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding StateOfReportSending}" Value="{x:Static localEnums:ReportSubmitState.None}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StateOfReportSending}" Value="{x:Static localEnums:ReportSubmitState.Requested}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StateOfReportSending}" Value="{x:Static localEnums:ReportSubmitState.Connecting}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter TargetName="progressBar" Property="IsIndeterminate" Value="True" />
                            <Setter TargetName="statusTextBox" Property="Text" Value="{loc:Localize LBL_STATUS_CONNECTING, ResourceLookupMode=CurrentAssembly}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StateOfReportSending}" Value="{x:Static localEnums:ReportSubmitState.Sending}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter TargetName="progressBar" Property="IsIndeterminate" Value="True" />
                            <Setter TargetName="statusTextBox" Property="Text" Value="{loc:Localize LBL_STATUS_SENDING, ResourceLookupMode=CurrentAssembly}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StateOfReportSending}" Value="{x:Static localEnums:ReportSubmitState.Done}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter TargetName="progressBar" Property="IsIndeterminate" Value="False" />
                            <Setter TargetName="progressBar" Property="Value" Value="100" />
                            <Setter TargetName="statusTextBox" Property="Text" Value="{loc:Localize LBL_STATUS_SENT, ResourceLookupMode=CurrentAssembly}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StateOfReportSending}" Value="{x:Static localEnums:ReportSubmitState.Error}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter TargetName="progressBar" Property="IsIndeterminate" Value="False" />
                            <Setter TargetName="progressBar" Property="Value" Value="100" />
                            <Setter TargetName="submitErrorTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="statusTextBox" Property="Foreground" Value="Red" />
                            <Setter TargetName="statusTextBox" Property="Text" Value="{loc:Localize LBL_STATUS_SEND_ERROR, ResourceLookupMode=CurrentAssembly}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ContentControl.Template>

        </ContentControl>
        <Button
            Grid.Row="7"
            Height="30"
            MinWidth="100"
            Margin="0,15,0,10"
            HorizontalAlignment="Center"
            Background="Transparent"
            Command="{Binding SendOrCloseCommand}"
            Foreground="White">
            <Button.Style>
                <Style BasedOn="{StaticResource BtnOk}" TargetType="Button">
                    <Setter Property="Content" Value="{loc:Localize BTN_SEND_REPORT}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StateOfReportSending}" Value="{x:Static localEnums:ReportSubmitState.Error}">
                            <Setter Property="Content" Value="OK" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StateOfReportSending}" Value="{x:Static localEnums:ReportSubmitState.Done}">
                            <Setter Property="Content" Value="OK" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSubmitErrorRequested}" Value="False">
                            <Setter Property="Content" Value="OK" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

    </Grid>
</Window>
