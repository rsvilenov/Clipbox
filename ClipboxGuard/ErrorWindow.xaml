<Window x:Class="ClipboxGuard.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClipboxGuard"
        mc:Ignorable="d"
        Title="Clipbox Guard" Height="350" Width="525" Visibility="Visible" ShowInTaskbar="True" Topmost="True" WindowStyle="ToolWindow">
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <TextBlock Text="Fatal error occurred" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="Red"  Grid.Row="0" />
        <TextBlock x:Name="exceptionTb" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" />
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Width="100" Content="Send" ></Button>
            <CheckBox IsChecked="{Binding IsRestartClientProcessCbChecked}" />
            <Button HorizontalAlignment="Left" Width="100" Content="Close" Click="Button_Click" ></Button>
        </DockPanel>
        
    </Grid>
</Window>
