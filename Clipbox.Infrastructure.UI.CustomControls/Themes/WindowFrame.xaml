<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI">

    <Style BasedOn="{StaticResource {x:Type Window}}" TargetType="{x:Type customControls:WindowFrame}">
        <Setter Property="CaptionForeground" Value="White" />
        <Setter Property="CaptionBackground" Value="Black" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="0" ResizeBorderThickness="5,1,5,5" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type customControls:WindowFrame}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid
                            x:Name="PART_Caption"
                            Grid.Row="0"
                            Background="{TemplateBinding CaptionBackground}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>


                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Panel.ZIndex="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding CaptionIconControl}"
                                    Foreground="{TemplateBinding CaptionForeground}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="7,0,0,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{TemplateBinding CaptionForeground}"
                                    Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=Title}" />

                                <Border
                                    x:Name="captionOpacityOverlay"
                                    Grid.ColumnSpan="2"
                                    Background="Black"
                                    Opacity="0.4" />
                            </Grid>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="Auto"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="minimizeWindow"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    MaxWidth="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Command="{Binding Source={x:Static SystemCommands.MinimizeWindowCommand}}"
                                    Style="{DynamicResource BtnWindowMinimize}"
                                    ToolTip="{TemplateBinding MinimizeBtnToolTip}">
                                    <i:Interaction.Behaviors>
                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                    </i:Interaction.Behaviors>
                                </Button>
                                <Button
                                    x:Name="maximizeButton"
                                    MaxWidth="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Command="{Binding Source={x:Static SystemCommands.MaximizeWindowCommand}}"
                                    Style="{DynamicResource BtnWindowMaximize}"
                                    ToolTip="{TemplateBinding MaximizeBtnToolTip}">
                                    <i:Interaction.Behaviors>
                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                    </i:Interaction.Behaviors>
                                </Button>
                                <Button
                                    x:Name="restoreButton"
                                    MaxWidth="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Command="{Binding Source={x:Static SystemCommands.RestoreWindowCommand}}"
                                    Style="{DynamicResource BtnWindowRestore}"
                                    ToolTip="{TemplateBinding RestoreBtnToolTip}">
                                    <i:Interaction.Behaviors>
                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                    </i:Interaction.Behaviors>
                                </Button>
                                <Button
                                    x:Name="closeWindow"
                                    MaxWidth="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Command="{Binding Source={x:Static SystemCommands.CloseWindowCommand}}"
                                    Style="{DynamicResource BtnWindowClose}"
                                    ToolTip="{TemplateBinding CloseBtnToolTip}">
                                    <i:Interaction.Behaviors>
                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                    </i:Interaction.Behaviors>
                                </Button>
                            </StackPanel>

                        </Grid>
                        <ContentPresenter Grid.Row="1" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Normal">
                            <Setter TargetName="restoreButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="maximizeButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="restoreButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="maximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="restoreButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="maximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsCloseButtonVisible" Value="False">
                            <Setter TargetName="closeWindow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMinimizeButtonVisible" Value="False">
                            <Setter TargetName="minimizeWindow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="captionOpacityOverlay" Property="Opacity" Value="0.2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>