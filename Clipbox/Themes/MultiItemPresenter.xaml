<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bo="clr-namespace:Clipbox.ViewModels.BindableObjects"
    xmlns:core="clr-namespace:Clipbox.Core;assembly=Clipbox.Core"
    xmlns:coreConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infPropAp="clr-namespace:Clipbox.Infrastructure.UI.AttachedProperties;assembly=Clipbox.Infrastructure.UI"
    xmlns:infWindows="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
    xmlns:local="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:localConv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:servicesEnums="clr-namespace:Clipbox.Services.Enums"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ControlTemplate x:Key="MultiItemPresenterLoading" TargetType="{x:Type local:MultiItemPresenter}">
        <Grid DataContext="{TemplateBinding ViewItemInfo}">

            <Grid.Resources>
                <SolidColorBrush
                    x:Key="GridBackgroundBrush"
                    Opacity="0.2"
                    Color="{Binding Path=PreviewContainerBackgroundColor, RelativeSource={RelativeSource Mode=TemplatedParent}}" />

                <localConv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
                <coreConv:MathAddConverter x:Key="MathAddConverter" />

                <Storyboard x:Key="FadeInItem">
                    <DoubleAnimation
                        Storyboard.TargetProperty="(UIElement.Opacity)"
                        From="0"
                        To="1"
                        Duration="0:0:0.7" />
                </Storyboard>
                <Storyboard x:Key="FadiInWithDelay">
                    <DoubleAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames
                        BeginTime="0:0:1.5"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0">
                        <DiscreteObjectKeyFrame Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <DoubleAnimation
                        BeginTime="0:0:1.5"
                        Storyboard.TargetProperty="(UIElement.Opacity)"
                        From="0"
                        To="0.6"
                        Duration="0:0:0.7" />
                </Storyboard>

                <Style x:Key="LoadingIndicatorContentControl" TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Setter Property="Opacity" Value="0.6" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsShownIntoView, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Path=IsEnabled, ElementName=IsLoadingIndicatorFadeInEnabledProxyElement}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="DelayShowStoryboard" Storyboard="{StaticResource FadiInWithDelay}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="DelayShowStoryboard" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsShownIntoView, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Path=IsEnabled, ElementName=IsLoadingIndicatorFadeInEnabledProxyElement}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsShownIntoView, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Path=IsLoadingFadeInEnabled, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FadeInItemContents" Storyboard="{StaticResource FadeInItem}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FadeInItemContents" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="15" />
                <RowDefinition />
                <RowDefinition Height="15" />
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <UIElement
                x:Name="IsLoadingIndicatorFadeInEnabledProxyElement"
                IsEnabled="{TemplateBinding IsLoadingIndicatorFadeInEnabled}"
                Visibility="Collapsed" />

            <Button
                Name="BtnScrollUpSubItem"
                Grid.Row="0"
                Grid.Column="2"
                Height="15"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Style="{DynamicResource BtnArrowUp}" />
            <Button
                Name="BtnScrollDownSubItem"
                Grid.Row="2"
                Grid.Column="2"
                Height="15"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Style="{DynamicResource BtnArrowDown}" />

            <TextBlock
                Grid.Row="3"
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                Text="{Binding TotalClipboardItemsCount, StringFormat={}{0} items}">
                <i:Interaction.Behaviors>
                    <infBeh:FrameworkElementDpiScalingBehavior />
                </i:Interaction.Behaviors>
            </TextBlock>

            <ListView
                Name="PART_SubItemsListView"
                Grid.Row="1"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                ItemsSource="{Binding PreviewItems}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <i:Interaction.Behaviors>
                    <localBeh:ListViewScrollButtonBehavior ButtonScrollDirection="Up" ScrollButton="{Binding ElementName=BtnScrollUpSubItem}" />
                    <localBeh:ListViewScrollButtonBehavior ButtonScrollDirection="Down" ScrollButton="{Binding ElementName=BtnScrollDownSubItem}" />
                </i:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border
                                        x:Name="Bd"
                                        Margin="5"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                        <Border.Height>
                                            <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ListView}" />
                                                <Binding>
                                                    <Binding.Source>
                                                        <!--  take into account the margin of the border (5 on top and 5 on bottom + 1 for border top and 1 for border bottom)  -->
                                                        <sys:Double>-15</sys:Double>
                                                    </Binding.Source>
                                                </Binding>
                                            </MultiBinding>
                                        </Border.Height>
                                        <!--  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"  -->

                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--<WrapPanel />-->
                        <UniformGrid
                            MaxWidth="500"
                            MaxHeight="500"
                            Columns="{Binding Path=NumberOfUniformGridColumns, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MultiItemPresenter}}" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ContentControl x:Name="ccSubItem">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItemDimension">

                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <Grid Background="{StaticResource GridBackgroundBrush}">

                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="30" />
                                                            </Grid.RowDefinitions>

                                                            <ContentControl
                                                                Grid.Row="0"
                                                                Grid.RowSpan="2"
                                                                Width="30"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="Gray"
                                                                Style="{StaticResource LoadingIndicatorContentControl}"
                                                                Template="{DynamicResource LoadingSolidIcon}" />

                                                            <!--  do not fill this rectangle with color for now, just allow it to take up the space of the preview item  -->
                                                            <Rectangle
                                                                Grid.Row="0"
                                                                Width="{Binding PreviewWidth}"
                                                                Height="{Binding PreviewHeight}"
                                                                Margin="5"
                                                                Fill="Transparent"
                                                                Opacity="0.2" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>

                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItemNMore">

                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <Grid Width="{Binding Path=Height, RelativeSource={RelativeSource Self}}" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}">
                                                            <i:Interaction.Behaviors>
                                                                <!--  ClipboardViewSubItemNMore elements are still selectable with a click despite ListViewItem.Focusable=False, so we need a behavior to cancel the click events  -->
                                                                <localBeh:FrameworkElementDisableClickBehavior AncestorElement="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}" />
                                                            </i:Interaction.Behaviors>
                                                            <Grid.ToolTip>
                                                                <TextBlock Text="{Binding Path=(bo:ClipboardViewSubItemNMore.NumberOfItems), StringFormat='{}{0:#} more files.'}" />
                                                            </Grid.ToolTip>
                                                            <Grid.Background>
                                                                <SolidColorBrush Opacity="0.1" Color="DarkGray" />
                                                            </Grid.Background>

                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="16"
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Text="{Binding Path=(bo:ClipboardViewSubItemNMore.NumberOfItems), StringFormat={}{0:+#}}">
                                                                <i:Interaction.Behaviors>
                                                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                                                </i:Interaction.Behaviors>
                                                            </TextBlock>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </ContentControl.Style>
                        </ContentControl>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="MultiItemPresenterLoaded" TargetType="{x:Type local:MultiItemPresenter}">
        <Grid DataContext="{TemplateBinding ViewItemWrapper}">
            <!--
                we need to set a background other than Null to this grid in order to make it hit-testable.
                If we leave the background to null, then no mouse events will fire for the space with no content.
            -->
            <!--<Grid.Background>
            <SolidColorBrush Color="Transparent" />
        </Grid.Background>-->

            <Grid.Resources>
                <SolidColorBrush
                    x:Key="GridBackgroundBrush"
                    Opacity="0.2"
                    Color="{Binding Path=PreviewContainerBackgroundColor, RelativeSource={RelativeSource Mode=TemplatedParent}}" />

                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                <localConv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
                <coreConv:MathAddConverter x:Key="MathAddConverter" />

                <Storyboard x:Key="FadeInItem">
                    <DoubleAnimation
                        Storyboard.TargetProperty="(UIElement.Opacity)"
                        From="0"
                        To="1"
                        Duration="0:0:0.7" />
                </Storyboard>
            </Grid.Resources>

            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Background" Value="{StaticResource GridBackgroundBrush}" />

                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                                <Condition Binding="{Binding Path=IsFadeInEnabled, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FadeInItemContents" Storyboard="{StaticResource FadeInItem}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FadeInItemContents" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="15" />
                <RowDefinition />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  border to apply the color animations to  -->
            <Border
                x:Name="PART_BorderToAnimate"
                Grid.RowSpan="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0" />

            <Button
                Name="BtnScrollUpSubItem"
                Grid.Row="0"
                Grid.Column="2"
                Height="15"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Style="{DynamicResource BtnArrowUp}" />
            <Button
                Name="BtnScrollDownSubItem"
                Grid.Row="2"
                Grid.Column="2"
                Height="15"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Style="{DynamicResource BtnArrowDown}" />


            <TextBlock
                Grid.Row="3"
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White">
                <i:Interaction.Behaviors>
                    <infBeh:FrameworkElementDpiScalingBehavior />
                </i:Interaction.Behaviors>
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} of {1} selected">
                        <Binding ElementName="PART_SubItemsListView" Path="SelectedItems.Count" />
                        <Binding Path="ViewItem.TotalClipboardItemsCount" />
                    </MultiBinding>
                </TextBlock.Text>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedItems.Count, ElementName=PART_SubItemsListView}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock
                Grid.Row="3"
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                Text="{Binding Path=ViewItem.TotalClipboardItemsCount, StringFormat={}{0} items}">
                <i:Interaction.Behaviors>
                    <infBeh:FrameworkElementDpiScalingBehavior />
                </i:Interaction.Behaviors>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedItems.Count, ElementName=PART_SubItemsListView}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ListView
                Name="PART_SubItemsListView"
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="1"
                ItemsSource="{Binding ViewItem.PreviewItems}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <i:Interaction.Behaviors>
                    <localBeh:ListViewScrollButtonBehavior ButtonScrollDirection="Up" ScrollButton="{Binding ElementName=BtnScrollUpSubItem}" />
                    <localBeh:ListViewScrollButtonBehavior ButtonScrollDirection="Down" ScrollButton="{Binding ElementName=BtnScrollDownSubItem}" />
                </i:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border
                                        x:Name="Bd"
                                        Margin="5"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                        <Border.Height>
                                            <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ListView}" />
                                                <Binding>
                                                    <Binding.Source>
                                                        <!--  take into account the margin of the border (5 on top and 5 on bottom + 1 for border top and 1 for border bottom)  -->
                                                        <sys:Double>-15</sys:Double>
                                                    </Binding.Source>
                                                </Binding>
                                            </MultiBinding>
                                        </Border.Height>
                                        <!--  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"  -->

                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItemNMore">
                                            <!--
                                                Make the "+N" indicator non-selectable. Despite this, the item can still be selected via click, so we will use a behavior on the content (see the ListViewItem template below).
                                                Note that we cannot just set IsEnabled to False, because this will also disable the tooltips and we do not want that.
                                            -->
                                            <Setter Property="Focusable" Value="False" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <!--  show the border only for real subitems, not for the "+N" indicator  -->
                                                <Condition Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItem" />
                                            </MultiDataTrigger.Conditions>
                                            <!--<Setter Property="Background" TargetName="Bd" Value="Blue"/>-->
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="DarkGray" />
                                            <!--<Setter Property="BorderThickness" TargetName="Bd" Value="2"/>-->

                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <!--<Condition Binding="{Binding Selector.IsSelectionActive, RelativeSource={RelativeSource Self}}" Value="False" />-->
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLight3Brush}" />
                                        </MultiDataTrigger>
                                        <!--<MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                        -->
                                        <!--<Condition Binding="{Binding Selector.IsSelectionActive, RelativeSource={RelativeSource Self}}" Value="True" />-->
                                        <!--
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLight3Brush}" />
                                    </MultiDataTrigger>-->
                                        <!--<Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    </Trigger>-->
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.Style>
                    <Style TargetType="{x:Type ListView}">
                        <Setter Property="infPropAp:ListViewUnselectAllAttachedProperty.UnselectAll" Value="False" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentLight3Brush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListView}">
                                    <ScrollViewer Padding="{TemplateBinding Padding}">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItems.Count}" Value="0">
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                                <Setter Property="infPropAp:ListViewUnselectAllAttachedProperty.UnselectAll" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--<WrapPanel />-->
                        <UniformGrid
                            MaxWidth="500"
                            MaxHeight="500"
                            Columns="{Binding Path=NumberOfUniformGridColumns, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MultiItemPresenter}}" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ContentControl x:Name="ccSubItem">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItem">

                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <Grid DataContext="{Binding PreviewItem}">
                                                            <Grid.Background>
                                                                <SolidColorBrush Color="Transparent" />
                                                            </Grid.Background>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <!--
                                                                Do not set the data context to this control directly as some wierd timing issue occurs with the bindings inside the control
                                                                Set the data context to the parent grid.
                                                            -->
                                                            <ContentControl
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                Background="Transparent"
                                                                Foreground="White">
                                                                <ContentControl.Style>

                                                                    <Style TargetType="{x:Type ContentControl}">

                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <Border
                                                                                        HorizontalAlignment="Stretch"
                                                                                        VerticalAlignment="Stretch"
                                                                                        Background="Transparent"
                                                                                        ToolTip="{TemplateBinding ToolTip}">
                                                                                        <ContentPresenter Content="{TemplateBinding Content}" />
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>

                                                                        <Setter Property="Content">
                                                                            <Setter.Value>
                                                                                <ContentControl Width="30" Template="{DynamicResource PreviewFailureIcon}" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Setter Property="ToolTip">
                                                                            <Setter.Value>
                                                                                <TextBlock Text="Something went wrong.">
                                                                                    <i:Interaction.Behaviors>
                                                                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                                                                    </i:Interaction.Behaviors>
                                                                                </TextBlock>
                                                                            </Setter.Value>
                                                                        </Setter>

                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PreviewGenerationStatus}" Value="{x:Static servicesEnums:PreviewGenerationStatus.NoGeneratorFound}">
                                                                                <Setter Property="Content">
                                                                                    <Setter.Value>
                                                                                        <ContentControl Width="30" Template="{DynamicResource PreviewNotAvailableIcon}">
                                                                                            <i:Interaction.Behaviors>
                                                                                                <infBeh:FrameworkElementDpiScalingBehavior />
                                                                                            </i:Interaction.Behaviors>
                                                                                        </ContentControl>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Setter Property="ToolTip">
                                                                                    <Setter.Value>
                                                                                        <TextBlock>
                                                                                            <Run Text="{x:Static core:ProductConstants.PRODUCT_NAME}" />
                                                                                            <Run Text="doesn't know how to generate a preview for this item." />
                                                                                            <i:Interaction.Behaviors>
                                                                                                <infBeh:FrameworkElementDpiScalingBehavior />
                                                                                            </i:Interaction.Behaviors>
                                                                                        </TextBlock>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PreviewGenerationStatus}" Value="{x:Static servicesEnums:PreviewGenerationStatus.Timeout}">
                                                                                <Setter Property="Content">
                                                                                    <Setter.Value>
                                                                                        <ContentControl Width="30" Template="{DynamicResource PreviewNotAvailableIcon}">
                                                                                            <i:Interaction.Behaviors>
                                                                                                <infBeh:FrameworkElementDpiScalingBehavior />
                                                                                            </i:Interaction.Behaviors>
                                                                                        </ContentControl>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Setter Property="ToolTip">
                                                                                    <Setter.Value>
                                                                                        <TextBlock Text="The preview generation for this item took too long.">
                                                                                            <i:Interaction.Behaviors>
                                                                                                <infBeh:FrameworkElementDpiScalingBehavior />
                                                                                            </i:Interaction.Behaviors>
                                                                                        </TextBlock>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PreviewGenerationStatus}" Value="{x:Static servicesEnums:PreviewGenerationStatus.Success}">
                                                                                <Setter Property="Content">
                                                                                    <Setter.Value>
                                                                                        <!--
                                                                                            this image should not be dpi-scaled here, as it is a raster image and cannot be scaled smoothly.
                                                                                            Its dimensions are determined according to the monitor size and dpi settings prior to its generation.
                                                                                        -->
                                                                                        <Image
                                                                                            x:Name="subItemPreviewImage"
                                                                                            Width="{Binding Image.Width}"
                                                                                            Source="{Binding Image}"
                                                                                            Stretch="Uniform" />
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Setter Property="ToolTip">
                                                                                    <Setter.Value>
                                                                                        <TextBlock Text="{Binding Description}">
                                                                                            <!--  the tooltip, however, should be dpi-scaled  -->
                                                                                            <i:Interaction.Behaviors>
                                                                                                <infBeh:FrameworkElementDpiScalingBehavior />
                                                                                            </i:Interaction.Behaviors>
                                                                                        </TextBlock>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>

                                                                            <!--  do not try to show a tooltip if the item's description is null or empty  -->
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <!--  if the preview is generated successfully  -->
                                                                                    <Condition Binding="{Binding PreviewGenerationStatus}" Value="{x:Static servicesEnums:PreviewGenerationStatus.Success}" />
                                                                                    <!--  and if the description is null or empty  -->
                                                                                    <Condition Binding="{Binding Description, TargetNullValue=''}" Value="" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="ToolTip" Value="{x:Null}" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                            </ContentControl>
                                                            <!--<Image
                                                            Name="subItemPreviewImage"
                                                            Grid.Row="0"
                                                            Margin="5"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            Source="{Binding Path=PreviewItem.Image}"
                                                            Stretch="Uniform"
                                                            ToolTip="{Binding Path=PreviewItem.Description}" />-->

                                                            <TextBlock
                                                                Grid.Row="1"
                                                                MaxWidth="{Binding Image.Width}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                Foreground="White"
                                                                Text="{Binding Text}"
                                                                TextBlock.TextTrimming="CharacterEllipsis"
                                                                ToolTipService.Placement="Center">
                                                                <i:Interaction.Behaviors>
                                                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                                                </i:Interaction.Behaviors>
                                                                <TextBlock.ToolTip>
                                                                    <TextBlock Text="{Binding Text}">
                                                                        <!--
                                                                            The toolitp does not scale along with the owner textblock,
                                                                            probably because it is not part of the visual tree. So we
                                                                            will need to scale it separately.
                                                                        -->
                                                                        <i:Interaction.Behaviors>
                                                                            <infBeh:FrameworkElementDpiScalingBehavior />
                                                                        </i:Interaction.Behaviors>
                                                                    </TextBlock>
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>

                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItemNMore">

                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <Grid Width="{Binding Path=Height, RelativeSource={RelativeSource Self}}" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}">
                                                            <i:Interaction.Behaviors>
                                                                <!--  ClipboardViewSubItemNMore elements are still selectable with a click despite ListViewItem.Focusable=False, so we need a behavior to cancel the click events  -->
                                                                <localBeh:FrameworkElementDisableClickBehavior AncestorElement="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}" />
                                                            </i:Interaction.Behaviors>
                                                            <Grid.ToolTip>
                                                                <TextBlock Text="{Binding Path=(bo:ClipboardViewSubItemNMore.NumberOfItems), StringFormat='{}{0:#} more files.'}" />
                                                            </Grid.ToolTip>
                                                            <Grid.Background>
                                                                <SolidColorBrush Opacity="0.1" Color="DarkGray" />
                                                            </Grid.Background>

                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="16"
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Text="{Binding Path=(bo:ClipboardViewSubItemNMore.NumberOfItems), StringFormat={}{0:+#}}">
                                                                <i:Interaction.Behaviors>
                                                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                                                </i:Interaction.Behaviors>
                                                            </TextBlock>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </ContentControl.Style>
                        </ContentControl>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

            <Rectangle
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Fill="Black"
                IsHitTestVisible="False"
                Opacity="0.3"
                Visibility="{TemplateBinding IsDimmed,
                                             Converter={StaticResource BooleanToVisibilityConverter}}" />

        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type local:MultiItemPresenter}">
        <Setter Property="Template" Value="{StaticResource MultiItemPresenterLoading}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ViewItemWrapper.IsViewItemLoaded, RelativeSource={RelativeSource Mode=Self}}" Value="True">
                <Setter Property="Template" Value="{StaticResource MultiItemPresenterLoaded}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>