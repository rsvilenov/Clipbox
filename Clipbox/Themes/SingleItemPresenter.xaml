<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Clipbox.Core;assembly=Clipbox.Core"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:local="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    xmlns:servicesEnums="clr-namespace:Clipbox.Services.Enums">


    <ControlTemplate x:Key="SingleItemPresenterLoading" TargetType="{x:Type local:SingleItemPresenter}">
        <Grid DataContext="{TemplateBinding ViewItemWrapper}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Grid.Background>
                <!--  here templatebinding does not work  -->
                <SolidColorBrush Opacity="0.2" Color="{Binding PreviewContainerBackgroundColor, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            </Grid.Background>

            <Grid.Resources>
                <Storyboard x:Key="FadeInItem">
                    <DoubleAnimation
                        Storyboard.TargetProperty="(UIElement.Opacity)"
                        From="0"
                        To="1"
                        Duration="0:0:0.7" />
                </Storyboard>
                <Storyboard x:Key="FadiInWithDelay">
                    <DoubleAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames
                        BeginTime="0:0:1.5"
                        Storyboard.TargetProperty="Visibility"
                        Duration="0">
                        <DiscreteObjectKeyFrame Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <DoubleAnimation
                        BeginTime="0:0:1.5"
                        Storyboard.TargetProperty="(UIElement.Opacity)"
                        From="0"
                        To="0.6"
                        Duration="0:0:0.7" />
                </Storyboard>
            </Grid.Resources>

            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsShownIntoView, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Path=IsLoadingFadeInEnabled, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FadeInItemContents" Storyboard="{StaticResource FadeInItem}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FadeInItemContents" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ContentControl
                Grid.RowSpan="2"
                Width="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Gray"
                IsEnabled="{TemplateBinding IsLoadingIndicatorFadeInEnabled}"
                Template="{DynamicResource LoadingSolidIcon}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Setter Property="Opacity" Value="0.6" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=IsShownIntoView, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True" />
                                    <!--  bind to IsEnabled of the content control, which is in turn bound to IsLoadingIndicatorFadeInEnabled of the main contorl  -->
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="DelayShowStoryboard" Storyboard="{StaticResource FadiInWithDelay}" />
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="DelayShowStoryboard" />
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=IsShownIntoView, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True" />
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>

                </ContentControl.Style>
            </ContentControl>

            <!--<Grid
            Grid.Row="0"
            MinHeight="{Binding ThumbnailAreaMinHeight}"
            MaxHeight="{Binding ThumbnailAreaMaxHeight}"
            Margin="10">-->

            <!--  leave this transparent for now... just to occupy the space  -->
            <Control
                Width="{Binding DimensionInfo.Dimensions[0].PreviewWidth}"
                Height="{Binding DimensionInfo.Dimensions[0].PreviewHeight}"
                Margin="10"
                VerticalAlignment="Center" />
            <!--
                to show a dark rectangle occupying the exact space that will be used by
                the preview, use the follwing properties on the above grid:
                
                Fill="Black"
                Opacity="0.1"
            -->
            <!--</Grid>-->

        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="SingleItemPresenterLoaded" TargetType="{x:Type local:SingleItemPresenter}">
        <Grid DataContext="{TemplateBinding ViewItemWrapper}">
            <!--
                we need to set a background other than Null to this grid in order to make it hit-testable.
                If we leave the background to null, then no mouse events will fire for the space with no content.
            -->
            <!--<Grid.Background>
            <SolidColorBrush Color="Transparent" />
        </Grid.Background>-->

            <Grid.Resources>
                <Storyboard x:Key="FadeInItem">
                    <DoubleAnimation
                        Storyboard.TargetProperty="(UIElement.Opacity)"
                        From="0"
                        To="1"
                        Duration="0:0:0.7" />
                </Storyboard>
                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            </Grid.Resources>

            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                                <Condition Binding="{Binding Path=IsFadeInEnabled, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FadeInItemContents" Storyboard="{StaticResource FadeInItem}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FadeInItemContents" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.Background>
                <SolidColorBrush Opacity="0.2" Color="{Binding PreviewContainerBackgroundColor, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <!--  border to apply the color animations to  -->
            <Border
                x:Name="PART_BorderToAnimate"
                Grid.RowSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0" />

            <!--  thumbnail area  -->
            <Grid
                Grid.Row="0"
                MinHeight="{TemplateBinding ThumbnailAreaMinHeight}"
                MaxHeight="{TemplateBinding ThumbnailAreaMaxHeight}"
                Margin="10"
                Background="Transparent"
                DataContext="{Binding ViewItem.PreviewItem}">
                <!--
                    Do not set the DataContext on the control below because it is not
                    set before the triggers try to evaluate its properties...
                    Set the DataContext to the enclosing grid. That solves the problem.
                -->
                <Control
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Foreground="White">
                    <Control.Style>

                        <Style TargetType="{x:Type Control}">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <ContentControl Width="30" Template="{DynamicResource PreviewFailureIcon}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <TextBlock Text="Something went wrong.">
                                        <i:Interaction.Behaviors>
                                            <infBeh:FrameworkElementDpiScalingBehavior />
                                        </i:Interaction.Behaviors>
                                    </TextBlock>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewGenerationStatus}" Value="{x:Static servicesEnums:PreviewGenerationStatus.NoGeneratorFound}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <ContentControl Width="30" Template="{DynamicResource PreviewNotAvailableIcon}">
                                                    <i:Interaction.Behaviors>
                                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                                    </i:Interaction.Behaviors>
                                                </ContentControl>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <TextBlock>
                                                <Run Text="{x:Static core:ProductConstants.PRODUCT_NAME}" />
                                                <Run Text="doesn't know how to generate a preview for this item." />
                                                <i:Interaction.Behaviors>
                                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                                </i:Interaction.Behaviors>
                                            </TextBlock>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PreviewGenerationStatus}" Value="{x:Static servicesEnums:PreviewGenerationStatus.Timeout}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <ContentControl Width="30" Template="{DynamicResource PreviewNotAvailableIcon}">
                                                    <i:Interaction.Behaviors>
                                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                                    </i:Interaction.Behaviors>
                                                </ContentControl>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <TextBlock Text="The preview generation for this item took too long.">
                                                <i:Interaction.Behaviors>
                                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                                </i:Interaction.Behaviors>
                                            </TextBlock>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PreviewGenerationStatus}" Value="{x:Static servicesEnums:PreviewGenerationStatus.Success}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <!--
                                                this image should not be dpi-scaled here, as it is a raster image and cannot be scaled smoothly.
                                                Its dimensions are determined according to the monitor size and dpi settings prior to its generation.
                                            -->
                                            <ControlTemplate>
                                                <Image
                                                    Width="{Binding Path=Image.Width, Mode=OneTime}"
                                                    RenderOptions.BitmapScalingMode="LowQuality"
                                                    Source="{Binding Path=Image, Mode=OneTime}" />
                                            </ControlTemplate>

                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <TextBlock Text="{Binding Description, Mode=OneTime}">
                                                <i:Interaction.Behaviors>
                                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                                </i:Interaction.Behaviors>
                                            </TextBlock>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>


                                <!--  do not try to show a tooltip if the item's description is null or empty  -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <!--  if the preview is generated successfully  -->
                                        <Condition Binding="{Binding PreviewGenerationStatus}" Value="{x:Static servicesEnums:PreviewGenerationStatus.Success}" />
                                        <!--  and if the description is null or empty  -->
                                        <Condition Binding="{Binding Description, TargetNullValue=''}" Value="" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Control.Style>
                </Control>

                <!--  dim the item by placing a semi-transparent black rectangle on top of it  -->
                <Rectangle
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Fill="Black"
                    IsHitTestVisible="False"
                    Opacity="0.3"
                    Visibility="{TemplateBinding IsDimmed,
                                                 Converter={StaticResource BooleanToVisibilityConverter}}" />

            </Grid>


            <!--  TODO: calculate the MaxWidth dynamically  -->
            <TextBlock
                Grid.Row="1"
                MaxWidth="200"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="White"
                Text="{Binding ViewItem.PreviewItem.Text, Mode=OneTime}"
                TextBlock.TextTrimming="CharacterEllipsis"
                ToolTipService.Placement="Center">
                <i:Interaction.Behaviors>
                    <infBeh:FrameworkElementDpiScalingBehavior />
                </i:Interaction.Behaviors>
                <TextBlock.ToolTip>
                    <!--  the tooltip won't scale with the textblock, probably because it is not part of its visual tree  -->
                    <ToolTip>
                        <ToolTip.Content>
                            <TextBlock FontSize="12" Text="{Binding ViewItem.PreviewItem.Text, Mode=OneTime}">
                                <!--<TextBlock.LayoutTransform>
                                                                                                <ScaleTransform CenterX="0" CenterY="0" ScaleX="{Binding Path=ScaleFactor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=infWindows:PerMonitorDpiWindow}}" ScaleY="{Binding}" />
                                                                                            </TextBlock.LayoutTransform>-->
                            </TextBlock>
                        </ToolTip.Content>
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>

        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type local:SingleItemPresenter}">
        <Setter Property="Template" Value="{StaticResource SingleItemPresenterLoading}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ViewItemWrapper.IsViewItemLoaded, RelativeSource={RelativeSource Mode=Self}}" Value="True">
                <Setter Property="Template" Value="{StaticResource SingleItemPresenterLoaded}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>