<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreCcEnums="clr-namespace:Clipbox.Core.ClipboardContent.Enums;assembly=Clipbox.Core"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Views.ClipboardViewItemTile">

    <Style TargetType="{x:Type local:ContentTypeIconBand}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ContentTypeIconBand}">
                    <ItemsControl x:Name="PART_ItemsControl" ItemsSource="{TemplateBinding ContentClasses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ContentControl
                                        MaxHeight="17"
                                        Margin="5,0,0,0"
                                        Foreground="#e4e4e6"
                                        Template="{DynamicResource ClassImageIcon}"
                                        ToolTip="{loc:Localize TTP_TILE_CONTENT_TYPE_IMAGE}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static coreCcEnums:ClipboardContentClass.Image}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <ContentControl
                                        MaxHeight="17"
                                        Margin="5,0,0,0"
                                        Foreground="#e4e4e6"
                                        Template="{DynamicResource ClassFileIcon}"
                                        ToolTip="{loc:Localize TTP_TILE_CONTENT_TYPE_FILE_FOLDER}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding}" Value="{x:Static coreCcEnums:ClipboardContentClass.File}" />
                                                            <Condition Binding="{Binding Path=IsGroupItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ContentTypeIconBand}}}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <ContentControl
                                        MaxHeight="20"
                                        Margin="5,0,0,0"
                                        Background="Red"
                                        Foreground="#e4e4e6"
                                        Template="{DynamicResource ClassFileCollectionIcon}"
                                        ToolTip="{loc:Localize TTP_TILE_CONTENT_TYPE_FILE_FOLDER_COLLECTION}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding}" Value="{x:Static coreCcEnums:ClipboardContentClass.File}" />
                                                            <Condition Binding="{Binding Path=IsGroupItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ContentTypeIconBand}}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <ContentControl
                                        MaxHeight="16"
                                        Margin="5,0,0,0"
                                        Foreground="#e4e4e6"
                                        Template="{DynamicResource ClassTextIcon}"
                                        ToolTip="{loc:Localize TTP_TILE_CONTENT_TYPE_TEXT}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static coreCcEnums:ClipboardContentClass.Text}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <ContentControl
                                        MaxHeight="16"
                                        Margin="5,0,0,0"
                                        Foreground="#e4e4e6"
                                        Template="{DynamicResource ClassRichTextIcon}"
                                        ToolTip="{loc:Localize TTP_TILE_CONTENT_TYPE_FORMATTED_TEXT}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static coreCcEnums:ClipboardContentClass.RichText}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <ContentControl
                                        MaxHeight="17"
                                        Margin="5,0,0,0"
                                        Foreground="#e4e4e6"
                                        Template="{DynamicResource ClassGeneralContentIcon}"
                                        ToolTip="{loc:Localize TTP_TILE_CONTENT_TYPE_CONTENT}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding}" Value="{x:Static coreCcEnums:ClipboardContentClass.GeneralContent}" />
                                                            <Condition Binding="{Binding Path=IsGroupItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ContentTypeIconBand}}}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <ContentControl
                                        MaxHeight="20"
                                        Margin="5,0,0,0"
                                        Foreground="#e4e4e6"
                                        Template="{DynamicResource ClassGeneralContentCollectionIcon}"
                                        ToolTip="{loc:Localize TTP_TILE_CONTENT_TYPE_CONTENT_COLLECTION}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding}" Value="{x:Static coreCcEnums:ClipboardContentClass.GeneralContent}" />
                                                            <Condition Binding="{Binding Path=IsGroupItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ContentTypeIconBand}}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>