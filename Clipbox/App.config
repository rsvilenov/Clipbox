<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="Clipbox.Default" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="Clipbox.ApplicationSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
    <applicationSettings>
        <Clipbox.Default>
            <setting name="Setting1" serializeAs="String">
                <value>test</value>
            </setting>
        </Clipbox.Default>
    </applicationSettings>
    <userSettings>
        <Clipbox.ApplicationSettings>
            <setting name="Setting1" serializeAs="String">
                <value>test</value>
            </setting>
            <setting name="PreviewItemHeightRatio" serializeAs="String">
                <value>0.2</value>
            </setting>
            <setting name="MaxPreviewItemsInGroupItem" serializeAs="String">
                <value>2</value>
            </setting>
            <setting name="ResizeAccordingToMonitorOrSystemDpi" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="DimNonFocusedItems" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="IsClipboardTrackingEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="IsDeskBandEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="IsCloudSyncEnabled" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="MainClipboardViewBackgroundRenderMode" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="IsTrayIconEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="IsBackgroundPreviewGenerationEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="AreFadeAnimationsEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="IsAutomaticCloudSyncOfPinnedItemsEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="MaxNonPinnedItemsInQuickView" serializeAs="String">
                <value>5</value>
            </setting>
            <setting name="PreviewGenerationTimeout" serializeAs="String">
                <value>6000</value>
            </setting>
            <setting name="PreviewCacheMaxSize" serializeAs="String">
                <value>10485760</value>
            </setting>
            <setting name="MaxSimultaneousPreviewTasks" serializeAs="String">
                <value>5</value>
            </setting>
            <setting name="AutoDetermineMaxSimultaneousPreviewTasks" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="NumOfNotYetVisibleRowsToPreload" serializeAs="String">
                <value>3</value>
            </setting>
            <setting name="MaxNumOfItemToLoadAtOnce" serializeAs="String">
                <value>50</value>
            </setting>
            <setting name="LicalizationCulture" serializeAs="String">
                <value>en-US</value>
            </setting>
        </Clipbox.ApplicationSettings>
    </userSettings>

</configuration>