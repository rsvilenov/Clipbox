<customControls:WindowFrame
    x:Class="Clipbox.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Clipbox.Core;assembly=Clipbox.Core"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:localDialog="clr-namespace:Clipbox.Views.Dialog"
    xmlns:localWindows="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sysTheme="clr-namespace:Clipbox.Infrastructure.UI.Theme;assembly=Clipbox.Infrastructure.UI"
    Width="Auto"
    Height="Auto"
    MinWidth="750"
    MinHeight="560"
    AllowsTransparency="True"
    Background="{DynamicResource TaskbarColorBrush}"
    BorderBrush="#3a3a3a"
    BorderThickness="0"
    CaptionBackground="Transparent"
    CaptionForeground="{DynamicResource ControlForegroundBrush}"
    CloseBtnToolTip="{loc:Localize TLP_WINDOW_CLOSE,
                                   ResourceLookupMode=CurrentAssembly}"
    FontSize="16"
    Foreground="White"
    Icon="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Images/Clip-WF.ico"
    MaximizeBtnToolTip="{loc:Localize TLP_WINDOW_MAXIMIZE,
                                      ResourceLookupMode=CurrentAssembly}"
    MinimizeBtnToolTip="{loc:Localize TLP_WINDOW_MINIMIZE,
                                      ResourceLookupMode=CurrentAssembly}"
    ResizeMode="CanResize"
    RestoreBtnToolTip="{loc:Localize TLP_WINDOW_RESTORE,
                                     ResourceLookupMode=CurrentAssembly}"
    SizeToContent="Manual"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate x:Key="SettingsLvDataTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ItemsControl
                        Grid.Column="0"
                        MaxWidth="600"
                        Margin="0,0,25,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ControlHighlightForegroundBrush}"
                        ItemsSource="{Binding ExtensionUIParts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="FrameworkElement.Margin" Value="0,20,0,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <Grid
                        Grid.Column="1"
                        Margin="5,0,25,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <Image
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{Binding PreviewImage}"
                            Stretch="None" />
                        <TextBlock
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="{Binding Description}" />
                    </Grid>

                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SettingsLvDataVerticalTemplate">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <ItemsControl
                        Grid.Row="0"
                        MaxWidth="600"
                        Margin="0,0,25,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ControlHighlightForegroundBrush}"
                        ItemsSource="{Binding ExtensionUIParts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="FrameworkElement.Margin" Value="0,20,0,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <Grid
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,10,0,20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="White"
                            Text="Preview">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{Binding PreviewImage}"
                            Stretch="None" />
                        <TextBlock
                            Grid.Row="3"
                            Margin="0,0,0,40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="{Binding Description}" />
                    </Grid>

                </Grid>
            </DataTemplate>

            <Style BasedOn="{StaticResource MinimalisticScrollBarStyle}" TargetType="ScrollBar">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Margin" Value="0,5,10,5" />
            </Style>

            <Style x:Key="extensionItemsControlStyle" TargetType="ItemsControl">
                <Setter Property="ItemTemplate" Value="{StaticResource SettingsLvDataTemplate}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UseInlinedPreviews}" Value="True">
                        <Setter Property="ItemTemplate" Value="{StaticResource SettingsLvDataVerticalTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Window.Resources>
    <customControls:WindowFrame.CaptionIconControl>
        <ContentControl Template="{StaticResource ApplicationIcon}" />
    </customControls:WindowFrame.CaptionIconControl>
    <Grid x:Name="mainGrid">

        <TabControl
            x:Name="tabControl"
            Margin="0,0,0,0"
            Background="Transparent"
            BorderThickness="0"
            Foreground="Wheat"
            TabStripPlacement="Left">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabControl}">
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabControl}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="HeaderPanel"
                                        Grid.Column="0"
                                        Margin="0,0,4,0"
                                        Panel.ZIndex="1"
                                        Background="#1f1f1f">
                                        <TabPanel
                                            Margin="0,10,0,0"
                                            IsItemsHost="True"
                                            KeyboardNavigation.TabIndex="1" />
                                    </Border>

                                    <Border Name="Border" Grid.Column="1">
                                        <ContentPresenter
                                            x:Name="PART_SelectedContentHost"
                                            Margin="30,0,0,0"
                                            ContentSource="SelectedContent" />
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid
                                    Name="Panel"
                                    Height="45"
                                    Background="Transparent">
                                    <Border
                                        Name="Border"
                                        Margin="0,10,0,10"
                                        BorderThickness="4,0,0,0">
                                        <ContentPresenter
                                            x:Name="ContentSite"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ContentSource="Header" />
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger SourceName="Panel" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Panel" Property="Background" Value="#4d4d4d" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="{loc:Localize LBL_SETTINGS_CATEGORY_GENERAL, ResourceLookupMode=CurrentAssembly}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Template="{StaticResource SettingsGeneralIcon}" />
                            <TextBlock Margin="10,0,0,0" Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <TabItem.Content>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,40,0" Orientation="Vertical">
                            <!--
                                prevent the scrollviewer from scrolling to the actual
                                focualbe items upon tab change,
                                by making this textblock focusable
                            -->
                            <TextBlock
                                Focusable="True"
                                FontSize="28"
                                Text="{loc:Localize LBL_SETTINGS_CATEGORY_GENERAL,
                                                    ResourceLookupMode=CurrentAssembly}" />

                            <ItemsControl
                                x:Name="generalExtensionsItemsControl"
                                ItemsSource="{Binding GeneralExtensionUIItems}"
                                Style="{StaticResource extensionItemsControlStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0,0,0,30" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,25,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>

                    </ScrollViewer>
                </TabItem.Content>
            </TabItem>

            <TabItem Header="{loc:Localize LBL_SETTINGS_CATEGORY_PREVIEWS, ResourceLookupMode=CurrentAssembly}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Template="{StaticResource SettingsPreiewIcon}" />
                            <TextBlock Margin="10,0,0,0" Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <TabItem.Content>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,40,0" Orientation="Vertical">
                            <!--
                                prevent the scrollviewer from scrolling to the actual
                                focualbe items upon tab change,
                                by making this textblock focusable
                            -->
                            <TextBlock
                                Focusable="True"
                                FontSize="28"
                                Text="{loc:Localize LBL_SETTINGS_CATEGORY_PREVIEWS,
                                                    ResourceLookupMode=CurrentAssembly}" />

                            <ItemsControl
                                x:Name="previewsExtensionsItemsControl"
                                Grid.Row="2"
                                ItemsSource="{Binding PreviewsExtensionUIItems}"
                                Style="{StaticResource extensionItemsControlStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0,0,0,30" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,25,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem.Content>
            </TabItem>

            <TabItem Header="{loc:Localize LBL_SETTINGS_CATEGORY_COPYING, ResourceLookupMode=CurrentAssembly}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Template="{StaticResource SettingsCopyingIcon}" />
                            <TextBlock Margin="10,0,0,0" Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <TabItem.Content>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,40,0" Orientation="Vertical">
                            <TextBlock
                                Focusable="True"
                                FontSize="28"
                                Text="{loc:Localize LBL_SETTINGS_CATEGORY_COPYING,
                                                    ResourceLookupMode=CurrentAssembly}" />
                            <ItemsControl
                                x:Name="copyingExtensionsItemsControl"
                                Grid.Row="2"
                                ItemsSource="{Binding CopyingExtensionUIItems}"
                                Style="{StaticResource extensionItemsControlStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0,0,0,30" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,25,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem.Content>
            </TabItem>

            <TabItem Header="{loc:Localize LBL_SETTINGS_CATEGORY_PASTING, ResourceLookupMode=CurrentAssembly}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,40,0" Orientation="Horizontal">
                            <ContentControl Template="{StaticResource SettingsPastingIcon}" />
                            <TextBlock Margin="10,0,0,0" Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <TabItem.Content>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Focusable="True"
                                FontSize="28"
                                Text="{loc:Localize LBL_SETTINGS_CATEGORY_PASTING,
                                                    ResourceLookupMode=CurrentAssembly}" />
                            <ItemsControl
                                x:Name="pastingExtensionsItemsControl"
                                Grid.Row="2"
                                ItemsSource="{Binding PastingExtensionUIItems}"
                                Style="{StaticResource extensionItemsControlStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0,0,0,30" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,25,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem.Content>
            </TabItem>

            <TabItem Header="{loc:Localize LBL_SETTINGS_CATEGORY_SECURITY, ResourceLookupMode=CurrentAssembly}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,40,0" Orientation="Horizontal">
                            <ContentControl Template="{StaticResource SettingsSecurityIcon}" />
                            <TextBlock Margin="10,0,0,0" Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <TabItem.Content>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Focusable="True"
                                FontSize="28"
                                Text="{loc:Localize LBL_SETTINGS_CATEGORY_SECURITY,
                                                    ResourceLookupMode=CurrentAssembly}" />
                            <ItemsControl
                                x:Name="security"
                                Grid.Row="2"
                                ItemsSource="{Binding SecurityExtensionUIItems}"
                                Style="{StaticResource extensionItemsControlStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0,0,0,30" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,25,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem.Content>
            </TabItem>

            <TabItem Header="{loc:Localize LBL_SETTINGS_CATEGORY_CLOUD, ResourceLookupMode=CurrentAssembly}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,40,0" Orientation="Horizontal">
                            <ContentControl Template="{StaticResource SettingsCloudIcon}" />
                            <TextBlock Margin="10,0,0,0" Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <TabItem.Content>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Focusable="True"
                                FontSize="28"
                                Text="{loc:Localize LBL_SETTINGS_CATEGORY_CLOUD,
                                                    ResourceLookupMode=CurrentAssembly}" />
                            <ItemsControl
                                x:Name="cloudExtensionsItemsControl"
                                Grid.Row="2"
                                ItemsSource="{Binding CloudExtensionUIItems}"
                                Style="{StaticResource extensionItemsControlStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0,0,0,30" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,25,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem.Content>
            </TabItem>

            <TabItem Header="{loc:Localize LBL_SETTINGS_CATEGORY_ADVANCED, ResourceLookupMode=CurrentAssembly}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,40,0" Orientation="Horizontal">
                            <ContentControl Template="{StaticResource SettingsAdvancedIcon}" />
                            <TextBlock Margin="10,0,0,0" Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <TabItem.Content>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Focusable="True"
                                FontSize="28"
                                Text="{loc:Localize LBL_SETTINGS_CATEGORY_ADVANCED,
                                                    ResourceLookupMode=CurrentAssembly}" />
                            <StackPanel
                                Grid.Row="1"
                                Grid.RowSpan="3"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Text="{loc:Localize LBL_SETTINGS_ADVANCED_MODIFY_WARNING,
                                                        ResourceLookupMode=CurrentAssembly}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Width="Auto"
                                    Height="30"
                                    Margin="30"
                                    HorizontalAlignment="Center"
                                    Click="BtnEnableAdvanced_Click"
                                    Content="{loc:Localize LBL_SETTINGS_ADVANCED_SHOW_SETTINGS,
                                                           ResourceLookupMode=CurrentAssembly}"
                                    Foreground="White"
                                    Style="{DynamicResource BtnShowSettings}" />
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdvancedTabEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            </StackPanel>
                            <ItemsControl
                                x:Name="advancedExtensionsItemsControl"
                                Grid.Row="1"
                                ItemsSource="{Binding AdvancedExtensionUIItems}"
                                Style="{StaticResource extensionItemsControlStyle}"
                                Visibility="{Binding IsAdvancedTabEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0,0,0,30" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,25,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </TabItem.Content>
            </TabItem>
        </TabControl>
        <localDialog:DialogPopup
            x:Name="restartConfirmationPopup"
            MaxWidth="350"
            DefaultButton="No"
            DialogAnswered="RestartConfirmationPopup_DialogAnswered"
            DialogText="{loc:Localize LBL_RESTART_REQUIRED_CONFIRMATION,
                                      ResourceLookupMode=CurrentAssembly}"
            DialogueType="YesNo"
            IsOpen="False"
            Placement="Center"
            PlacementTarget="{Binding ElementName=mainGrid}"
            ReturnFocusTo="{Binding ElementName=tabControl}" />

        <!--  disable the window contents when the window's IsEnabled=False  -->
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Black"
            Opacity="0.5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</customControls:WindowFrame>
