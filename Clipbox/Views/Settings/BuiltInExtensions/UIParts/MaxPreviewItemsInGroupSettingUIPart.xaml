<infUI:SettingUIPart
    x:Class="Clipbox.Views.Settings.BuiltInExtensions.UIParts.MaxPreviewItemsInGroupSettingUIPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="sys:Int32"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            TextWrapping="Wrap">
            <Run Text="{loc:Localize LBL_SETTINGS_MAX_PREVIEW_ITEMS_IN_GROUP, ResourceLookupMode=CurrentAssembly}" /><Run Text=": " />
            <Run FontWeight="Bold" Text="{Binding MaxPreviewItemsInGroup}" />
        </TextBlock>

        <Button
            Grid.Row="1"
            Grid.Column="0"
            Width="20"
            Height="20"
            VerticalAlignment="Center"
            Command="{Binding Decrease}"
            Style="{DynamicResource IconButton}">
            <ContentControl Template="{StaticResource MinusIcon}" />
        </Button>
        <Button
            Grid.Row="1"
            Grid.Column="2"
            Width="20"
            Height="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding Increase}"
            Style="{DynamicResource IconButton}">
            <ContentControl Template="{StaticResource PlusIcon}" />
        </Button>
        <Slider
            x:Name="slider"
            Grid.Row="1"
            Grid.Column="1"
            Margin="10,0,10,0"
            VerticalAlignment="Center"
            Maximum="10"
            Minimum="2"
            Template="{StaticResource MinimalisticSlider}"
            TickFrequency="1"
            Value="{Binding MaxPreviewItemsInGroup}" />

    </Grid>

</infUI:SettingUIPart>