<infUI:SettingUIPart
    x:Class="Clipbox.Views.Settings.BuiltInExtensions.UIParts.AutoClearSysClipboardSettingUIPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:Clipbox.Views.Settings"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="sys:Int32"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            VerticalAlignment="Center"
            Text="{loc:Localize LBL_SETTINGS_AUTO_CLEAR_SYS_CLIPBOARD_ENABLED,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />

        <customControls:ToggleSwitch
            x:Name="tglButton"
            Grid.Row="1"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IsChecked="{Binding IsAutoClearEnabled, Mode=TwoWay}"
            OffText="{loc:Localize TGL_BTN_LBL_Off,
                                   ResourceLookupMode=CurrentAssembly}"
            OnText="{loc:Localize TGL_BTN_LBL_On,
                                  ResourceLookupMode=CurrentAssembly}" />

        <StackPanel
            Grid.Row="2"
            Margin="0,15,0,0"
            HorizontalAlignment="Left"
            Orientation="Vertical"
            Visibility="{Binding ElementName=tglButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">

            <TextBlock
                VerticalAlignment="Bottom"
                Text="{loc:Localize LBL_SETTINGS_AUTO_CLEAR_SYS_CLIPBOARD_INTERVAL,
                                    ResourceLookupMode=CurrentAssembly}"
                TextWrapping="Wrap" />

            <customControls:IntUpDown
                Width="75"
                Height="28"
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Foreground="White"
                Minimum="1"
                Value="{Binding AutoClearSysClipboardAfterSeconds}" />

        </StackPanel>
    </Grid>
</infUI:SettingUIPart>
