<infUI:SettingUIPart
    x:Class="Clipbox.Views.Settings.BuiltInExtensions.UIParts.MaxNonPinnedItemsInQVSettingUIPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="sys:Int32"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid" Margin="0,30,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition  />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0"
            Grid.ColumnSpan="3"
            VerticalAlignment="Center"
            Grid.Column="0">
            <TextBlock
            Text="{loc:Localize LBL_SETTINGS_MAX_NON_PINNED_ENTRIES_IN_QV,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />
            <TextBlock
            Margin="15, 0, 0, 0"
            FontWeight="Bold"
            Text="{Binding MaxNonPinnedPinnedItemsInQV}" />
        </StackPanel>

        <Button Style="{DynamicResource IconButton}"
            Grid.Row="1"
            Grid.Column="0"
            Width="20"
            Height="20"
            VerticalAlignment="Center" 
            Command="{Binding Decrease}">
            <ContentControl Template="{StaticResource MinusIcon}" />
        </Button>
        <Button Style="{DynamicResource IconButton}"
            Grid.Row="1"
            Grid.Column="2"
            Width="20"
            Height="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Center" 
            Command="{Binding Increase}">
            <ContentControl Template="{StaticResource PlusIcon}" />
        </Button>
        <Slider
            Grid.Row="1"
            VerticalAlignment="Center"
            x:Name="slider"
            Grid.Column="1"
            Margin="10,0,10,0"
            Maximum="10"
            Minimum="0"
            Template="{StaticResource MinimalisticSlider}"
            TickFrequency="1"
            Value="{Binding MaxNonPinnedPinnedItemsInQV}" />
        <TextBlock
            Margin="0,10,0,0"
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Text="{loc:Localize LBL_SETTINGS_MAX_NON_PINNED_ENTRIES_IN_QV_WRN,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />
    </Grid>

</infUI:SettingUIPart>