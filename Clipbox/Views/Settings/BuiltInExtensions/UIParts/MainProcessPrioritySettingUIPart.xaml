<infUI:SettingUIPart x:Class="Clipbox.Views.Settings.BuiltInExtensions.UIParts.MainProcessPrioritySettingUIPart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
             xmlns:settings="clr-namespace:Clipbox.Views.Settings"
             xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
             x:TypeArguments="sys:Boolean"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            VerticalAlignment="Center"
            Text="{loc:Localize LBL_SETTINGS_MAIN_PROCESS_PRIORITY,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />

        <customControls:ToggleSwitch
            Grid.Row="1"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            IsChecked="{Binding MainProcessHighPriorityEnabled, Mode=TwoWay}"
            OffText="Off"
            OnText="On" />
    </Grid>
</infUI:SettingUIPart>
