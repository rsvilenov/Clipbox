<infUI:SettingUIPart
    x:Class="Clipbox.Views.Settings.BuiltInExtensions.UIParts.PreviewCacheMaxSizeSettingUIPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="sys:Int32"
    mc:Ignorable="d">
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            VerticalAlignment="Center"
            Text="{loc:Localize LBL_SETTINGS_PREVIEW_CACHE_MAX_SIZE,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />
        <customControls:IntUpDown
            Grid.Row="1"
            Width="75"
            Height="28"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="Transparent"
            Foreground="White"
            Maximum="500"
            Minimum="1"
            Value="{Binding PreviewCacheMaxSize}" />
    </Grid>

</infUI:SettingUIPart>