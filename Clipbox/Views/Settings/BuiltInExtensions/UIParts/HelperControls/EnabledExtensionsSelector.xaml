<UserControl
    x:Class="Clipbox.Views.Settings.BuiltInExtensions.UIParts.HelperControls.EnabledExtensionsSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <Style BasedOn="{StaticResource MinimalisticScrollBarStyle}" TargetType="ScrollBar">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Margin" Value="0,5,2,5" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        x:Name="mainBorder"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1">
        <Grid
            Width="600"
            Height="550"
            Margin="15"
            Background="{DynamicResource TaskbarColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2.5*" />
                <RowDefinition Height="2.5*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Template="{DynamicResource PluginIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl
                    Grid.Column="0"
                    Width="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Template="{DynamicResource LoadingSolidIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <StackPanel
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="18"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Text="{loc:Localize LBL_SETTINGS_ENABLED_EXTENSION_SELECTOR_TITLE,
                                            ResourceLookupMode=CurrentAssembly}" />
                </StackPanel>

            </Grid>


            <GroupBox
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Padding="15"
                VerticalAlignment="Stretch"
                BorderBrush="DarkGray"
                BorderThickness="0.3"
                Foreground="{DynamicResource ControlForegroundBrush}">
                <GroupBox.Header>
                    <TextBlock Text="{loc:Localize LBL_SETTINGS_ENABLED_EXTENSIONS_LIST, ResourceLookupMode=CurrentAssembly}">
                        <i:Interaction.Behaviors>
                            <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                        </i:Interaction.Behaviors>
                    </TextBlock>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <customControls:SearchTextBox
                        x:Name="searchTextBox"
                        Grid.Row="0"
                        Height="30"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        OverlayText="{loc:Localize LBL_SETTINGS_ENABLED_EXTENSIONS_SEARCH_OVERLAY}"
                        SearchRequested="SearchTextBox_SearchRequested" />


                    <ListView
                        Grid.Row="1"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        ItemsSource="{Binding EnabledExtensions}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="10" Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <ContentPresenter
                                                Margin="5,0,0,5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderBrush="DarkGray"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                    <Grid Margin="5,3,3,5" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Foreground="White">
                                            <Run Text="{Binding ExtensionName}" />
                                            <Run Text="{Binding Version, StringFormat={} (v. {0})}" />
                                            <i:Interaction.Behaviors>
                                                <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                                            </i:Interaction.Behaviors>
                                        </TextBlock>
                                        <ContentControl
                                            Grid.Column="1"
                                            MaxWidth="20"
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            Foreground="White"
                                            Template="{DynamicResource InfoIcon}"
                                            ToolTip="{Binding Description}"
                                            ToolTipService.ShowDuration="300000" />
                                        <Button
                                            Grid.Column="2"
                                            MaxWidth="15"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.DisableExtension, ElementName=mainBorder}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource BtnRemove}"
                                            ToolTip="{loc:Localize TTP_SETTINGS_DISABLE_EXTENSION,
                                                                   ResourceLookupMode=CurrentAssembly}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </GroupBox>
            <GroupBox
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,15,0,0"
                Padding="15"
                VerticalAlignment="Stretch"
                BorderBrush="DarkGray"
                BorderThickness="0.3"
                Foreground="{DynamicResource ControlForegroundBrush}">
                <GroupBox.Header>
                    <TextBlock Text="{loc:Localize LBL_SETTINGS_DISABLED_EXTENSIONS_LIST, ResourceLookupMode=CurrentAssembly}">
                        <i:Interaction.Behaviors>
                            <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                        </i:Interaction.Behaviors>
                    </TextBlock>
                </GroupBox.Header>

                <ListView
                    x:Name="availableExtensionsView"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                    ItemsSource="{Binding DisabledExtensions}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Margin="10" Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                                        <ContentPresenter
                                            Margin="5,0,0,5"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                BorderBrush="DarkGray"
                                BorderThickness="1"
                                CornerRadius="1">
                                <Grid Margin="5,3,3,5" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="White">
                                        <Run Text="{Binding ExtensionName}" />
                                        <Run Text="{Binding Version, StringFormat={} (v. {0})}" />
                                        <i:Interaction.Behaviors>
                                            <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                                        </i:Interaction.Behaviors>
                                    </TextBlock>
                                    <ContentControl
                                        Grid.Column="1"
                                        MaxWidth="20"
                                        Margin="0,0,10,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Foreground="White"
                                        Template="{DynamicResource InfoIcon}"
                                        ToolTip="{Binding Description}"
                                        ToolTipService.ShowDuration="300000" />

                                    <Button
                                        Grid.Column="2"
                                        MaxWidth="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.EnableExtension, ElementName=mainBorder}"
                                        CommandParameter="{Binding}"
                                        Style="{DynamicResource BtnAdd}"
                                        ToolTip="{loc:Localize TTP_SETTINGS_ENABLE_EXTENSION,
                                                               ResourceLookupMode=CurrentAssembly}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>


            <Button
                x:Name="btnOk"
                Grid.Row="3"
                Grid.Column="0"
                Width="70"
                Height="30"
                Margin="10"
                VerticalAlignment="Center"
                Command="{Binding OkClicked}"
                Content="{loc:Localize BTN_LBL_Ok}"
                Foreground="White"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                Style="{DynamicResource BtnOk}" />

            <Button
                x:Name="btnCancel"
                Grid.Row="3"
                Grid.Column="1"
                Width="90"
                Height="30"
                Margin="10"
                VerticalAlignment="Center"
                Command="{Binding CancelClicked}"
                Content="{loc:Localize BTN_LBL_Cancel}"
                Foreground="White"
                Style="{DynamicResource BtnCancel}" />

            <!--  disable the contents when the control's IsEnabled=False  -->
            <Border
                Grid.RowSpan="4"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Black"
                Opacity="0.5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsControlEnabled}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Border>
</UserControl>
