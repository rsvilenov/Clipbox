    <Grid x:Name="mainGrid" Margin="0,15,0,15">

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CloudExtensionName}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CloudExtensionName}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                VerticalAlignment="Center"
                TextWrapping="Wrap">
                <Run Text="{loc:Localize LBL_SETTINGS_SELECTED_CLOUD_EXTENSION, ResourceLookupMode=CurrentAssembly}" />
                <Run Text="{Binding CloudExtensionName}" />
            </TextBlock>

            <StackPanel
                Grid.Row="1"
                Margin="0,13,0,0"
                Orientation="Horizontal">

                <Image
                    Height="25"
                    Margin="0,0,20,0"
                    Source="{Binding CloudExtensionIcon}"
                    Stretch="Uniform" />

                <Button
                    Height="30"
                    MinWidth="100"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding ChangeCloudClicked}"
                    Content="{loc:Localize BTN_SETTINGS_CLOUD_CHANGE_EXTENSION,
                                           ResourceLookupMode=CurrentAssembly}"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Style="{StaticResource BtnChangeCloud}" />

                <Button
                    Height="30"
                    MinWidth="100"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding ChangeLoginClicked}"
                    Content="{loc:Localize BTN_SETTINGS_CLOUD_CHANGE_LOGIN,
                                           ResourceLookupMode=CurrentAssembly}"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Style="{StaticResource BtnChangeCloudLogin}" />

                <Button
                    Height="30"
                    MinWidth="100"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding ClearCloudDataClicked}"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    ToolTip="{loc:Localize TTP_SETTINGS_CLOUD_CLEAR_DATA,
                                           ResourceLookupMode=CurrentAssembly}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource BtnClearCloudData}" TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Content" Value="{loc:Localize BTN_SETTINGS_CLOUD_CLEAR_DATA, ResourceLookupMode=CurrentAssembly}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Authenticated}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInDebugMode}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsClearDataRunning}" Value="True">
                                    <Setter Property="Content" Value="{loc:Localize BTN_SETTINGS_CLOUD_CLEARING_DATA, ResourceLookupMode=CurrentAssembly}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>


            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    Grid.Column="0"
                    Width="18"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    Template="{DynamicResource LoadingSolidIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Authenticated}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Error}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                    </ContentControl.Style>
                </ContentControl>

                <ContentControl
                    Grid.Column="0"
                    Width="18"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="Green"
                    Template="{DynamicResource SuccessIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Authenticated}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <ContentControl
                    Grid.Column="0"
                    Width="18"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AlertBrush2}"
                    Template="{DynamicResource ErrorIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Error}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <ContentControl Grid.Column="1" VerticalAlignment="Center">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Content" Value="" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Connecting}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{loc:Localize LBL_SETTINGS_CLOUD_SVC_CONNECTING,
                                                                    ResourceLookupMode=CurrentAssembly}"
                                                TextWrapping="Wrap" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Authenticating}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{loc:Localize LBL_SETTINGS_CLOUD_SVC_AUTHENTICATING,
                                                                    ResourceLookupMode=CurrentAssembly}"
                                                TextWrapping="Wrap" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Authenticated}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{loc:Localize LBL_SETTINGS_CLOUD_SVC_AUTHENTICATED,
                                                                    ResourceLookupMode=CurrentAssembly}"
                                                TextWrapping="Wrap" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Error}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Border MaxHeight="150">
                                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                    <TextBlock
                                                        Margin="0,10,20,0"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="Wrap">
                                                        <Run Text="{loc:Localize LBL_SETTINGS_CLOUD_SVC_ERROR, ResourceLookupMode=CurrentAssembly}" />
                                                        <Run Text=": " />
                                                        <Run Text="{Binding ErrorMessage}" />
                                                    </TextBlock>
                                                </ScrollViewer>
                                            </Border>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.NoNetwork}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{loc:Localize LBL_SETTINGS_CLOUD_SVC_NO_NETWORK,
                                                                    ResourceLookupMode=CurrentAssembly}"
                                                TextWrapping="Wrap" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

            </Grid>
            <StackPanel
                Grid.Row="3"
                Margin="0,10,0,0"
                Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Error}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Error}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button
                    Width="Auto"
                    Height="30"
                    MinWidth="100"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding ShowDetailsClicked}"
                    Content="{loc:Localize LBL_SETTINGS_CLOUD_ERROR_DETAILS,
                                           ResourceLookupMode=CurrentAssembly}"
                    Foreground="{DynamicResource ControlForegroundBrush}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource BtnShowDetails}" TargetType="Button">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorDetails}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorDetails}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button
                    Width="Auto"
                    Height="30"
                    MinWidth="100"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding RetryClicked}"
                    Content="{loc:Localize BTN_SETTINGS_CLOUD_RETRY_AUTHENTICATION,
                                           ResourceLookupMode=CurrentAssembly}"
                    Foreground="{DynamicResource ControlForegroundBrush}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource BtnRetry}" TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static local:CloudServiceConnectionState.Error}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

        </Grid>

        <Popup
            x:Name="cloudSelectorPopup"
            Width="550"
            MinHeight="200">
            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,15,0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Text="{loc:Localize LBL_SETTINGS_SELECT_CLOUD_SUPPORT_EXT,
                                            ResourceLookupMode=CurrentAssembly}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,15,0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{loc:Localize LBL_SETTINGS_NO_CLOUD_SUPPORT_EXT_AVAILABLE,
                                            ResourceLookupMode=CurrentAssembly}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvailableCloudExtensions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.Row="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvailableCloudExtensions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Auto">
                            <ListView
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource ControlForegroundBrush}"
                                ItemsSource="{Binding AvailableCloudExtensions}"
                                SelectedItem="{Binding SelectedCloudInfoDisplayData}"
                                SelectionMode="Single">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0,0,0,30" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="FrameworkElement.Margin" Value="0,5,0,0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="45" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                FontSize="12"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />
                                            <Image
                                                Grid.RowSpan="2"
                                                Grid.Column="1"
                                                Height="45"
                                                Margin="15,0,0,0"
                                                VerticalAlignment="Center"
                                                Source="{Binding Icon}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Border>

                    <UniformGrid
                        Grid.Row="2"
                        Height="Auto"
                        VerticalAlignment="Bottom"
                        Columns="2"
                        Rows="1">
                        <Button
                            x:Name="btnOk"
                            Width="70"
                            Height="30"
                            VerticalAlignment="Center"
                            Command="{Binding OkClicked}"
                            Content="{loc:Localize BTN_LBL_Ok}"
                            Foreground="White"
                            Style="{DynamicResource BtnOk}" />

                        <Button
                            x:Name="btnCancel"
                            Width="90"
                            Height="30"
                            VerticalAlignment="Center"
                            Command="{Binding CancelClicked}"
                            Content="{loc:Localize BTN_LBL_Cancel}"
                            DockPanel.Dock="Right"
                            Foreground="White"
                            Style="{DynamicResource BtnCancel}" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Popup>

        <popupDialog:DialogPopup
            x:Name="errorDetailsPopup"
            Width="400"
            Height="300"
            DataContext="{Binding Path=DataContext, ElementName=mainGrid}"
            DialogueType="Ok"
            DisableParentWindow="True">
            <popupDialog:DialogPopup.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Text="{loc:Localize LBL_SETTINGS_CLOUD_ERROR_DETAILS}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Row="0"
                        Width="35"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        Command="{Binding DataContext.CopyDetailsToClipboardClicked}"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Style="{StaticResource IconButton}"
                        ToolTip="{loc:Localize BTN_SETTINGS_CLOUD_COPY_DETAILS}">
                        <ContentControl Margin="5" Template="{StaticResource CopyIcon}" />
                    </Button>
                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,15,0,10"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            Margin="10"
                            FontSize="14"
                            Foreground="{DynamicResource ControlForegroundBrush}"
                            Text="{Binding DataContext.ErrorDetailsForPopup}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </popupDialog:DialogPopup.Content>
        </popupDialog:DialogPopup>
    </Grid>
</infUI:SettingUIPart>
