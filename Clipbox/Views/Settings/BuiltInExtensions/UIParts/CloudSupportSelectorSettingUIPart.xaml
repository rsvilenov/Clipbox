<infUI:SettingUIPart
    x:Class="Clipbox.Views.Settings.BuiltInExtensions.UIParts.CloudSupportSelectorSettingUIPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:Clipbox.Views.Settings"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="sys:String"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style BasedOn="{StaticResource MinimalisticScrollBarStyle}" TargetType="ScrollBar">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Margin" Value="0,5,10,5" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Popup
        x:Name="cloudSelectorPopup"
        Width="550"
        MinHeight="200">
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <Grid x:Name="mainGrid" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,15,0,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="{loc:Localize LBL_SETTINGS_CLIPBOARD_TRACKING,
                                        ResourceLookupMode=CurrentAssembly}"
                    TextWrapping="Wrap" />

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Auto">
                    <ListView
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        ItemsSource="{Binding AvailableCloudExtensions}"
                        SelectedItem="{Binding SelectedCloudInfoDisplayData}"
                        SelectionMode="Single">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="0,0,0,30" Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="FrameworkElement.Margin" Value="0,5,0,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="45" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        FontSize="12"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap" />
                                    <Image
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Height="45"
                                        Margin="15,0,0,0"
                                        VerticalAlignment="Center"
                                        Source="{Binding Icon}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <UniformGrid
                    Grid.Row="2"
                    Height="Auto"
                    VerticalAlignment="Bottom"
                    Columns="2"
                    Rows="1">
                    <Button
                        x:Name="btnOk"
                        Width="70"
                        Height="30"
                        VerticalAlignment="Center"
                        Command="{Binding OkClicked}"
                        Content="{loc:Localize BTN_LBL_Ok}"
                        Foreground="White"
                        Style="{DynamicResource BtnOk}" />

                    <Button
                        x:Name="btnCancel"
                        Width="90"
                        Height="30"
                        VerticalAlignment="Center"
                        Command="{Binding CancelClicked}"
                        Content="{loc:Localize BTN_LBL_Cancel}"
                        DockPanel.Dock="Right"
                        Foreground="White"
                        Style="{DynamicResource BtnCancel}" />
                </UniformGrid>
            </Grid>
        </Border>
    </Popup>

</infUI:SettingUIPart>
