<infUI:SettingUIPart
    x:Class="Clipbox.Views.Settings.BuiltInExtensions.UIParts.CloudSupportSelectorSettingUIPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:Clipbox.Views.Settings"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="sys:String"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style BasedOn="{StaticResource MinimalisticScrollBarStyle}" TargetType="ScrollBar">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Margin" Value="0,5,10,5" />
            </Style>

            <ControlTemplate x:Key="ChangeExtensionIcon">
                <Viewbox>
                    <Grid
                        Width="128"
                        Height="128"
                        Visibility="Visible">
                        <Path
                            Width="90"
                            Height="90"
                            Data="M15.799988,7.9000244C11.400024,7.9000244 7.7999878,11.5 7.7999878,15.900024 7.7999878,20.300018 11.400024,23.900024 15.799988,23.900024 20.200012,23.900024 23.799988,20.300018 23.799988,15.900024 23.799988,11.400024 20.299988,7.9000244 15.799988,7.9000244z M12.600037,0L15.5,4.1000061 16.900024,4.1000061 17.100037,4.1000061 20.100037,0.20001221 24.600037,2.2000122 23.799988,7.1000061 23.900024,7.2000122C24.200012,7.6000061,24.600037,8,25,8.4000244L25.100037,8.6000061 30.200012,7.9000244 32,12.5 27.700012,15.600006 27.700012,17 31.799988,20.100006 29.799988,24.600006 24.700012,23.700012 24.600037,23.800018 23.900024,24.5 23.700012,24.700012 24.400024,30.100006 19.700012,32 16.700012,27.700012 16.5,27.700012 15.200012,27.700012 14.799988,27.700012 11.5,31.900024 7,29.900024 7.9000244,24.700012 7.7999878,24.600006C7.5,24.400024,7.2999878,24.100006,7.1000366,23.900024L6.9000244,23.600006 1.7999878,24.300018 0,19.700012 4,16.800018 4,16.5 4,14.800018 0,11.700012 2,7.2000122 7,8C7.5,7.5,8,7,8.5,6.6000061L8,1.8000183z"
                            Fill="{TemplateBinding Foreground}"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="Uniform">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <TransformGroup.Children>
                                        <RotateTransform Angle="0" />
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </TransformGroup.Children>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Viewbox>
            </ControlTemplate>

            <Style x:Key="BtnChange" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                                <Border
                                    Name="selectionBorder"
                                    BorderBrush="{DynamicResource accentDottedBrush}"
                                    BorderThickness="0">
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="5,0,0,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}"
                                            Text="{TemplateBinding Content}" />
                                        <ContentControl
                                            Grid.Column="1"
                                            Margin="5,3,2,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Template="{StaticResource ChangeExtensionIcon}" />
                                    </Grid>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Button.IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="selectionBorder" Property="Background" Value="{DynamicResource ControlHighlightBackgroundBrush}" />

                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid" Margin="0,15,0,15">

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CloudExtensionName}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CloudExtensionName}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                VerticalAlignment="Center"
                TextWrapping="Wrap">
                <Run Text="{loc:Localize LBL_SETTINGS_SELECTED_CLOUD_EXTENSION, ResourceLookupMode=CurrentAssembly}" />
                <Run Text="{Binding CloudExtensionName}" />
            </TextBlock>

            <Button
                Grid.Row="1"
                Height="30"
                MinWidth="100"
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding ChangeClicked}"
                Content="{loc:Localize BTN_SETTINGS_CLOUD_CHANGE_EXTENSION,
                                       ResourceLookupMode=CurrentAssembly}"
                Foreground="{DynamicResource ControlForegroundBrush}"
                Style="{StaticResource BtnChange}" />

        </Grid>

        <Popup
            x:Name="cloudSelectorPopup"
            Width="550"
            MinHeight="200">
            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,15,0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Text="{loc:Localize LBL_SETTINGS_CLIPBOARD_TRACKING,
                                            ResourceLookupMode=CurrentAssembly}"
                        TextWrapping="Wrap" />

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Auto">
                        <ListView
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource ControlForegroundBrush}"
                            ItemsSource="{Binding AvailableCloudExtensions}"
                            SelectedItem="{Binding SelectedCloudInfoDisplayData}"
                            SelectionMode="Single">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0,0,0,30" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="FrameworkElement.Margin" Value="0,5,0,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="45" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            FontSize="12"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                        <Image
                                            Grid.RowSpan="2"
                                            Grid.Column="1"
                                            Height="45"
                                            Margin="15,0,0,0"
                                            VerticalAlignment="Center"
                                            Source="{Binding Icon}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>

                    <UniformGrid
                        Grid.Row="2"
                        Height="Auto"
                        VerticalAlignment="Bottom"
                        Columns="2"
                        Rows="1">
                        <Button
                            x:Name="btnOk"
                            Width="70"
                            Height="30"
                            VerticalAlignment="Center"
                            Command="{Binding OkClicked}"
                            Content="{loc:Localize BTN_LBL_Ok}"
                            Foreground="White"
                            Style="{DynamicResource BtnOk}" />

                        <Button
                            x:Name="btnCancel"
                            Width="90"
                            Height="30"
                            VerticalAlignment="Center"
                            Command="{Binding CancelClicked}"
                            Content="{loc:Localize BTN_LBL_Cancel}"
                            DockPanel.Dock="Right"
                            Foreground="White"
                            Style="{DynamicResource BtnCancel}" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</infUI:SettingUIPart>
