<Popup
    x:Class="Clipbox.Views.Dialog.DialogPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogEnums="clr-namespace:Clipbox.Views.Dialog.Enums"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        x:Name="mainBorder"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1">

        <Grid Margin="15" Background="{DynamicResource TaskbarColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="80" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Content}" Value="{x:Null}">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock
                                            Margin="10"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Text="{Binding DialogText}"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DialogText}" Value="{x:Null}">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <ContentPresenter
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Content="{Binding Content}" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <Grid Grid.Row="1" Margin="0,5,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=DialogueType}" Value="{x:Static dialogEnums:DialogTypes.YesNo}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Button
                        x:Name="btnYes"
                        Grid.Column="0"
                        Width="70"
                        Height="30"
                        Margin="5"
                        Click="BtnYes_Click"
                        Content="{loc:Localize BTN_LBL_Yes}"
                        Foreground="White"
                        GotFocus="BtnYes_GotFocus"
                        Style="{DynamicResource BtnYes}" />

                    <Button
                        x:Name="btnNo"
                        Grid.Column="1"
                        Width="70"
                        Height="30"
                        Margin="5"
                        Click="BtnNo_Click"
                        Content="{loc:Localize BTN_LBL_No}"
                        Foreground="White"
                        GotFocus="BtnNo_GotFocus"
                        Style="{DynamicResource BtnNo}" />
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=DialogueType}" Value="{x:Static dialogEnums:DialogTypes.Ok}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Button
                        x:Name="btnOk"
                        Width="70"
                        Height="30"
                        Margin="5"
                        Click="BtnOk_Click"
                        Content="{loc:Localize BTN_LBL_Ok}"
                        Foreground="White"
                        GotFocus="BtnOk_GotFocus"
                        Style="{DynamicResource BtnOk}" />
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Popup>
