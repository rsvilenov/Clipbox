<ScrollBar
    x:Class="Clipbox.Views.ScrollBarEx"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="Auto"
    d:DesignHeight="300"
    d:DesignWidth="120"
    mc:Ignorable="d">
    <ScrollBar.Resources>
        <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <!--  make the actual width bigger so that clicks arround but not exactly on the line be registered  -->
                        <Grid Width="15" Background="Transparent">
                            <Border
                                Width="2"
                                Margin="-1,0,0,0"
                                Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                MaxWidth="120"
                                Margin="-140,-10,0,-10"
                                HorizontalContentAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="1"
                                Content="Sep 20 2018"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}" />
                            <Canvas
                                Grid.Column="1"
                                Width="20"
                                Height="20">
                                <Ellipse
                                    Name="thumbHandler"
                                    Width="20"
                                    Height="20"
                                    Fill="Transparent"
                                    Stroke="{TemplateBinding Foreground}"
                                    StrokeThickness="2">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <Trigger Property="Ellipse.IsMouseOver" Value="True">
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <!--  TODO: find out why this binding failes just after showing the scrollbar, but then works normally  -->
                                                            <DropShadowEffect
                                                                BlurRadius="20"
                                                                ShadowDepth="0"
                                                                Color="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Ellipse}, Path=Stroke.Color}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>


                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbHandler" Property="Fill" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Foreground}" />
                                <Setter TargetName="thumbHandler" Property="Effect">
                                    <Setter.Value>
                                        <!--  TODO: find out why this binding failes just after showing the scrollbar, but then works normally  -->
                                        <DropShadowEffect
                                            BlurRadius="20"
                                            ShadowDepth="0"
                                            Color="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Foreground.Color}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
            <!--  to make the thumb auto-size, remove ViewportSize="NaN"  -->

            <Grid Background="Transparent" SnapsToDevicePixels="true">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="1"
                    Margin="2"
                    HorizontalAlignment="Stretch"
                    Background="Transparent">

                    <Track
                        x:Name="PART_Track"
                        IsDirectionReversed="true"
                        IsEnabled="{TemplateBinding IsMouseOver}"
                        ViewportSize="NaN">
                        <Track.DecreaseRepeatButton>
                            <!--  Command="ScrollBar.PageUpCommand"  -->
                            <RepeatButton Command="ScrollBar.LineUpCommand" Style="{StaticResource ScrollBarPageButton}" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollBarThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <!--  Command="ScrollBar.PageDownCommand"  -->
                            <RepeatButton Command="ScrollBar.LineDownCommand" Style="{StaticResource ScrollBarPageButton}" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>

                <Grid
                    Grid.Column="0"
                    Margin="5,0,10,0"
                    VerticalAlignment="Stretch">
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{TemplateBinding Foreground}"
                        Text="Now" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{TemplateBinding Foreground}"
                        Text="End" />
                </Grid>
            </Grid>
        </ControlTemplate>

    </ScrollBar.Resources>
    <ScrollBar.Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ScrollBar.Style>
</ScrollBar>
