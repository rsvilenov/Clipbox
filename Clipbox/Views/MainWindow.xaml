<wnd:AcryllicWindow
    x:Class="Clipbox.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Clipbox.Views"
    xmlns:wnd="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
    Title="MainWindow"
    Width="525"
    Height="350"
    mc:Ignorable="d">
    <Window.Resources>
        <coreConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <!--  don't replace this with ContentControl or something, as the fade in background animation will not work  -->
    <Border>
        <Border.Background>
            <SolidColorBrush Opacity="0.3" Color="Black" />
        </Border.Background>
        <Border.CacheMode>
            <BitmapCache />
        </Border.CacheMode>

        <Border.Resources>
            <Storyboard x:Key="FadeInBackground">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:0.3" />
            </Storyboard>
        </Border.Resources>

        <Border.Style>
            <Style TargetType="Border">
                <!--  set the initial border's opacity to 0.1  -->
                <Setter Property="Opacity" Value="0.1" />
                <Style.Triggers>
                    <!--  if the fade animations are enabled, animate border's opacity to 1  -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                            <Condition Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainWindow}}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard x:Name="BsFadeInBackground" Storyboard="{StaticResource FadeInBackground}" />
                        </MultiDataTrigger.EnterActions>
                        <MultiDataTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="BsFadeInBackground" />
                        </MultiDataTrigger.ExitActions>
                    </MultiDataTrigger>
                    <!--  if the fade animations are disabled, set the border's opacity to 1 via a setter  -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                            <Condition Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainWindow}}}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Opacity" Value="1" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>


        <ContentPresenter x:Name="clipboardContents" />

    </Border>
</wnd:AcryllicWindow>
