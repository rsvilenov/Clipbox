<wnd:AcryllicWindow
    x:Class="Clipbox.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bo="clr-namespace:Clipbox.ViewModels.BindableObjects"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:coreConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Clipbox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wnd="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
    Title="MainWindow"
    Width="525"
    Height="350"
    mc:Ignorable="d">
    <Window.Resources>
        <coreConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <SolidColorBrush Opacity="0.3" Color="Black" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="47" />
            <ColumnDefinition />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <Style x:Key="tglButton" TargetType="{x:Type ToggleButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentControl
                                    Margin="10"
                                    Background="{TemplateBinding Background}"
                                    Foreground="{DynamicResource ControlForegroundBrush}"
                                    Template="{TemplateBinding Content}"
                                    ToolTip="{TemplateBinding ToolTip}" />
                            </Border>
                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Border.Background" Value="{DynamicResource ControlHighlightBackgroundBrush}" />
                                    <Setter Property="Border.BorderBrush" Value="{DynamicResource ControlHighlightBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Border.Background" Value="{DynamicResource AccentDark1Brush}" />
                                    <Setter Property="Border.BorderBrush" Value="{DynamicResource AccentLight1Brush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="textToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{DynamicResource ClassTextIcon}" />
                <Setter Property="ToolTip" Value="Show text items" />
            </Style>

            <Style
                x:Key="fileToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{DynamicResource ClassFileIcon}" />
                <Setter Property="ToolTip" Value="Show text items" />
            </Style>

            <Style
                x:Key="imageToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{DynamicResource ClassImageIcon}" />
                <Setter Property="ToolTip" Value="Show text items" />
            </Style>

            <Style
                x:Key="generalToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{DynamicResource ClassGeneralContentIcon}" />
                <Setter Property="ToolTip" Value="Show text items" />
            </Style>

            <Style
                x:Key="sourceWindowToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{DynamicResource SourceWindowsIcon}" />
                <Setter Property="ToolTip" Value="Filter by source application" />
            </Style>

            <Style
                x:Key="starredToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{DynamicResource StarEmptyIcon}" />
                <Setter Property="ToolTip" Value="Filter by source application" />
            </Style>

            <Style
                x:Key="myMachineToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{DynamicResource MyMachineItemsIcon}" />
                <Setter Property="ToolTip" Value="Show only items from current computer" />
            </Style>

            <Style
                x:Key="allMachinesToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{DynamicResource AllMachinesItemsIcon}" />
                <Setter Property="ToolTip" Value="Show only items from all my computers" />
            </Style>



            <Storyboard x:Key="FadeInBackground">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:0.4" />
            </Storyboard>

            <Storyboard x:Key="FadeInItem">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:0.4" />
            </Storyboard>

            <Storyboard x:Key="SlideLeft">
                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}" />
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.1" Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                    From="100"
                    To="0"
                    Duration="0:0:0.3" />
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:0.4" />
            </Storyboard>

            <Storyboard x:Key="SlideRight">
                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}" />
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.1" Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                    From="-50"
                    To="0"
                    Duration="0:0:0.3" />
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:0.4" />
            </Storyboard>


            <Storyboard x:Key="ExpandCategories">
                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}" />
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.1" Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    To="1"
                    Duration="0:0:0.3" />
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:0.4" />
            </Storyboard>
        </Grid.Resources>

        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="IsVisible" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard x:Name="BsFadeInBackground" Storyboard="{StaticResource FadeInBackground}" />
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="BsFadeInBackground" />
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Background="{DynamicResource TaskbarColorBrush}">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=IsVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="BsSlideRight" Storyboard="{StaticResource SlideRight}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="BsSlideRight" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <ToggleButton Margin="5,10" Style="{StaticResource starredToggleButton}" />

                    <Expander
                        Margin="0,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Header="Using StretchyExpanderTemp"
                        OverridesDefaultStyle="True"
                        Tag="{DynamicResource CategoriesIcon}"
                        Template="{StaticResource StretchyExpanderTemp}">

                        <StackPanel Margin="0,5" Orientation="Vertical">
                            <ToggleButton Margin="5,3" Style="{StaticResource textToggleButton}" />
                            <ToggleButton Margin="5,3" Style="{StaticResource imageToggleButton}" />
                            <ToggleButton Margin="5,3" Style="{StaticResource fileToggleButton}" />
                            <ToggleButton Margin="5,3" Style="{StaticResource generalToggleButton}" />
                        </StackPanel>

                    </Expander>

                    <Expander
                        Margin="0,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Header="Using StretchyExpanderTemp"
                        OverridesDefaultStyle="True"
                        Tag="{DynamicResource SyncedItemsIcon}"
                        Template="{StaticResource StretchyExpanderTemp}">
                        <StackPanel Margin="0,5" Orientation="Vertical">
                            <ToggleButton Margin="5,3" Style="{StaticResource myMachineToggleButton}" />
                            <ToggleButton Margin="5,3" Style="{StaticResource allMachinesToggleButton}" />
                        </StackPanel>

                    </Expander>


                    <ToggleButton Margin="5,10" Style="{StaticResource sourceWindowToggleButton}" />
                </StackPanel>

                <Button
                    Grid.Row="2"
                    VerticalAlignment="Bottom"
                    VerticalContentAlignment="Center"
                    BorderBrush="Transparent">
                    <ContentControl Margin="15" Template="{DynamicResource SettingsIcon}" />
                </Button>

            </Grid>
        </Border>

        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="2"
            Background="{DynamicResource TaskbarColorBrush}">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=IsVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="BsSlideLeft" Storyboard="{StaticResource SlideLeft}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="BsSlideLeft" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Grid
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="1"
                Height="30"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Black"
                Foreground="White"
                Text="Type here to search" />
        </Grid>



    </Grid>
</wnd:AcryllicWindow>
