<wnd:AcryllicWindow x:Class="Clipbox.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Clipbox"
        xmlns:bo="clr-namespace:Clipbox.ViewModels.BindableObjects"
        xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
        xmlns:wnd="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
        xmlns:coreConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI" 
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="525">
    <Window.Resources>
        <coreConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="Black" Opacity="0.3"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <Style TargetType="{x:Type ToggleButton}" x:Key="tglButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentControl 
                                Background="{TemplateBinding Background}"
                                Template="{TemplateBinding Content}" 
                                Foreground="{DynamicResource ControlForegroundBrush}" 
                                ToolTip="{TemplateBinding ToolTip}" 
                                Margin="10"/>
                            </Border>
                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Border.Background" Value="{DynamicResource ControlHighlightBackgroundBrush}" />
                                    <Setter Property="Border.BorderBrush" Value="{DynamicResource ControlHighlightBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Border.Background" Value="{DynamicResource AccentDark1Brush}" />
                                    <Setter Property="Border.BorderBrush" Value="{DynamicResource AccentLight1Brush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ToggleButton}" x:Key="textToggleButton" BasedOn="{StaticResource tglButton}">
                <Setter Property="Content" Value="{DynamicResource ClassTextIcon}" />
                <Setter Property="ToolTip" Value="Show text items" />
            </Style>

            <Style TargetType="{x:Type ToggleButton}" x:Key="fileToggleButton" BasedOn="{StaticResource tglButton}">
                <Setter Property="Content" Value="{DynamicResource ClassFileIcon}" />
                <Setter Property="ToolTip" Value="Show text items" />
            </Style>

            <Style TargetType="{x:Type ToggleButton}" x:Key="imageToggleButton" BasedOn="{StaticResource tglButton}">
                <Setter Property="Content" Value="{DynamicResource ClassImageIcon}" />
                <Setter Property="ToolTip" Value="Show text items" />
            </Style>

            <Style TargetType="{x:Type ToggleButton}" x:Key="generalToggleButton" BasedOn="{StaticResource tglButton}">
                <Setter Property="Content" Value="{DynamicResource ClassGeneralContentIcon}" />
                <Setter Property="ToolTip" Value="Show text items" />
            </Style>

            <Style TargetType="{x:Type ToggleButton}" x:Key="sourceWindowToggleButton" BasedOn="{StaticResource tglButton}">
                <Setter Property="Content" Value="{DynamicResource SourceWindowsIcon}" />
                <Setter Property="ToolTip" Value="Filter by source application" />
            </Style>

            <Style TargetType="{x:Type ToggleButton}" x:Key="starredToggleButton" BasedOn="{StaticResource tglButton}">
                <Setter Property="Content" Value="{DynamicResource StarEmptyIcon}" />
                <Setter Property="ToolTip" Value="Filter by source application" />
            </Style>

            <Style TargetType="{x:Type ToggleButton}" x:Key="myMachineToggleButton" BasedOn="{StaticResource tglButton}">
                <Setter Property="Content" Value="{DynamicResource MyMachineItemsIcon}" />
                <Setter Property="ToolTip" Value="Show only items from current computer" />
            </Style>

            <Style TargetType="{x:Type ToggleButton}" x:Key="allMachinesToggleButton" BasedOn="{StaticResource tglButton}">
                <Setter Property="Content" Value="{DynamicResource AllMachinesItemsIcon}" />
                <Setter Property="ToolTip" Value="Show only items from all my computers" />
            </Style>

            
            
            <Storyboard x:Key="FadeInBackground">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                 From="0" To="1"
                                 Duration="0:0:0.4" />
            </Storyboard>

            <Storyboard x:Key="FadeInItem">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                 From="0" To="1"
                                 Duration="0:0:0.4" />
            </Storyboard>

            <Storyboard x:Key="SlideLeft">
                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}"/>
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.1" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                              From="100" To="0" 
                              Duration="0:0:0.3" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                 From="0" To="1"
                                 Duration="0:0:0.4" />
            </Storyboard>

            <Storyboard x:Key="SlideRight">
                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}"/>
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.1" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                              From="-50" To="0" 
                              Duration="0:0:0.3" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                 From="0" To="1"
                                 Duration="0:0:0.4" />
            </Storyboard>


            <Storyboard x:Key="ExpandCategories">
                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}"/>
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.1" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                              To="1" 
                              Duration="0:0:0.3" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                 From="0" To="1"
                                 Duration="0:0:0.4" />
            </Storyboard>
        </Grid.Resources>

        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="IsVisible" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard  x:Name="BsFadeInBackground" Storyboard="{StaticResource FadeInBackground}" />
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="BsFadeInBackground" />
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource TaskbarColorBrush}">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=IsVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard  x:Name="BsSlideRight" Storyboard="{StaticResource SlideRight}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="BsSlideRight" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <ToggleButton
                        Margin="5,20"
                        Style="{StaticResource starredToggleButton}">
                    </ToggleButton>

                    <Expander Template="{StaticResource StretchyExpanderTemp}"
                  OverridesDefaultStyle="True"
                  Header="Using StretchyExpanderTemp"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                             Tag="{DynamicResource CategoriesIcon}"
                              Foreground="{DynamicResource ControlForegroundBrush}"
                  >
                        <StackPanel Orientation="Vertical"
                                >

                            <ToggleButton
                        Margin="5,2"
                        Style="{StaticResource textToggleButton}">
                            </ToggleButton>
                            <ToggleButton
                        Margin="5,2"
                        Style="{StaticResource imageToggleButton}">
                            </ToggleButton>
                            <ToggleButton
                        Margin="5,2"
                        Style="{StaticResource fileToggleButton}">
                            </ToggleButton>
                            <ToggleButton
                        Margin="5,2"
                        Style="{StaticResource generalToggleButton}">
                            </ToggleButton>
                        </StackPanel>

                    </Expander>

                    <Expander Template="{StaticResource StretchyExpanderTemp}"
                  OverridesDefaultStyle="True"
                  Header="Using StretchyExpanderTemp"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                              Tag="{DynamicResource SyncedItemsIcon}"
                              Foreground="{DynamicResource ControlForegroundBrush}"
                  >
                        <StackPanel Orientation="Vertical">
                            <ToggleButton
                        Margin="5,2"
                        Style="{StaticResource myMachineToggleButton}">
                            </ToggleButton>
                            <ToggleButton
                        Margin="5,2"
                        Style="{StaticResource allMachinesToggleButton}">
                            </ToggleButton>
                        </StackPanel>

                    </Expander>


                    <ToggleButton
                        Margin="5,20"
                        Style="{StaticResource sourceWindowToggleButton}">
                    </ToggleButton>
                </StackPanel>

                <Button 
                    Grid.Row="2" 
                    BorderBrush="Transparent"
                    VerticalContentAlignment="Center" 
                    VerticalAlignment="Bottom">
                    <ContentControl Margin="15" Template="{DynamicResource SettingsIcon}" />
                </Button>

            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Background="{DynamicResource TaskbarColorBrush}">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=IsVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard  x:Name="BsSlideLeft" Storyboard="{StaticResource SlideLeft}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="BsSlideLeft" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                HorizontalAlignment="Stretch"
            Grid.Column="1"
            Height="30"
            Background="Black"
            Foreground="White"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            Text="Type here to search"
            />
        </Grid>
        


    </Grid>
</wnd:AcryllicWindow>
