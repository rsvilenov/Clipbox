<localWindows:AcryllicWindow
    x:Class="Clipbox.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Clipbox.Core;assembly=Clipbox.Core"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:localWindows="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sysTheme="clr-namespace:Clipbox.Infrastructure.UI.Theme;assembly=Clipbox.Infrastructure.UI"
    Width="300"
    Height="300"
    AllowsTransparency="True"
    Background="{DynamicResource TaskbarColorBrush}"
    BorderBrush="{DynamicResource AccentBrush}"
    BorderThickness="1"
    FontSize="16"
    Foreground="White"
    Icon="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Images/Clip-WF.ico"
    ResizeMode="CanResizeWithGrip"
    SizeToContent="Width"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Title>
        <MultiBinding StringFormat="{}{0} ({1})">
            <Binding Source="{x:Static core:ProductConstants.PRODUCT_NAME}" />
            <Binding Source="Settings" />
        </MultiBinding>
    </Window.Title>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Background="Transparent"
            MouseDown="Border_MouseDown" />
        <Button
            Grid.Row="0"
            Grid.Column="1"
            MaxWidth="25"
            Margin="0,0,5,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="CloseButton_Click"
            Style="{DynamicResource BtnCloseWindow}"
            ToolTip="Close window">
            <i:Interaction.Behaviors>
                <infBeh:FrameworkElementDpiScalingBehavior />
            </i:Interaction.Behaviors>
        </Button>
        <Grid
            x:Name="mainGrid"
            Grid.Row="1"
            Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <TextBlock HorizontalAlignment="Left" Text="Pin the tray icon to the taskbar" />
                <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                    <customControls:ToggleSwitch
                        HorizontalAlignment="Left"
                        IsChecked="{Binding IsSettingChanged, Mode=OneWayToSource}"
                        OffText="{loc:Localize TGL_BTN_LBL_Off,
                                               ResourceLookupMode=Everywhere}"
                        OnText="{loc:Localize TGL_BTN_LBL_On,
                                              ResourceLookupMode=Everywhere}" />
                    <Image
                        MinWidth="100"
                        MinHeight="25"
                        Margin="5,0,0,0"
                        Source="/Resources/Images/Settings/DeskBand.png" />
                </StackPanel>

            </StackPanel>

            <StackPanel
                x:Name="pluginContainer"
                Grid.Row="2"
                Orientation="Vertical" />

        </Grid>


    </Grid>
</localWindows:AcryllicWindow>
