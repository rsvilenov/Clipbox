<UserControl
    x:Class="Clipbox.Views.ClipboardViewItemTile.ItemTypeIconBand"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infEnums="clr-namespace:Clipbox.Core.Enums;assembly=Clipbox.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ItemsControl x:Name="itemsControl" ItemsSource="{Binding ContentClasses}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid>
                    <ContentControl
                        MaxHeight="17"
                        Margin="5,0,0,0"
                        Foreground="#e4e4e6"
                        Template="{DynamicResource ClassImageIcon}"
                        ToolTip="Image">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.Image}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <ContentControl
                        MaxHeight="17"
                        Margin="5,0,0,0"
                        Foreground="#e4e4e6"
                        Template="{DynamicResource ClassFileIcon}"
                        ToolTip="File/Folder">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.File}" />
                                            <Condition Binding="{Binding Path=DataContext.IsGroupItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <ContentControl
                        MaxHeight="20"
                        Margin="5,0,0,0"
                        Background="Red"
                        Foreground="#e4e4e6"
                        Template="{DynamicResource ClassFileCollectionIcon}"
                        ToolTip="File/Folder collection">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.File}" />
                                            <Condition Binding="{Binding Path=DataContext.IsGroupItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <ContentControl
                        MaxHeight="16"
                        Margin="5,0,0,0"
                        Foreground="#e4e4e6"
                        Template="{DynamicResource ClassTextIcon}"
                        ToolTip="Text">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.Text}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <ContentControl
                        MaxHeight="17"
                        Margin="5,0,0,0"
                        Foreground="#e4e4e6"
                        Template="{DynamicResource ClassGeneralContentIcon}"
                        ToolTip="Content">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.GeneralContent}" />
                                            <Condition Binding="{Binding Path=DataContext.IsGroupItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <ContentControl
                        MaxHeight="20"
                        Margin="5,0,0,0"
                        Foreground="#e4e4e6"
                        Template="{DynamicResource ClassGeneralContentCollectionIcon}"
                        ToolTip="Content collection">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.GeneralContent}" />
                                            <Condition Binding="{Binding Path=DataContext.IsGroupItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
