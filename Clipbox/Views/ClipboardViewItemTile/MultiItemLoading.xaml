<UserControl
    x:Class="Clipbox.Views.ClipboardViewItemTile.MultiItemLoading"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bo="clr-namespace:Clipbox.ViewModels.BindableObjects"
    xmlns:coreConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infWindows="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:localConv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <localConv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
        <coreConv:MathAddConverter x:Key="MathAddConverter" />
    </UserControl.Resources>

    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="15" />
            <RowDefinition />
            <RowDefinition Height="15" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <Button
            Name="BtnScrollUpSubItem"
            Grid.Row="0"
            Grid.Column="2"
            Height="15"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Style="{DynamicResource BtnArrowUp}" />
        <Button
            Name="BtnScrollDownSubItem"
            Grid.Row="2"
            Grid.Column="2"
            Height="15"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Style="{DynamicResource BtnArrowDown}" />

        <Label
            Grid.Row="3"
            Height="25"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <Label.Content>
                <TextBlock Foreground="White" Text="{Binding TotalClipboardItemsCount, StringFormat={}{0} items}" />
            </Label.Content>
        </Label>

        <ListView
            Name="subItemsListView"
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="1"
            ItemsSource="{Binding PreviewItems}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <i:Interaction.Behaviors>
                <localBeh:ListViewScrollButtonBehavior IsScrollUpButton="True" ScrollButton="{Binding ElementName=BtnScrollUpSubItem}" />
                <localBeh:ListViewScrollButtonBehavior IsScrollUpButton="False" ScrollButton="{Binding ElementName=BtnScrollDownSubItem}" />
            </i:Interaction.Behaviors>
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border
                                    x:Name="Bd"
                                    Margin="5"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource MathAddConverter}">
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ListView}" />
                                            <Binding>
                                                <Binding.Source>
                                                    <!--  take into account the margin of the border (5 on top and 5 on bottom + 1 for border top and 1 for border bottom)  -->
                                                    <sys:Double>-15</sys:Double>
                                                </Binding.Source>
                                            </Binding>
                                        </MultiBinding>
                                    </Border.Height>
                                    <!--  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"  -->

                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--<WrapPanel />-->
                    <UniformGrid
                        MaxWidth="500"
                        MaxHeight="500"
                        Columns="2" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ContentControl x:Name="ccSubItem">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItemDimension">

                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <Grid>
                                                        <Grid.Background>
                                                            <SolidColorBrush Opacity="0.1" Color="DarkGray" />
                                                        </Grid.Background>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="30" />
                                                        </Grid.RowDefinitions>
                                                        <Rectangle
                                                            Grid.Row="0"
                                                            Width="{Binding PreviewWidth}"
                                                            Height="{Binding PreviewHeight}"
                                                            Margin="5"
                                                            Fill="Red" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItemNMore">

                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <Grid Width="{Binding Path=Height, RelativeSource={RelativeSource Self}}" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}">
                                                        <i:Interaction.Behaviors>
                                                            <!--  ClipboardViewSubItemNMore elements are still selectable with a click despite ListViewItem.Focusable=False, so we need a behavior to cancel the click events  -->
                                                            <localBeh:FrameworkElementDisableClickBehavior AncestorElement="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}" />
                                                        </i:Interaction.Behaviors>
                                                        <Grid.ToolTip>
                                                            <TextBlock Text="{Binding Path=(bo:ClipboardViewSubItemNMore.NumberOfItems), StringFormat='{}{0:#} more files.'}" />
                                                        </Grid.ToolTip>
                                                        <Grid.Background>
                                                            <SolidColorBrush Opacity="0.1" Color="DarkGray" />
                                                        </Grid.Background>

                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            FontWeight="Bold"
                                                            Foreground="White"
                                                            Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}"
                                                            Text="{Binding Path=(bo:ClipboardViewSubItemNMore.NumberOfItems), StringFormat={}{0:+#}}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>

                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                        </ContentControl.Style>
                    </ContentControl>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</UserControl>
