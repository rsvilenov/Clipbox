<tile:SingleItemBase
    x:Class="Clipbox.Views.ClipboardViewItemTile.SingleItemLoading"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tile="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Grid.Background>
            <SolidColorBrush Opacity="0.2" Color="{Binding PreviewContainerBackgroundColor}" />
        </Grid.Background>

        <Grid.Resources>
            <Storyboard x:Key="FadeInItem">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:0.7" />
            </Storyboard>
            <Storyboard x:Key="FadiInWithDelay">
                <DoubleAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames
                    BeginTime="0:0:1.5"
                    Storyboard.TargetProperty="Visibility"
                    Duration="0">
                    <DiscreteObjectKeyFrame Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation
                    BeginTime="0:0:1.5"
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="0.6"
                    Duration="0:0:0.7" />
            </Storyboard>
        </Grid.Resources>

        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=IsShownIntoView}" Value="True" />
                            <Condition Binding="{Binding Path=IsFadeInEnabled}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard x:Name="FadeInItemContents" Storyboard="{StaticResource FadeInItem}" />
                        </MultiDataTrigger.EnterActions>
                        <MultiDataTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="FadeInItemContents" />
                        </MultiDataTrigger.ExitActions>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid
            Grid.Row="0"
            MinHeight="{Binding ThumbnailAreaMinHeight}"
            MaxHeight="{Binding ThumbnailAreaMaxHeight}"
            Margin="10">

            <ContentControl
                Width="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Gray"
                Template="{DynamicResource LoadingSolidIcon}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Setter Property="Opacity" Value="0.6" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=IsShownIntoView}" Value="True" />
                                    <Condition Binding="{Binding Path=IsLoadingIndicatorFadeInEnabled}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="DelayShowStoryboard" Storyboard="{StaticResource FadiInWithDelay}" />
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="DelayShowStoryboard" />
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=IsShownIntoView}" Value="True" />
                                    <Condition Binding="{Binding Path=IsLoadingIndicatorFadeInEnabled}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>

                </ContentControl.Style>
            </ContentControl>
            <!--  leave this transparent for now... just to occupy the space  -->
            <Rectangle
                Width="{Binding ViewItemDimensions.PreviewWidth}"
                Height="{Binding ViewItemDimensions.PreviewHeight}"
                VerticalAlignment="Center"
                Fill="Transparent" />
            <!--
                to show a dark rectangle occupying the exact space that will be used by
                the preview, use the follwing properties on the above grid:
                
                Fill="Black"
                Opacity="0.1"
            -->
        </Grid>

    </Grid>
</tile:SingleItemBase>
