<tile:SingleItemBase
    x:Class="Clipbox.Views.ClipboardViewItemTile.SingleItemLoading"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tile="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Grid.Background>
            <SolidColorBrush Opacity="0.2" Color="{Binding PreviewContainerBackgroundColor}" />
        </Grid.Background>

        <Grid
            Grid.Row="0"
            MinHeight="{Binding ThumbnailAreaMinHeight}"
            MaxHeight="{Binding ThumbnailAreaMaxHeight}"
            Margin="10">
            <!--  leave this transparent for now... just to occupy the space  -->
            <Rectangle
                Width="{Binding ViewItemDimensions.PreviewWidth}"
                Height="{Binding ViewItemDimensions.PreviewHeight}"
                VerticalAlignment="Center"
                Fill="Black"
                Opacity="0.1" />
        </Grid>

    </Grid>
</tile:SingleItemBase>
