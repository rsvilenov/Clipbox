<tile:SingleItemBase
    x:Class="Clipbox.Views.ClipboardViewItemTile.SingleItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tile="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <tile:SingleItemBase.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </tile:SingleItemBase.Resources>
    <Grid x:Name="mainGrid">
        <!--
            we need to set a background other than Null to this grid in order to make it hit-testable.
            If we leave the background to null, then no mouse events will fire for the space with no content.
        -->
        <!--<Grid.Background>
            <SolidColorBrush Color="Transparent" />
        </Grid.Background>-->

        <Grid.Resources>
            <Storyboard x:Key="FadeInItem">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:0.7" />
            </Storyboard>
        </Grid.Resources>

        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="FadeInItemContents" Storyboard="{StaticResource FadeInItem}" />
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="FadeInItemContents" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.Background>
            <SolidColorBrush Opacity="0.2" Color="{Binding PreviewContainerBackgroundColor}" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!--  border to apply the color animations to  -->
        <Border
            x:Name="borderToAnimate"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0" />

        <!--  thumbnail area  -->
        <Grid
            Grid.Row="0"
            MinHeight="{Binding ThumbnailAreaMinHeight}"
            MaxHeight="{Binding ThumbnailAreaMaxHeight}"
            Margin="10">

            <Image
                Width="{Binding ClipboardViewItem.PreviewItem.Image.Width}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Source="{Binding ClipboardViewItem.PreviewItem.Image}"
                Stretch="Uniform"
                ToolTip="{Binding ClipboardViewItem.PreviewItem.Description}" />

            <!--  dim the item by placing a semi-transparent black rectangle on top of it  -->
            <Rectangle
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Fill="Black"
                Opacity="0.3"
                Visibility="{Binding IsDimmed, Converter={StaticResource BooleanToVisibilityConverter}}" />

        </Grid>

        <Label
            Grid.Row="1"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            FontSize="12"
            Foreground="White">
            <i:Interaction.Behaviors>
                <infBeh:FrameworkElementDpiScalingBehavior />
            </i:Interaction.Behaviors>
            <Label.Content>
                <!--  TODO: calculate the MaxWidth dynamically  -->
                <TextBlock
                    MaxWidth="200"
                    Text="{Binding ClipboardViewItem.PreviewItem.Text}"
                    TextBlock.TextTrimming="CharacterEllipsis"
                    ToolTipService.Placement="Center">
                    <TextBlock.ToolTip>
                        <!--  the tooltip won't scale with the textblock, probably because it is not part of its visual tree  -->
                        <ToolTip>
                            <ToolTip.Content>
                                <TextBlock FontSize="12" Text="{Binding ClipboardViewItem.PreviewItem.Text}">
                                    <!--<TextBlock.LayoutTransform>
                                                                                                <ScaleTransform CenterX="0" CenterY="0" ScaleX="{Binding Path=ScaleFactor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=infWindows:PerMonitorDpiWindow}}" ScaleY="{Binding}" />
                                                                                            </TextBlock.LayoutTransform>-->
                                </TextBlock>
                            </ToolTip.Content>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
            </Label.Content>
        </Label>

    </Grid>
</tile:SingleItemBase>
