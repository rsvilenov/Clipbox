<customControls:WindowFrame
    x:Class="Clipbox.Views.RebuildIndicesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Clipbox.Core;assembly=Clipbox.Core"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="600"
    Height="250"
    AllowsTransparency="True"
    Background="{DynamicResource TaskbarColorBrush}"
    BorderBrush="#3a3a3a"
    BorderThickness="0"
    CaptionBackground="Transparent"
    CaptionForeground="{DynamicResource ControlForegroundBrush}"
    FontSize="16"
    Foreground="White"
    Icon="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Images/Clip-WF.ico"
    IsCloseButtonVisible="False"
    ResizeMode="NoResize"
    SizeToContent="Manual"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo
            Description="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=Title}"
            ProgressState="{Binding DataContext.ProgressState, ElementName=mainGrid}"
            ProgressValue="{Binding DataContext.TaskbarProgressValue, ElementName=mainGrid}" />
    </Window.TaskbarItemInfo>
    <Window.Title>
        <MultiBinding StringFormat="{}{0}: {1}">
            <Binding Source="{x:Static core:ProductConstants.PRODUCT_NAME}" />
            <Binding Source="rebuilding search index" />
        </MultiBinding>
    </Window.Title>
    <customControls:WindowFrame.CaptionIconControl>
        <ContentControl Template="{StaticResource ApplicationIcon}" />
    </customControls:WindowFrame.CaptionIconControl>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl
                Grid.RowSpan="2"
                Grid.Column="0"
                Width="32"
                Margin="15,0,0,0"
                VerticalAlignment="Center">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Template" Value="{DynamicResource LoadingSolidIcon}" />
                        <Setter Property="Foreground" Value="LightGray" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRebuildingFailed}" Value="True">
                                <Setter Property="Template" Value="{DynamicResource ErrorIcon}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlertBrush1}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text">
                            <Setter.Value>
                                <MultiBinding StringFormat="{}{0} {1} %">
                                    <Binding Source="Rebuilding indices: " />
                                    <Binding Path="ProgressPercentage" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRebuildingFailed}" Value="True">
                                <Setter Property="Text">
                                    <Setter.Value>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Source="Rebuilding indices: " />
                                            <Binding Source="Failed." />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Margin="15,10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Some clipborad entries caused the building of the index to fail. If you click Retry, these entries will be deleted, so that the index can be built."
                TextWrapping="Wrap"
                Visibility="{Binding HasRebuildingFailed, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Orientation="Horizontal">

            <Button
                Width="150"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding Cancel}"
                Content="Cancel"
                Foreground="{DynamicResource ControlForegroundBrush}"
                Style="{DynamicResource BtnCancel}" />

            <Button
                Width="150"
                Height="30"
                Margin="35,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding Retry}"
                Content="Retry"
                Foreground="{DynamicResource ControlForegroundBrush}"
                Style="{DynamicResource BtnRebuild}"
                Visibility="{Binding HasRebuildingFailed, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

    </Grid>
</customControls:WindowFrame>
