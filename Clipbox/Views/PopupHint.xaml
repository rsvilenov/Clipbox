<Popup
    x:Class="Clipbox.Views.PopupHint"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="500"
    MinHeight="80"
    Panel.ZIndex="1001"
    d:DesignHeight="80"
    d:DesignWidth="500"
    AllowsTransparency="True"
    StaysOpen="False"
    mc:Ignorable="d">
    <Popup.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Popup.Resources>
    <Grid x:Name="mainGrid" Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Polygon
            Grid.Row="0"
            Grid.Column="0"
            Margin="10,0,0,0"
            Fill="Orange"
            Opacity="{Binding ElementName=ttpPulsingBorder, Path=Opacity, Mode=OneWay}"
            Points="5,0 10,10, 0,10"
            Stroke="Orange" />
        <Border
            x:Name="ttpPulsingBorder"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="Orange"
            BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AreFadeAnimationsEnabled}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="sbBlink">
                                    <BeginStoryboard.Storyboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                BeginTime="0:0:1"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0.3"
                                                To="1"
                                                Duration="0:0:0.4" />
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                Storyboard.TargetProperty="Opacity"
                                                From="1"
                                                To="1"
                                                Duration="0:0:0.4" />
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                Storyboard.TargetProperty="Opacity"
                                                From="1"
                                                To="0.3"
                                                Duration="0:0:0.4" />
                                        </Storyboard>
                                    </BeginStoryboard.Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="sbBlink" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#2d2d30"
            BorderBrush="Transparent"
            BorderThickness="1" />

        <ContentControl
            Grid.Row="1"
            Grid.Column="0"
            Width="30"
            Height="30"
            Margin="10,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="Orange"
            Opacity="{Binding ElementName=ttpPulsingBorder, Path=Opacity, Mode=OneWay}"
            Template="{StaticResource HintIcon}" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            Margin="10,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Foreground="White"
            Text="{Binding Text}"
            TextWrapping="Wrap" />

        <Button
            Grid.Row="1"
            Grid.Column="2"
            MaxWidth="20"
            Margin="15,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Command="{Binding CloseCommand}"
            Style="{StaticResource BtnCloseHintTooltip}" />
    </Grid>
</Popup>
