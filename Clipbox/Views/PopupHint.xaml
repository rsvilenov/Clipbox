<Popup
    x:Class="Clipbox.Views.PopupHint"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="500"
    MinHeight="80"
    Panel.ZIndex="1001"
    d:DesignHeight="80"
    d:DesignWidth="500"
    AllowsTransparency="True"
    StaysOpen="False"
    mc:Ignorable="d">
    <Popup.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </Popup.Resources>
    <Grid x:Name="mainGrid" Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Polygon
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,0,0"
            VerticalAlignment="Center"
            Fill="Orange"
            Opacity="{Binding ElementName=ttpPulsingBorder, Path=Opacity, Mode=OneWay}"
            Points="16,0,0,8,16,16"
            Stroke="Orange">
            <Polygon.Style>
                <Style TargetType="Polygon">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ArrowDirection}" Value="{x:Static local:PopupArrowDirection.Left}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Polygon.Style>
        </Polygon>
        <Polygon
            x:Name="topArrow"
            Grid.Row="0"
            Grid.Column="1"
            Margin="10,0,0,0"
            Fill="Orange"
            Opacity="{Binding ElementName=ttpPulsingBorder, Path=Opacity, Mode=OneWay}"
            Points="8,0 16,16, 0,16"
            Stroke="Orange">
            <Polygon.Style>
                <Style TargetType="Polygon">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ArrowDirection}" Value="{x:Static local:PopupArrowDirection.Top}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Polygon.Style>
        </Polygon>
        <Border
            x:Name="ttpPulsingBorder"
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="Orange"
            BorderThickness="2">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AreFadeAnimationsEnabled}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="sbBlink">
                                    <BeginStoryboard.Storyboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                BeginTime="0:0:1"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0.3"
                                                To="1"
                                                Duration="0:0:0.4" />
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                Storyboard.TargetProperty="Opacity"
                                                From="1"
                                                To="1"
                                                Duration="0:0:0.4" />
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                Storyboard.TargetProperty="Opacity"
                                                From="1"
                                                To="0.3"
                                                Duration="0:0:0.4" />
                                        </Storyboard>
                                    </BeginStoryboard.Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="sbBlink" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#2d2d30"
            BorderBrush="Transparent"
            BorderThickness="2" />

        <ContentControl
            Grid.Row="1"
            Grid.Column="1"
            Width="40"
            Height="40"
            Margin="10,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="Orange"
            Opacity="{Binding ElementName=ttpPulsingBorder, Path=Opacity, Mode=OneWay}"
            Template="{StaticResource HintIcon}" />


        <Grid
            Grid.Row="1"
            Grid.Column="2"
            HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="10,20"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="White"
                Text="{Binding Text}"
                TextAlignment="Center"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel
                Grid.Row="1"
                MaxHeight="55"
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{Binding IsQuestion, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button
                    MinHeight="30"
                    MaxWidth="55"
                    Margin="15,7"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding ConfirmCommand}"
                    Content="{loc:Localize BTN_LBL_Yes}"
                    FontSize="16"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Style="{StaticResource BtnYes}" />
                <Button
                    Grid.Column="1"
                    MinHeight="30"
                    MaxWidth="55"
                    Margin="25,7"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding DeclineCommand}"
                    Content="{loc:Localize BTN_LBL_No}"
                    FontSize="16"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Style="{StaticResource BtnNo}" />
            </StackPanel>
        </Grid>

        <Button
            Grid.Row="1"
            Grid.Column="3"
            MaxWidth="20"
            Margin="15,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Command="{Binding CloseCommand}"
            IsEnabled="{Binding IsQuestion, Converter={StaticResource InverseBooleanConverter}}"
            Style="{StaticResource BtnCloseHintTooltip}"
            Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Popup>
