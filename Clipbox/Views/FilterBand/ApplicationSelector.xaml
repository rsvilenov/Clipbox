<filterBand:FilterDialogBase
    x:Class="Clipbox.Views.FilterBand.ApplicationSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filterBand="clr-namespace:Clipbox.Views.FilterBand"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <Style BasedOn="{StaticResource MinimalisticScrollBarStyle}" TargetType="ScrollBar">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Margin" Value="0,5,2,5" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        x:Name="mainBorder"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1">
        <Grid
            Width="600"
            Height="550"
            Margin="15"
            Background="{DynamicResource TaskbarColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Template="{DynamicResource SourceWindowsIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl
                    Grid.Column="0"
                    Width="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Template="{DynamicResource LoadingSolidIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <StackPanel
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="18"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Text="{loc:Localize LBL_APPSELECTOR_TITLE}" />
                </StackPanel>

            </Grid>


            <GroupBox
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Padding="15"
                VerticalAlignment="Stretch"
                BorderBrush="DarkGray"
                BorderThickness="0.3"
                Foreground="{DynamicResource ControlForegroundBrush}">
                <GroupBox.Header>
                    <TextBlock Text="{loc:Localize LBL_APPSELECTOR_FILTER_BY_APP}">
                        <i:Interaction.Behaviors>
                            <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                        </i:Interaction.Behaviors>
                    </TextBlock>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="60" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ListView
                        Grid.Row="0"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        ItemsSource="{Binding SelectedApps}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="10" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <ContentPresenter
                                                Margin="5,0,0,5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderBrush="DarkGray"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                    <Grid Margin="5,3,3,5" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            MaxHeight="20"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="{Binding Path=Icon}"
                                            ToolTip="{Binding Path=FormattedProductName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="{Binding FormattedProductName}">
                                            <i:Interaction.Behaviors>
                                                <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                                            </i:Interaction.Behaviors>
                                        </TextBlock>
                                        <Button
                                            Grid.Column="2"
                                            MaxWidth="15"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveApplication, ElementName=mainBorder}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource BtnRemove}"
                                            ToolTip="Deselect" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Text="{loc:Localize LBL_APPSELECTOR_SELECT_APPS_OVERLAY}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=SelectedApps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <customControls:SearchTextBox
                        x:Name="searchTextBox"
                        Grid.Row="1"
                        Height="30"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        OverlayText="{loc:Localize LBL_APPSELECTOR_SEARCH_OVERLAY}"
                        SearchRequested="SearchTextBox_SearchRequested" />
                    <ListView
                        x:Name="availableAppsListView"
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                        ItemsSource="{Binding AppInfoCollection}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="10" Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <ContentPresenter
                                                Margin="5,0,0,5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderBrush="DarkGray"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                    <Grid Margin="5,3,3,5" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            MaxHeight="20"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="{Binding Path=Icon}"
                                            ToolTip="{Binding Path=FormattedProductName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="{Binding FormattedProductName}">
                                            <i:Interaction.Behaviors>
                                                <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                                            </i:Interaction.Behaviors>
                                        </TextBlock>
                                        <Button
                                            Grid.Column="2"
                                            MaxWidth="15"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.AddApplication, ElementName=mainBorder}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource BtnAdd}"
                                            ToolTip="Select" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

            </GroupBox>

            <GroupBox
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,15,0,0"
                Padding="7"
                VerticalAlignment="Stretch"
                BorderBrush="DarkGray"
                BorderThickness="0.3"
                Foreground="{DynamicResource ControlForegroundBrush}">
                <GroupBox.Header>
                    <TextBlock Text="{loc:Localize LBL_APPSELECTOR_FILTER_BY_WINDOW_TITLE}">
                        <i:Interaction.Behaviors>
                            <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                        </i:Interaction.Behaviors>
                    </TextBlock>
                </GroupBox.Header>
                <customControls:SearchTextBox
                    Height="30"
                    Margin="8,0,8,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    OverlayText="{loc:Localize LBL_APPSELECTOR_FILTER_BY_WINDOW_OVERLAY}"
                    Text="{Binding WindowCaptionSearchString, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
                <!--<TextBox
                    Height="30"
                    Margin="8,0,8,0"
                    HorizontalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    FontSize="14"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Text="{Binding WindowCaptionSearchString}" />-->
            </GroupBox>


            <Button
                x:Name="btnOk"
                Grid.Row="3"
                Grid.Column="0"
                Width="70"
                Height="30"
                Margin="10"
                VerticalAlignment="Center"
                Command="{Binding OkClicked}"
                Content="{loc:Localize BTN_LBL_Ok}"
                Foreground="White"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                Style="{DynamicResource BtnOk}" />

            <Button
                x:Name="btnCancel"
                Grid.Row="3"
                Grid.Column="1"
                Width="70"
                Height="30"
                Margin="10"
                VerticalAlignment="Center"
                Command="{Binding CancelClicked}"
                Content="{loc:Localize BTN_LBL_Cancel}"
                Foreground="White"
                Style="{DynamicResource BtnCancel}" />
        </Grid>
    </Border>
</filterBand:FilterDialogBase>
