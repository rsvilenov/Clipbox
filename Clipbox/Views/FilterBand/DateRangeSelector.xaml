<filterBand:FilterDialogBase
    x:Class="Clipbox.Views.FilterBand.DateRangeSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filterBand="clr-namespace:Clipbox.Views.FilterBand"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:MillisecondsToHumanReadableDateStringConverter x:Key="MillisecondsToHumanReadableDateStringConverter" />
    </UserControl.Resources>
    <Border
        x:Name="mainBorder"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1">
        <Grid Margin="15" Background="{DynamicResource TaskbarColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="1.3*" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Template="{DynamicResource DateSelectionIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl
                    Grid.Column="0"
                    Width="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Template="{DynamicResource LoadingSolidIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <Grid Grid.Column="1" Margin="15,0,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding AreAnyDatesAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <i:Interaction.Behaviors>
                            <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                        </i:Interaction.Behaviors>
                        <TextBlock FontSize="14" Foreground="White">
                            <Run Text="{loc:Localize LBL_DATERANGESELECTOR_SHOW_ITEMS_FROM}" />
                            <Run FontWeight="Bold" Text="{Binding SelectedMinDateTimeMs, Converter={StaticResource MillisecondsToHumanReadableDateStringConverter}}" />
                        </TextBlock>
                        <TextBlock
                            FontSize="14"
                            Foreground="White"
                            Visibility="{Binding AreMinAndMaxSelectedDatesDistinct, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Run Text=" " />
                            <Run Text="{loc:Localize LBL_DATERANGESELECTOR_SHOW_ITEMS_TO}" />
                            <Run FontWeight="Bold" Text="{Binding SelectedMaxDateTimeMs, Converter={StaticResource MillisecondsToHumanReadableDateStringConverter}}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="White"
                        IsEnabled="{Binding AreAnyDatesAvailable, Converter={StaticResource InverseBooleanConverter}}"
                        Text="{loc:Localize LBL_DATERANGESELECTOR_NO_DATES_AVAILABLE}"
                        Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />

                </Grid>

            </Grid>

            <filterBand:RangeSlider
                x:Name="rangeSlider"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="15,25,15,0"
                VerticalAlignment="Top"
                IsEnabled="{Binding AreAnyDatesAvailable}"
                LowerValue="{Binding SelectedMinDateTimeMs, Mode=TwoWay}"
                Maximum="{Binding MaxDateTimeMs}"
                Minimum="{Binding MinDateTimeMs}"
                UpperValue="{Binding SelectedMaxDateTimeMs, Mode=TwoWay}" />

            <Button
                x:Name="btnOk"
                Grid.Row="2"
                Grid.Column="0"
                Width="70"
                Height="30"
                Margin="5"
                Command="{Binding OkClicked}"
                Content="{loc:Localize BTN_LBL_Ok}"
                Foreground="White"
                IsEnabled="{Binding AreAnyDatesAvailable}"
                Style="{DynamicResource BtnOk}" />

            <Button
                x:Name="btnCancel"
                Grid.Row="2"
                Grid.Column="1"
                Width="70"
                Height="30"
                Margin="5"
                Command="{Binding CancelClicked}"
                Content="{loc:Localize BTN_LBL_Cancel}"
                Foreground="White"
                Style="{DynamicResource BtnCancel}" />
        </Grid>
    </Border>
</filterBand:FilterDialogBase>
