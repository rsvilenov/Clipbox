<UserControl
    x:Class="Clipbox.Views.FilterBand.FilterBand"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="47"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Styles/ToggleButtonBaseStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Expander.xaml" />
                <ResourceDictionary>
                    <conv:MillisecondsToHumanReadableDateStringConverter x:Key="MillisecondsToHumanReadableDateStringConverter" />

                    <Style
                        x:Key="textToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource ClassTextIcon}" />
                        <Setter Property="ToolTip" Value="Show text items" />
                    </Style>

                    <Style
                        x:Key="fileToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource ClassFileIcon}" />
                        <Setter Property="ToolTip" Value="Show files" />
                    </Style>

                    <Style
                        x:Key="imageToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource ClassImageIcon}" />
                        <Setter Property="ToolTip" Value="Show images" />
                    </Style>

                    <Style
                        x:Key="generalToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource ClassGeneralContentIcon}" />
                        <Setter Property="ToolTip" Value="Show other items" />
                    </Style>

                    <Style
                        x:Key="applicationSelectionToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource SourceWindowsIcon}" />
                        <Setter Property="ToolTip" Value="Filter by source application/window" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AppSelectorToggled}" Value="True">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <StackPanel MaxWidth="350" Orientation="Vertical">
                                            <TextBlock TextWrapping="Wrap">
                                                <!--  WARNING: do not put these runs on a new line each, as this will add a space between each run  -->
                                                <Run Text="Showing items, coming from" /><Run Text="&#x0a;" /><Run FontWeight="Bold" Text="{Binding SelectedAppsString}" />
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WindowCaptionSearchString}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <!--  WARNING: do not put these runs on a new line each, as this will add a space between each run  -->
                                                <Run Text="&#x0a;" /><Run Text="as well as any windows with a caption, containing" /><Run Text="&#x0a;" /><Run FontWeight="Bold" Text="{Binding WindowCaptionSearchString, StringFormat='*{0}*'}" />
                                            </TextBlock>
                                        </StackPanel>

                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style
                        x:Key="dateRangeSelectionToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource DateSelectionIcon}" />
                        <Setter Property="ToolTip" Value="Filter by date" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DateRangeToggled}" Value="True">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <TextBlock>
                                            <!--  WARNING: do not put these runs on a new line each, as this will add a space between each run  -->
                                            <Run Text="Showing items, created from " /><Run FontWeight="Bold" Text="{Binding StartDateMs, Converter={StaticResource MillisecondsToHumanReadableDateStringConverter}}" /><Run Text=" to " /><Run FontWeight="Bold" Text="{Binding EndDateMs, Converter={StaticResource MillisecondsToHumanReadableDateStringConverter}}" />
                                        </TextBlock>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style
                        x:Key="myMachineToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource MyMachineItemsIcon}" />
                        <Setter Property="ToolTip" Value="Show only items from current computer" />
                    </Style>

                    <Style
                        x:Key="allMachinesToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource AllMachinesItemsIcon}" />
                        <Setter Property="ToolTip" Value="Show only items from all my computers" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button
            Name="scrollBtnUp"
            Grid.Row="0"
            Height="10"
            VerticalAlignment="Center"
            Style="{DynamicResource BtnArrowUp}" />
        <Button
            Name="scrollBtnDown"
            Grid.Row="2"
            Height="10"
            VerticalAlignment="Center"
            Style="{DynamicResource BtnArrowDown}" />
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">
            <i:Interaction.Behaviors>
                <localBeh:ScrollViewerScrollButtonsBehavior ButtonScrollDirection="Up" ScrollButton="{Binding ElementName=scrollBtnUp}" />
                <localBeh:ScrollViewerScrollButtonsBehavior ButtonScrollDirection="Down" ScrollButton="{Binding ElementName=scrollBtnDown}" />
            </i:Interaction.Behaviors>
            <StackPanel
                x:Name="scrollableContent"
                HorizontalAlignment="Stretch"
                Orientation="Vertical">

                <Expander
                    x:Name="TypeExpander"
                    Margin="0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Collapsed="TypeExpander_Collapsed"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Header="{DynamicResource CategoriesIcon}"
                    OverridesDefaultStyle="True"
                    Tag="{DynamicResource CategoriesIcon}"
                    Template="{StaticResource VerticalStretchyExpander}">

                    <StackPanel Margin="0,5" Orientation="Vertical">
                        <ToggleButton
                            Margin="5,3"
                            IsChecked="{Binding TextTypeSelected}"
                            Style="{StaticResource textToggleButton}" />
                        <ToggleButton
                            Margin="5,3"
                            IsChecked="{Binding ImageTypeSelected}"
                            Style="{StaticResource imageToggleButton}" />
                        <ToggleButton
                            Margin="5,3"
                            IsChecked="{Binding FileTypeSelected}"
                            Style="{StaticResource fileToggleButton}" />
                        <ToggleButton
                            Margin="5,3"
                            IsChecked="{Binding GeneralTypeSelected}"
                            Style="{StaticResource generalToggleButton}" />
                    </StackPanel>

                </Expander>

                <Expander
                    x:Name="CloudExpander"
                    Margin="0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Collapsed="CloudExpander_Collapsed"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Header="{DynamicResource SyncedItemsIcon}"
                    OverridesDefaultStyle="True"
                    Tag="{DynamicResource SyncedItemsIcon}"
                    Template="{StaticResource VerticalStretchyExpander}">

                    <StackPanel Margin="0,5" Orientation="Vertical">
                        <ToggleButton
                            Margin="5,3"
                            IsChecked="{Binding LocalMachineSourceSelected}"
                            Style="{StaticResource myMachineToggleButton}" />
                        <ToggleButton
                            Margin="5,3"
                            IsChecked="{Binding CloudSourceSelected}"
                            Style="{StaticResource allMachinesToggleButton}" />
                    </StackPanel>

                </Expander>

                <ToggleButton
                    Margin="5,10"
                    IsChecked="{Binding AppSelectorToggled}"
                    PreviewMouseDown="ToggleApplicationSelectionButton_PreviewMouseDown"
                    Style="{StaticResource applicationSelectionToggleButton}" />
                <ToggleButton
                    Margin="5,10"
                    IsChecked="{Binding DateRangeToggled}"
                    PreviewMouseDown="ToggleDateRangeSelectionButton_PreviewMouseDown"
                    Style="{StaticResource dateRangeSelectionToggleButton}" />

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
