<UserControl
    x:Class="Clipbox.Views.FilterBand.FilterBand"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="47"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Styles/ToggleButtonBaseStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Expander.xaml" />
                <ResourceDictionary>
                    <conv:MillisecondsToHumanReadableDateStringConverter x:Key="MillisecondsToHumanReadableDateStringConverter" />
                    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

                    <Style
                        x:Key="textToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource ClassTextIcon}" />
                        <Setter Property="ToolTip" Value="{loc:Localize TTP_FILTERBAND_TEXT}" />
                    </Style>

                    <Style
                        x:Key="fileToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource ClassFileIcon}" />
                        <Setter Property="ToolTip" Value="{loc:Localize TTP_FILTERBAND_FILES}" />
                    </Style>

                    <Style
                        x:Key="imageToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource ClassImageIcon}" />
                        <Setter Property="ToolTip" Value="{loc:Localize TTP_FILTERBAND_IMAGES}" />
                    </Style>

                    <Style
                        x:Key="generalToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource ClassGeneralContentIcon}" />
                        <Setter Property="ToolTip" Value="{loc:Localize TTP_FILTERBAND_OTHER_ITEMS}" />
                    </Style>

                    <Style
                        x:Key="applicationSelectionToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource SourceWindowsIcon}" />
                        <Setter Property="ToolTip" Value="{loc:Localize TTP_FILTERBAND_FILTER_BY_APP}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AppSelectorToggled}" Value="True">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <StackPanel MaxWidth="350" Orientation="Vertical">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{loc:Localize TTP_FILTERBAND_FILTER_BY_APP_TOGGLED_PREFIX}" />
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAppsString}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedAppsString}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run FontWeight="Bold" Text="{loc:Localize TTP_FILTERBAND_FILTER_BY_APP_TOGGLED_ALL_APPS}" />
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAppsString}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedAppsString}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <!--  WARNING: do not put these runs on a new line each, as this will add a space between each run  -->
                                                <Run FontWeight="Bold" Text="{Binding SelectedAppsString}" />
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WindowCaptionSearchString}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding WindowCaptionSearchString}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <!--  WARNING: do not put these runs on a new line each, as this will add a space between each run  -->
                                                <Run Text="{loc:Localize TTP_FILTERBAND_FILTER_BY_APP_TOGGLED_CAPTION_CONTAINS}" /><Run Text="&#x0a;" /><Run FontWeight="Bold" Text="{Binding WindowCaptionSearchString, StringFormat='*{0}*'}" />
                                            </TextBlock>
                                        </StackPanel>

                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style
                        x:Key="dateRangeSelectionToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource DateSelectionIcon}" />
                        <Setter Property="ToolTip" Value="{loc:Localize TTP_FILTERBAND_FILTER_BY_DATE}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DateRangeToggled}" Value="True">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <TextBlock>
                                            <Run Text="{loc:Localize TTP_FILTERBAND_FILTER_BY_DATE_TOGGLED_PREFIX}" />
                                            <Run FontWeight="Bold" Text="{Binding StartDateMs, Converter={StaticResource MillisecondsToHumanReadableDateStringConverter}}" />
                                            <Run Text="{loc:Localize TTP_FILTERBAND_FILTER_BY_DATE_TOGGLED_ТО}" />
                                            <Run FontWeight="Bold" Text="{Binding EndDateMs, Converter={StaticResource MillisecondsToHumanReadableDateStringConverter}}" />
                                        </TextBlock>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style
                        x:Key="myMachineToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource MyMachineItemsIcon}" />
                        <Setter Property="ToolTip" Value="{loc:Localize TTP_FILTERBAND_FILTER_BY_DEVICE_CURRENT}" />
                    </Style>

                    <Style
                        x:Key="remoteDeviceToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource AllMachinesItemsIcon}" />
                        <Setter Property="ToolTip" Value="{loc:Localize TTP_FILTERBAND_FILTER_BY_DEVICE_REMOTE}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RemoteMachineSourceToggled}" Value="True">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <TextBlock TextWrapping="Wrap">
                                            <!--  WARNING: do not put these runs on a new line each, as this will add a space between each run  -->
                                            <Run Text="{loc:Localize TTP_FILTERBAND_FILTER_BY_DEVICE_REMOTE_TOGGLED_PREFIX}" /><Run Text="&#x0a;" /><Run FontWeight="Bold" Text="{Binding SelectedMachinesString}" />
                                        </TextBlock>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button
            Name="scrollBtnUp"
            Grid.Row="0"
            Height="10"
            VerticalAlignment="Center"
            Style="{DynamicResource BtnArrowUp}" />
        <Button
            Name="scrollBtnDown"
            Grid.Row="2"
            Height="10"
            VerticalAlignment="Center"
            Style="{DynamicResource BtnArrowDown}" />
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">
            <i:Interaction.Behaviors>
                <localBeh:ScrollViewerScrollButtonsBehavior ButtonScrollDirection="Up" ScrollButton="{Binding ElementName=scrollBtnUp}" />
                <localBeh:ScrollViewerScrollButtonsBehavior ButtonScrollDirection="Down" ScrollButton="{Binding ElementName=scrollBtnDown}" />
            </i:Interaction.Behaviors>
            <StackPanel
                x:Name="scrollableContent"
                HorizontalAlignment="Stretch"
                Orientation="Vertical">

                <Expander
                    x:Name="TypeExpander"
                    Margin="1,0,1,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Collapsed="TypeExpander_Collapsed"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Header="{DynamicResource CategoriesIcon}"
                    OverridesDefaultStyle="True"
                    Tag="{DynamicResource CategoriesIcon}"
                    Template="{StaticResource VerticalStretchyExpander}"
                    ToolTip="{loc:Localize TTP_FILTERBAND_FILTER_BY_TYPE}">

                    <StackPanel
                        Margin="0,5"
                        Orientation="Vertical"
                        SnapsToDevicePixels="True">
                        <ToggleButton
                            Margin="3"
                            IsChecked="{Binding TextTypeSelected}"
                            Style="{StaticResource textToggleButton}" />
                        <ToggleButton
                            Margin="3"
                            IsChecked="{Binding ImageTypeSelected}"
                            Style="{StaticResource imageToggleButton}" />
                        <ToggleButton
                            Margin="3"
                            IsChecked="{Binding FileTypeSelected}"
                            Style="{StaticResource fileToggleButton}" />
                        <ToggleButton
                            Margin="3"
                            IsChecked="{Binding GeneralTypeSelected}"
                            Style="{StaticResource generalToggleButton}" />
                    </StackPanel>

                </Expander>

                <Expander
                    x:Name="SourceMachineExpander"
                    Margin="1,10,1,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Collapsed="SourceMachineExpander_Collapsed"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Header="{DynamicResource SyncedItemsIcon}"
                    OverridesDefaultStyle="True"
                    Tag="{DynamicResource SyncedItemsIcon}"
                    Template="{StaticResource VerticalStretchyExpander}"
                    ToolTip="{loc:Localize TTP_FILTERBAND_FILTER_BY_DEVICE}"
                    Visibility="{Binding IsCloudSyncServiceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel
                        Margin="0,5"
                        Orientation="Vertical"
                        SnapsToDevicePixels="True">
                        <ToggleButton
                            Margin="3"
                            IsChecked="{Binding LocalMachineSourceToggled}"
                            Style="{StaticResource myMachineToggleButton}" />
                        <ToggleButton
                            Margin="3"
                            IsChecked="{Binding RemoteMachineSourceToggled}"
                            PreviewMouseDown="ToggleRemoteDeviceSelectionButton_PreviewMouseDown"
                            Style="{StaticResource remoteDeviceToggleButton}" />
                    </StackPanel>

                </Expander>

                <ToggleButton
                    Margin="4,10"
                    IsChecked="{Binding AppSelectorToggled}"
                    PreviewMouseDown="ToggleApplicationSelectionButton_PreviewMouseDown"
                    Style="{StaticResource applicationSelectionToggleButton}" />
                <ToggleButton
                    Margin="4,10"
                    IsChecked="{Binding DateRangeToggled}"
                    PreviewMouseDown="ToggleDateRangeSelectionButton_PreviewMouseDown"
                    Style="{StaticResource dateRangeSelectionToggleButton}" />

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
