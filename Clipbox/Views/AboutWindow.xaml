<customControls:WindowFrame
    x:Class="Clipbox.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Clipbox.Core;assembly=Clipbox.Core"
    xmlns:coreExtEnums="clr-namespace:Clipbox.Core.Extensibility.Enums;assembly=Clipbox.Core"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:localDialog="clr-namespace:Clipbox.Views.Dialog"
    xmlns:localWindows="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sysTheme="clr-namespace:Clipbox.Infrastructure.UI.Theme;assembly=Clipbox.Infrastructure.UI"
    Title="{loc:Localize LBL_ABOUT_WINDOW_TITLE}"
    Width="Auto"
    Height="Auto"
    MinWidth="650"
    MinHeight="360"
    AllowsTransparency="True"
    Background="{DynamicResource TaskbarColorBrush}"
    BorderBrush="#3a3a3a"
    BorderThickness="0"
    CaptionBackground="Transparent"
    CaptionForeground="{DynamicResource ControlForegroundBrush}"
    CloseBtnToolTip="{loc:Localize TLP_WINDOW_CLOSE,
                                   ResourceLookupMode=CurrentAssembly}"
    FontSize="16"
    Foreground="{DynamicResource ControlForegroundBrush}"
    Icon="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Images/Clip-WF.ico"
    IsMinimizeButtonVisible="False"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>

    </Window.Resources>
    <customControls:WindowFrame.CaptionIconControl>
        <ContentControl Template="{StaticResource ApplicationIcon}" />
    </customControls:WindowFrame.CaptionIconControl>
    <Grid
        x:Name="mainGrid"
        Margin="50"
        HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl
                Grid.Row="0"
                Width="85"
                Height="85"
                Foreground="#f0f0f0"
                Template="{StaticResource LogoIcon}" />
            <TextBlock
                Grid.Row="1"
                Margin="10"
                HorizontalAlignment="Center"
                FontSize="34"
                Foreground="#f0f0f0"
                Text="{x:Static core:ProductConstants.PRODUCT_NAME}" />
            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="14"
                Foreground="LightGray"
                Text="{Binding VersionString}" />

            <TextBlock
                Grid.Row="3"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="14"
                Foreground="LightGray">
                <Run Text="©" />
                <Run Text="{x:Static core:ProductConstants.COMPANY_NAME}" />
            </TextBlock>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button
                Grid.Row="0"
                Grid.Column="1"
                Width="160"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                BorderBrush="Gray"
                BorderThickness="1"
                Style="{StaticResource IconButton}">
                <TextBlock
                    FontSize="16"
                    Foreground="LightBlue"
                    Text="Online Help"
                    TextAlignment="Center" />
            </Button>

            <Button
                Grid.Row="1"
                Grid.Column="1"
                Width="160"
                Height="30"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                BorderBrush="Gray"
                BorderThickness="1"
                Style="{StaticResource IconButton}">
                <TextBlock
                    FontSize="16"
                    Foreground="LightBlue"
                    Text="Give Feedback"
                    TextAlignment="Center" />
            </Button>

            <Button
                Grid.Row="2"
                Grid.Column="1"
                Width="160"
                Height="30"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                BorderBrush="Gray"
                BorderThickness="1"
                Style="{StaticResource IconButton}">
                <TextBlock
                    FontSize="16"
                    Foreground="LightBlue"
                    Text="Report a Problem"
                    TextAlignment="Center" />
            </Button>

            <TextBlock
                Grid.Row="3"
                Grid.Column="1"
                Margin="0,30,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Cursor="Hand"
                FontSize="16"
                Foreground="LightBlue"
                Text="License Agreement" />

            <TextBlock
                Grid.Row="4"
                Grid.Column="1"
                Margin="0,5,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Cursor="Hand"
                FontSize="16"
                Foreground="LightBlue"
                Text="Privacy Policy" />
        </Grid>
    </Grid>
</customControls:WindowFrame>
