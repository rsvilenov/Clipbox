<infWnd:AcryllicWindow
    x:Class="Clipbox.Views.PopupBaloon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Clipbox.Core;assembly=Clipbox.Core"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infWnd="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="350"
    d:DesignWidth="600"
    Background="{DynamicResource TaskbarColorBrush}"
    ResizeMode="NoResize"
    ScaleMode="Custom"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Window.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="15,5,0,0"
            HorizontalAlignment="Left"
            FontSize="16"
            Foreground="#f0f0f0"
            Text="{x:Static core:ProductConstants.PRODUCT_NAME}" />

        <Button
            Grid.Row="0"
            Grid.Column="2"
            MaxWidth="30"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Command="{Binding CloseCommand}"
            Style="{StaticResource BtnWindowClose}" />

        <ContentControl
            Grid.Row="1"
            Grid.Column="0"
            Width="65"
            Height="65"
            Margin="50"
            Foreground="#f0f0f0"
            Template="{StaticResource LogoIcon}" />

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,0,20,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.ColumnSpan="2"
                FontSize="18"
                Foreground="#f0f0f0"
                Text="{Binding Text}"
                TextAlignment="Justify"
                TextWrapping="Wrap" />

            <Button
                Grid.Row="1"
                Grid.Column="0"
                MinWidth="120"
                Margin="0,30,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="Gray"
                Command="{Binding CustomActionCommand}"
                FontSize="16"
                Foreground="White">
                <TextBlock
                    Margin="10,5,10,5"
                    HorizontalAlignment="Center"
                    Text="{Binding CustomActionButtonText}" />
                <Button.Style>
                    <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CustomActionButtonText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CustomActionButtonText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button
                Grid.Row="1"
                Grid.Column="1"
                MinWidth="120"
                Margin="0,30,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="Gray"
                Command="{Binding CloseCommand}"
                FontSize="16"
                Foreground="White">
                <TextBlock
                    Margin="10,5,10,5"
                    HorizontalAlignment="Center"
                    Text="{Binding CustomActionDismissButtonText}" />
                <Button.Style>
                    <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CustomActionDismissButtonText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CustomActionDismissButtonText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Button
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,0,20,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            BorderBrush="Gray"
            Command="{Binding CloseCommand}"
            FontSize="16"
            Foreground="White">
            <TextBlock Margin="10,5,10,5" Text="{loc:Localize BTN_BALOON_GOT_IT}" />
            <Button.Style>
                <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CustomActionButtonText}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CustomActionButtonText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

    </Grid>
</infWnd:AcryllicWindow>
