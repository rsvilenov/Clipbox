<UserControl
    x:Class="Clipbox.Views.RangeSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="repeatButton" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!--  draw a rectangle with a thin line crossing it. The line takes the accent color.  -->
                        <Border
                            x:Name="repeatButtonBorder"
                            Height="9"
                            Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource TaskbarColorBrush}"
                            BorderThickness="4"
                            SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="repeatButtonBorder" Property="Background" Value="{DynamicResource AccentLight3Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="thumbTemplate" TargetType="Thumb">
            <Ellipse
                Name="thumbEllipse"
                Width="18"
                Height="18"
                SnapsToDevicePixels="True"
                StrokeThickness="2">
                <Ellipse.Style>
                    <Style TargetType="{x:Type Ellipse}">
                        <Setter Property="Fill" Value="{DynamicResource TaskbarColorBrush}" />
                        <Setter Property="Stroke" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Stroke" Value="Gray" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="20"
                                            ShadowDepth="0"
                                            Color="{Binding ElementName=thumbEllipse, Path=Stroke.Color}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <ControlTemplate.Triggers>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="thumbEllipse" Property="Fill" Value="White" />
                    <Setter TargetName="thumbEllipse" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect
                                BlurRadius="20"
                                ShadowDepth="0"
                                Color="{Binding ElementName=thumbEllipse, Path=Stroke.Color}" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="rightSlider" TargetType="{x:Type Slider}">
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="true">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Rectangle x:Name="PART_SelectionRange" />

                    <Track x:Name="PART_Track" Grid.Row="1">
                        <Track.Thumb>
                            <Thumb x:Name="Thumb" Template="{StaticResource thumbTemplate}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource repeatButton}" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="leftSlider" TargetType="{x:Type Slider}">
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="true">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Rectangle x:Name="PART_SelectionRange" />

                    <Track x:Name="PART_Track" Grid.Row="1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource repeatButton}" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb x:Name="Thumb" Template="{StaticResource thumbTemplate}" />
                        </Track.Thumb>
                    </Track>
                </Grid>
            </Border>
        </ControlTemplate>

    </UserControl.Resources>
    <Grid x:Name="mainGrid" VerticalAlignment="Top">
        <Border
            Height="3"
            Margin="5,0,5,0"
            VerticalAlignment="Center"
            BorderThickness="0,3,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="White" />
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="BorderBrush" Value="LightGray" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Slider
            x:Name="LowerSlider"
            Margin="0,0,18,0"
            IsSnapToTickEnabled="True"
            Maximum="{Binding Path=Maximum}"
            Minimum="{Binding Path=Minimum}"
            Template="{StaticResource leftSlider}"
            Ticks="{Binding Path=SliderTicks}"
            Value="{Binding Path=LowerValue, Mode=TwoWay}" />

        <Slider
            x:Name="UpperSlider"
            Margin="18,0,0,0"
            IsSnapToTickEnabled="True"
            Maximum="{Binding Path=Maximum}"
            Minimum="{Binding Path=Minimum}"
            Template="{StaticResource rightSlider}"
            Ticks="{Binding Path=SliderTicks}"
            Value="{Binding Path=UpperValue, Mode=TwoWay}" />
    </Grid>
</UserControl>
