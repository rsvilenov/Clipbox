<UserControl
    x:Class="Clipbox.Views.ExpandableSearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Styles/ToggleButtonBaseStyle.xaml" />
                <ResourceDictionary>
                    <Style
                        x:Key="searchToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource SearchIcon}" />
                        <Setter Property="ToolTip" Value="Search" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Expander
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Foreground="{DynamicResource ControlForegroundBrush}"
        Header="{DynamicResource SearchIcon}"
        OverridesDefaultStyle="True"
        Tag="{DynamicResource CategoriesIcon}"
        Template="{StaticResource HorizontalLeftStretchyExpander}">
        <Expander.CacheMode>
            <BitmapCache />
        </Expander.CacheMode>
        <TextBox
            Width="200"
            Margin="5"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="White"
            Foreground="Black"
            FontSize="16"
            Text="Type here to search" />

    </Expander>
</UserControl>
