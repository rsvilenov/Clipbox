<UserControl
    x:Class="Clipbox.Views.ExpandableSearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Styles/ToggleButtonBaseStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Expander.xaml" />
                <ResourceDictionary>
                    <Style
                        x:Key="searchToggleButton"
                        BasedOn="{StaticResource tglButton}"
                        TargetType="{x:Type ToggleButton}">
                        <Setter Property="Content" Value="{DynamicResource SearchIcon}" />
                        <Setter Property="ToolTip" Value="{loc:Localize TTP_EXPANDABLESEARCH_BTN}" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Expander
        x:Name="Expander"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Collapsed="Expander_Collapsed"
        Expanded="Expander_Expanded"
        Foreground="{DynamicResource ControlForegroundBrush}"
        Header="{DynamicResource SearchIcon}"
        OverridesDefaultStyle="True"
        Tag="{DynamicResource CategoriesIcon}"
        Template="{StaticResource HorizontalLeftStretchyExpander}">
        <customControls:SearchTextBox
            x:Name="searchTextBox"
            Width="{Binding TextBoxExpandedWidth}"
            Margin="5"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            OverlayText="{loc:Localize TTP_EXPANDABLESEARCH_OVERLAYTEXT}"
            SearchRequested="SearchTextBox_SearchRequested" />
    </Expander>
</UserControl>
