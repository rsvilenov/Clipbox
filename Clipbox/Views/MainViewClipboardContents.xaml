<local:ClipboardViewControlBase
    x:Class="Clipbox.Views.MainViewClipboardContents"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:coreConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:tile="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Styles/Style.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Views/Styles/ToggleButtonBaseStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BitmapToBitmapImageConverter x:Key="BitmapToBitmapImageConverter" />
            <conv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <coreConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <coreConv:OrMultiValueConverter x:Key="OrMultiValueConverter" />
            <coreConv:AndMultiValueConverter x:Key="AndMultiValueConverter" />
            <coreConv:MathAddConverter x:Key="MathAddConverter" />
            <coreConv:IsEqualOrGreaterThanConverter x:Key="IsEqualOrGreaterThanConverter" />
            <coreConv:NullOrEmptyCollectionToBoolConverter x:Key="NullOrEmptyCollectionToBoolConverter" />
            <conv:ContentClassListContainsConverter x:Key="ContentClassListContainsConverter" />

            <Style x:Key="MultiItemStyleForSubItems_EventTriggersStyle" TargetType="{x:Type tile:MultiItem}">
                <EventSetter Event="SubItems_SelectionChanged" Handler="MultiItem_SubItems_SelectionChanged" />
                <EventSetter Event="SubItems_SubItemsFocusMovedOut" Handler="MultiItem_SubItems_SubItemsFocusMovedOut" />
                <EventSetter Event="Unloaded" Handler="MultiItem_Unloaded" />
                <EventSetter Event="Loaded" Handler="MultiItem_Loaded" />
            </Style>

            <Style
                x:Key="keepGeneratedItemToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{DynamicResource SaveIcon}" />
                <Setter Property="ToolTip" Value="Save the combined/modified item" />
                <Setter Property="Padding" Value="5" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Storyboard x:Key="FadeInItem">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:2.0" />
            </Storyboard>
        </Grid.Resources>

        <Border Grid.Row="0">
            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="{DynamicResource TaskbarColor}" />
            </Border.Background>

            <Grid Margin="10,15,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Height="35"
                    Orientation="Horizontal">
                    <i:Interaction.Behaviors>
                        <infBeh:FrameworkElementDpiScalingBehavior />
                    </i:Interaction.Behaviors>
                    <WrapPanel
                        x:Name="uiExtentionContainer"
                        VerticalAlignment="Center"
                        Panel.ZIndex="99"
                        Visibility="{Binding Path=AreAnyUIExtensionsLoaded, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Panel.ZIndex="100"
                        Background="Transparent"
                        FontSize="16"
                        Foreground="White"
                        IsEnabled="{Binding Path=AreSelectedItemsCombinable, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}, Converter={StaticResource InverseBooleanConverter}}"
                        Text="Incompatible items."
                        Visibility="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!--  vertical separator  -->
                    <Rectangle
                        Width="1"
                        Margin="10,5,10,5"
                        VerticalAlignment="Stretch"
                        Stroke="DarkGray"
                        Visibility="{Binding ElementName=uiExtentionContainer, Path=Visibility}" />
                </StackPanel>


                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <i:Interaction.Behaviors>
                        <infBeh:FrameworkElementDpiScalingBehavior />
                    </i:Interaction.Behaviors>
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Path=AreAnyItemsSelected, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}}" Value="True" />
                                        <Condition Binding="{Binding Path=AreSelectedItemsCombinable, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ToggleButton
                        x:Name="keepGeneratedItemsCb"
                        Width="32"
                        Height="32"
                        Style="{StaticResource keepGeneratedItemToggleButton}"
                        Visibility="{Binding Path=AreAnyUIExtensionsLoaded, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!--  vertical separator  -->
                    <Rectangle
                        Width="1"
                        Margin="10,5,10,5"
                        VerticalAlignment="Stretch"
                        Stroke="DarkGray"
                        Visibility="{Binding ElementName=keepGeneratedItemsCb, Path=Visibility}" />

                    <Button
                        x:Name="setToClipboardBtn"
                        Height="32"
                        VerticalAlignment="Top"
                        Click="SetToClipboardButton_Click"
                        Style="{DynamicResource SetToClipboardButton}" />

                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Visibility="{Binding Path=AreAnyItemsSelected, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <i:Interaction.Behaviors>
                        <infBeh:FrameworkElementDpiScalingBehavior />
                    </i:Interaction.Behaviors>

                    <Rectangle
                        Width="1"
                        Margin="10,5,10,5"
                        VerticalAlignment="Stretch"
                        Stroke="DarkGray"
                        Visibility="{Binding ElementName=keepGenersetToClipboardBtnatedItemsCb, Path=Visibility}" />

                    <Button
                        Height="32"
                        VerticalAlignment="Top"
                        Click="SetToClipboardButton_Click"
                        Style="{DynamicResource BtnTrash}" />
                </StackPanel>

            </Grid>
        </Border>

        <!--
            This listview should scroll its contents by physical units instead of logical ones,
            thus ScrollViewer.CanContentScroll="False". Otherwise, when grouping is used,
            the scrollviewer jumps awkwardly to the next group...
        -->
        <!--  We load this view hidden, so that it can group its items before we show it; Then we show it from GroupItem's template Loaded event.  -->
        <ListView
            Name="MainListView"
            Grid.Row="1"
            Margin="10"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Top"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding ClipboardViewItemWrappers}"
            ScrollViewer.CanContentScroll="False"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            Visibility="Hidden">
            <i:Interaction.Behaviors>
                <localBeh:ListViewGroupingBehavior GroupByPropertyName="DateCreatedFriendly" />
            </i:Interaction.Behaviors>
            <ListView.Resources>
                <ControlTemplate x:Key="MinimalisticScrollViewerControlTemplate" TargetType="{x:Type ScrollViewer}">
                    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollContentPresenter
                            x:Name="PART_ScrollContentPresenter"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Stretch"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            CanHorizontallyScroll="False"
                            CanVerticallyScroll="False"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!--
                            Left margin was added here to
                            compensate for the negative margin of the
                            textblock inside the VerticalScrollBarEx
                        -->
                        <local:VerticalScrollBarEx
                            x:Name="PART_VerticalScrollBar"
                            Grid.Column="1"
                            Margin="50,0,0,0"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="VerticalScrollBar"
                            BottomLabelText="{Binding Path=DataContext.LastItemDateString, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListView}}"
                            Cursor="Arrow"
                            FloatingLabelText="{Binding Path=DataContext.CurrentVisibleItemsDateString, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListView}}"
                            FontSize="14"
                            Foreground="White"
                            Loaded="PART_VerticalScrollBar_Loaded"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0"
                            TopLabelText="{Binding Path=DataContext.FirstItemDateString, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListView}}"
                            ValueChanged="PART_VerticalScrollBar_ValueChanged"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />

                    </Grid>
                </ControlTemplate>
            </ListView.Resources>
            <ListView.Style>
                <Style TargetType="{x:Type ListView}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                    <Setter Property="ScrollViewer.PanningMode" Value="Both" />
                    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBox}">
                                <Grid>
                                    <Border
                                        x:Name="Bd"
                                        Padding="1"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        SnapsToDevicePixels="True">
                                        <ScrollViewer
                                            Padding="{TemplateBinding Padding}"
                                            Focusable="False"
                                            HorizontalScrollBarVisibility="Disabled"
                                            Template="{DynamicResource MinimalisticScrollViewerControlTemplate}"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Style>

            <!--  Remove the default highlighting on mouse over  -->
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border
                                    x:Name="Bd"
                                    MinWidth="100"
                                    MinHeight="80"
                                    Margin="5"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">

                                    <ContentPresenter
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                                    </MultiTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLight3Brush}" />
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <StackPanel Loaded="StackPanel_Loaded" Orientation="Vertical">
                                            <TextBlock
                                                VerticalAlignment="Bottom"
                                                FontSize="22"
                                                FontWeight="Bold"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="{Binding Name}" />
                                            <!--  Add some space to the top and the bottom of each group  -->
                                            <ItemsPresenter Margin="0,10,0,50" />
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ContentControl HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <i:Interaction.Behaviors>
                            <localBeh:ListViewItemUnselectOnClickBehavior />
                        </i:Interaction.Behaviors>

                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="False" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:SingleItemLoading ViewItemDimensions="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.Dimensions[0]}" />
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="False" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:SingleItem ClipboardViewItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.ViewItem}" ThumbnailAreaMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}}" />
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="True" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:MultiItem ClipboardViewItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.ViewItem}" Style="{StaticResource MultiItemStyleForSubItems_EventTriggersStyle}">
                                                            <tile:MultiItem.Height>
                                                                <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                    <Binding Path="ClipboardViewItemMaxHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}" />
                                                                    <Binding>
                                                                        <Binding.Source>
                                                                            <!--  pad the height so that it matches the total height of the single view items  -->
                                                                            <sys:Double>60</sys:Double>
                                                                        </Binding.Source>
                                                                    </Binding>
                                                                </MultiBinding>
                                                            </tile:MultiItem.Height>
                                                        </tile:MultiItem>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="True" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:MultiItemLoading NumberOfItemsWithoutPreview="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.NumberOfItemsWithoutPreview}" ViewSubItemDimensions="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.Dimensions, Mode=OneWay}">
                                                            <tile:MultiItemLoading.Height>
                                                                <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                    <Binding Path="ClipboardViewItemMaxHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}" />
                                                                    <Binding>
                                                                        <Binding.Source>
                                                                            <!--  pad the height so that it matches the total height of the single view items  -->
                                                                            <sys:Double>60</sys:Double>
                                                                        </Binding.Source>
                                                                    </Binding>
                                                                </MultiBinding>
                                                            </tile:MultiItemLoading.Height>
                                                        </tile:MultiItemLoading>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>

                    </ContentControl>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</local:ClipboardViewControlBase>
