<views:ClipboardViewControlBase
    x:Class="Clipbox.Views.MainViewClipboardContents"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filterBand="clr-namespace:Clipbox.Views.FilterBand"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:localDialog="clr-namespace:Clipbox.Views.Dialog"
    xmlns:lv="clr-namespace:Clipbox.Views.ClipboardListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Clipbox.Views"
    xmlns:vis="clr-namespace:Clipbox.Infrastructure.UI.Visuals;assembly=Clipbox.Infrastructure.UI"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Views/Styles/ToggleButtonBaseStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infConv:BooleanToVisibilityHiddenConverter x:Key="BooleanToVisibilityHiddenConverter" />
            <conv:ObjectTypeCompareConverter x:Key="ObjectTypeCompareConverter" />
            <conv:BitmapToBitmapImageConverter x:Key="BitmapToBitmapImageConverter" />
            <conv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <infConv:OrMultiValueConverter x:Key="OrMultiValueConverter" />
            <infConv:AndMultiValueConverter x:Key="AndMultiValueConverter" />
            <infConv:MathAddConverter x:Key="MathAddConverter" />
            <infConv:IsEqualOrGreaterThanConverter x:Key="IsEqualOrGreaterThanConverter" />
            <infConv:NullOrEmptyCollectionToBoolConverter x:Key="NullOrEmptyCollectionToBoolConverter" />
            <conv:ContentClassListContainsConverter x:Key="ContentClassListContainsConverter" />

            <Style
                x:Key="keepGeneratedItemToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{DynamicResource SaveIcon}" />
                <Setter Property="ToolTip" Value="Save the combined/modified item" />
                <Setter Property="Padding" Value="5" />
            </Style>

            <CollectionViewSource
                x:Key="ListViewSource"
                IsLiveGroupingRequested="False"
                Source="{Binding ClipboardViewItemWrappers, Mode=OneWay}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="DateCreatedFriendly" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <!--  top bar  -->
            <RowDefinition Height="Auto" />
            <!--  list view  -->
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!--  side bar  -->
            <ColumnDefinition Width="Auto" />
            <!--  list view  -->
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <Storyboard x:Key="FadeInItem">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:0.7" />
            </Storyboard>
        </Grid.Resources>

        <!--  dark overlay, indicating disabled state (used for highlighting popups)  -->
        <Border
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Panel.ZIndex="100">
            <Border.Background>
                <SolidColorBrush Opacity="0.4" Color="Black" />
            </Border.Background>
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:ClipboardViewControlBase}}}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!--  top bar  -->
        <Border
            x:Name="TopBarGrid"
            Grid.Row="0"
            Grid.Column="1"
            Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                                <Condition Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FadeInItemTopBar" Storyboard="{StaticResource FadeInItem}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FadeInItemTopBar" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="{DynamicResource TaskbarColor}" />
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!--  toolbox column;  this column should be resized according to the search column's current size  -->
                    <ColumnDefinition Width="*" />
                    <!--  search column; this column changes its size on runtime due to the expander inside  -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <!--  left scroll button  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  content  -->
                        <ColumnDefinition />
                        <!--  right scroll button  -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Name="scrollBtnLeft"
                        Grid.Column="0"
                        Width="12"
                        HorizontalAlignment="Center"
                        Style="{DynamicResource BtnArrowLeft}" />
                    <Button
                        Name="scrollBtnRight"
                        Grid.Column="2"
                        Width="12"
                        HorizontalAlignment="Center"
                        Style="{DynamicResource BtnArrowRight}" />
                    <ScrollViewer
                        Grid.Column="1"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
                        <i:Interaction.Behaviors>
                            <localBeh:ScrollViewerScrollButtonsBehavior ButtonScrollDirection="Left" ScrollButton="{Binding ElementName=scrollBtnLeft}" />
                            <localBeh:ScrollViewerScrollButtonsBehavior ButtonScrollDirection="Right" ScrollButton="{Binding ElementName=scrollBtnRight}" />
                        </i:Interaction.Behaviors>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                Height="35"
                                Orientation="Horizontal">
                                <i:Interaction.Behaviors>
                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                </i:Interaction.Behaviors>
                                <WrapPanel
                                    x:Name="uiExtentionContainer"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="99"
                                    Visibility="{Binding Path=AreAnyUIExtensionsLoaded, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="100"
                                    Background="Transparent"
                                    FontSize="16"
                                    Foreground="White"
                                    IsEnabled="{Binding Path=AreSelectedItemsCombinable, ElementName=MainListView, Converter={StaticResource InverseBooleanConverter}}"
                                    Text="Incompatible items."
                                    Visibility="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!--  vertical separator  -->
                                <Rectangle
                                    Width="1"
                                    Margin="10,5,10,5"
                                    VerticalAlignment="Stretch"
                                    Stroke="DarkGray"
                                    Visibility="{Binding ElementName=uiExtentionContainer, Path=Visibility}" />
                            </StackPanel>


                            <StackPanel
                                Grid.Column="1"
                                Height="35"
                                Orientation="Horizontal">
                                <i:Interaction.Behaviors>
                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                </i:Interaction.Behaviors>
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=AreAnyItemsSelected, ElementName=MainListView}" Value="True" />
                                                    <Condition Binding="{Binding Path=AreSelectedItemsCombinable, ElementName=MainListView}" Value="True" />
                                                    <Condition Binding="{Binding Path=IsShowingOfPostSelectionToolboxEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ToggleButton
                                    x:Name="keepGeneratedItemsCb"
                                    Width="32"
                                    Height="32"
                                    Style="{StaticResource keepGeneratedItemToggleButton}"
                                    Visibility="{Binding Path=AreAnyUIExtensionsLoaded, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!--  vertical separator  -->
                                <Rectangle
                                    Width="1"
                                    Margin="10,5,10,5"
                                    VerticalAlignment="Stretch"
                                    Stroke="DarkGray"
                                    Visibility="{Binding ElementName=keepGeneratedItemsCb, Path=Visibility}" />

                                <Button
                                    x:Name="setToClipboardBtn"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    Click="SetToClipboardButton_Click"
                                    Style="{DynamicResource SetToClipboardButton}" />

                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Height="35"
                                Orientation="Horizontal">

                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=AreAnyItemsSelected, ElementName=MainListView}" Value="True" />
                                                    <Condition Binding="{Binding Path=AreAnySubItemsSelected, ElementName=MainListView}" Value="False" />
                                                    <Condition Binding="{Binding Path=IsShowingOfPostSelectionToolboxEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <i:Interaction.Behaviors>
                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                </i:Interaction.Behaviors>

                                <Rectangle
                                    Width="1"
                                    Margin="10,5,10,5"
                                    VerticalAlignment="Stretch"
                                    Stroke="DarkGray"
                                    Visibility="{Binding ElementName=keepGenersetToClipboardBtnatedItemsCb, Path=Visibility}" />

                                <Button
                                    x:Name="trashBtn"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    Click="TrashBtn_Click"
                                    Style="{DynamicResource BtnTrash}" />

                                <localDialog:DialogPopup
                                    x:Name="deleteConfirmationPopup"
                                    MaxWidth="350"
                                    DefaultButton="No"
                                    DialogAnswered="DeleteConfirmationPopup_DialogAnswered"
                                    DialogText="Are you sure you want to delete the selected item(s)?"
                                    DialogueType="YesNo"
                                    IsOpen="False"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=trashBtn}"
                                    ReturnFocusTo="{Binding ElementName=MainListView}" />

                                <localDialog:DialogPopup
                                    x:Name="deleteSingleItemConfirmationPopup"
                                    MaxWidth="350"
                                    DefaultButton="No"
                                    DialogText="Are you sure you want to delete this item?"
                                    DialogueType="YesNo"
                                    IsOpen="False"
                                    Placement="Bottom"
                                    ReturnFocusTo="{Binding ElementName=MainListView}" />
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>


                <views:ExpandableSearchBox
                    x:Name="searchTextBox"
                    Grid.Column="1"
                    Height="45"
                    Margin="5"
                    HorizontalAlignment="Right"
                    SearchRequested="ExpandableSearchBox_SearchRequested">
                    <i:Interaction.Behaviors>
                        <infBeh:FrameworkElementDpiScalingBehavior />
                    </i:Interaction.Behaviors>
                </views:ExpandableSearchBox>
            </Grid>
        </Border>

        <!--  side bar  -->
        <Grid
            x:Name="SideBarGrid"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Visibility="Collapsed">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                                <Condition Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FadeInItemSideBar" Storyboard="{StaticResource FadeInItem}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FadeInItemSideBar" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.Background>
                <SolidColorBrush Opacity="0.6" Color="{DynamicResource TaskbarColor}" />
            </Grid.Background>
            <i:Interaction.Behaviors>
                <infBeh:FrameworkElementDpiScalingBehavior />
            </i:Interaction.Behaviors>

            <filterBand:FilterBand
                x:Name="filterBand"
                Grid.Row="0"
                ClipboardItemsDataProvider="{Binding ClipboardItemsDataProvider}"
                SearchTermsChanged="FilterBand_SearchTermsChanged"
                ShouldParentBeEnabled="{Binding Path=IsEnabled, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:ClipboardViewControlBase}}}" />

            <Button
                Grid.Row="1"
                VerticalAlignment="Bottom"
                VerticalContentAlignment="Center"
                BorderBrush="Transparent"
                Click="SettingsButton_Click">
                <ContentControl Margin="15" Template="{DynamicResource SettingsIcon}" />
            </Button>

        </Grid>


        <!--
            This listview should scroll its contents by physical units instead of logical ones,
            thus ScrollViewer.CanContentScroll="False". Otherwise, when grouping is used,
            the scrollviewer jumps awkwardly to the next group...
        -->
        <!--  We load this view hidden, so that it can group its items before we show it; Then we show it from GroupItem's template Loaded event.  -->
        <Grid
            x:Name="MainListViewContainer"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="Hidden">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                                <Condition Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FadeInItemListView" Storyboard="{StaticResource FadeInItem}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FadeInItemListView" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!--  label "No contents"  -->
            <Label
                Grid.Row="0"
                Width="250"
                Height="100"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                Content="No items to show."
                FontSize="16"
                FontWeight="Bold"
                Foreground="White">
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ClipboardViewItemWrappers.Count}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger.Setters>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>

            <!--  main list view  -->
            <lv:FullClipboardListView
                x:Name="MainListView"
                Margin="10"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                ClipboardItemContentControl_MouseDoubleClickDetectionStarted="MainListView_ClipboardItemContentControl_MouseDoubleClickDetectionStarted"
                ClipboardItemContentControl_MouseDoubleClickDetection_DoubleClickDetected="MainListView_ClipboardItemContentControl_MouseDoubleClickDetection_DoubleClickDetected"
                ClipboardItemContentControl_MouseDoubleClickDetection_SingleClickDetected="MainListView_ClipboardItemContentControl_MouseDoubleClickDetection_SingleClickDetected"
                ClipboardItemsPanel_KeyUp="MainListView_ClipboardItemsPanel_KeyUp"
                ClipboardViewItemMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}}"
                CombinabilityCheckRequested="MainListView_CombinabilityCheckRequested"
                GroupingComplete="MainListView_GroupingComplete"
                IsCloudSyncAvailable="{Binding IsCloudSyncAvailable, Mode=OneWay}"
                IsFadeInOfItemsEnabled="{Binding AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}"
                IsInnerGroupingEnabled="False"
                ItemDeletionRequested="MainListView_ItemDeletionRequested"
                ItemEnableDisableSyncRequested="MainListView_ItemEnableDisableSyncRequested"
                ItemPinUnpinRequested="MainListView_ItemPinUnpinRequested"
                ItemsSource="{Binding Source={StaticResource ListViewSource}}"
                LoadMoreItemsRequested="MainListView_LoadMoreItemsRequested"
                NumOfNotYetVisibleRowsToPreload="{Binding Path=NumOfNotYetVisibleRowsToPreload, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}}"
                SelectionChangeCompleted="MainListView_SelectionChangeCompleted"
                TotalItemsCountToLoad="{Binding TotalItemsCountToLoad, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}"
                ViewItemLoadingCancelRequested="MainListView_ViewItemLoadingCancelRequested"
                ViewItemLoadingRequested="MainListView_ViewItemLoadingRequested"
                ViewItemUnloadingRequested="MainListView_ViewItemUnloadingRequested" />
        </Grid>
    </Grid>
</views:ClipboardViewControlBase>
