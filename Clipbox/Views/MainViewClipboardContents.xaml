<views:ClipboardViewControlBase
    x:Class="Clipbox.Views.MainViewClipboardContents"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filterBand="clr-namespace:Clipbox.Views.FilterBand"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:localDialog="clr-namespace:Clipbox.Views.Dialog"
    xmlns:lv="clr-namespace:Clipbox.Views.ClipboardListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Clipbox.Views"
    xmlns:vis="clr-namespace:Clipbox.Infrastructure.UI.Visuals;assembly=Clipbox.Infrastructure.UI"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Views/Styles/ToggleButtonBaseStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infConv:BooleanToVisibilityHiddenConverter x:Key="BooleanToVisibilityHiddenConverter" />
            <conv:ObjectTypeCompareConverter x:Key="ObjectTypeCompareConverter" />
            <conv:BitmapToBitmapImageConverter x:Key="BitmapToBitmapImageConverter" />
            <conv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <infConv:OrMultiValueConverter x:Key="OrMultiValueConverter" />
            <infConv:AndMultiValueConverter x:Key="AndMultiValueConverter" />
            <infConv:MathAddConverter x:Key="MathAddConverter" />
            <infConv:IsEqualOrGreaterThanConverter x:Key="IsEqualOrGreaterThanConverter" />
            <infConv:NullOrEmptyCollectionToBoolConverter x:Key="NullOrEmptyCollectionToBoolConverter" />
            <conv:ContentClassListContainsConverter x:Key="ContentClassListContainsConverter" />
            <conv:DateTimeToHumanReadableDateString x:Key="DateTimeToHumanReadableDateString" />

            <Style
                x:Key="keepGeneratedItemToggleButton"
                BasedOn="{StaticResource tglButton}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Content" Value="{StaticResource SaveIcon}" />
                <Setter Property="ToolTip" Value="{loc:Localize TTP_MAINVIEW_TGL_SAVE_MODIFIED_ITEM}" />
                <Setter Property="Padding" Value="5" />
            </Style>

            <Style x:Key="SetToClipboardButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">

                            <Border
                                Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                        Text="{TemplateBinding Content}" />
                                    <Border x:Name="btnIconBorder">
                                        <ContentControl Margin="5" Template="{StaticResource SetToSystemClipboardIcon}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Button.IsMouseOver" Value="True">
                                    <Setter TargetName="btnIconBorder" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.5" Color="{DynamicResource TaskbarColor}" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlHighlightBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlHighlightBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ControlHighlightForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DeleteItemsButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">

                            <Border
                                Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="{TemplateBinding Content}" />
                                    <Border x:Name="btnIconBorder">
                                        <ContentControl
                                            x:Name="btnIcon"
                                            Margin="5"
                                            Template="{StaticResource TrashIcon}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Button.IsMouseOver" Value="True">
                                    <Setter TargetName="btnIconBorder" Property="Background" Value="{DynamicResource AlertBrush1}" />
                                </Trigger>
                                <Trigger Property="Button.IsPressed" Value="True">
                                    <Setter TargetName="btnIcon" Property="Background" Value="{DynamicResource AlertBrush2}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlHighlightBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AlertBrush1}" />
                        <Setter Property="Foreground" Value="{DynamicResource ControlHighlightForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <CollectionViewSource
                x:Key="ListViewSource"
                IsLiveGroupingRequested="False"
                Source="{Binding ClipboardViewItemWrappers, Mode=OneWay}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="DateCreatedDateOnlyStableString" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <!--  top bar  -->
            <RowDefinition Height="Auto" />
            <!--  list view  -->
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!--  side bar  -->
            <ColumnDefinition Width="Auto" />
            <!--  list view  -->
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <Storyboard x:Key="FadeInItem">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0"
                    To="1"
                    Duration="0:0:0.7" />
            </Storyboard>
        </Grid.Resources>

        <!--  dark overlay, indicating disabled state (used for highlighting popups)  -->
        <Border
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Panel.ZIndex="100">
            <Border.Background>
                <SolidColorBrush Opacity="0.4" Color="Black" />
            </Border.Background>
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:ClipboardViewControlBase}}}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!--  top bar  -->
        <Border
            x:Name="TopBarGrid"
            Grid.Row="0"
            Grid.Column="1"
            Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                                <Condition Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FadeInItemTopBar" Storyboard="{StaticResource FadeInItem}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FadeInItemTopBar" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="{DynamicResource TaskbarColor}" />
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!--  toolbox column;  this column should be resized according to the search column's current size  -->
                    <ColumnDefinition Width="*" />
                    <!--  search column; this column changes its size on runtime due to the expander inside  -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <!--  left scroll button  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  content  -->
                        <ColumnDefinition />
                        <!--  right scroll button  -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Name="scrollBtnLeft"
                        Grid.Column="0"
                        Width="12"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BtnArrowLeft}" />
                    <Button
                        Name="scrollBtnRight"
                        Grid.Column="2"
                        Width="12"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BtnArrowRight}" />
                    <ScrollViewer
                        Grid.Column="1"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
                        <i:Interaction.Behaviors>
                            <localBeh:ScrollViewerScrollButtonsBehavior ButtonScrollDirection="Left" ScrollButton="{Binding ElementName=scrollBtnLeft}" />
                            <localBeh:ScrollViewerScrollButtonsBehavior ButtonScrollDirection="Right" ScrollButton="{Binding ElementName=scrollBtnRight}" />
                        </i:Interaction.Behaviors>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>


                            <!--  trash button and confirmation popups  -->
                            <StackPanel
                                Grid.Column="0"
                                Height="40"
                                Orientation="Horizontal">
                                <StackPanel.Background>
                                    <SolidColorBrush Opacity="0.5" Color="{DynamicResource TaskbarColor}" />
                                </StackPanel.Background>

                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=AreAnyItemsSelected, ElementName=MainListView}" Value="True" />
                                                    <Condition Binding="{Binding Path=AreAnySubItemsSelected, ElementName=MainListView}" Value="False" />
                                                    <Condition Binding="{Binding Path=AreAnyDeletableItemsSelected, ElementName=MainListView}" Value="True" />
                                                    <Condition Binding="{Binding Path=IsShowingOfPostSelectionToolboxEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <i:Interaction.Behaviors>
                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                </i:Interaction.Behaviors>

                                <Button
                                    x:Name="trashBtn"
                                    Click="TrashBtn_Click"
                                    Content="{loc:Localize BTN_MAINVIEW_DELETE_SELECTED}"
                                    FontSize="14"
                                    Style="{StaticResource DeleteItemsButton}"
                                    ToolTip="{loc:Localize TTP_MAINVIEW_BTN_DELETE_SELECTED}" />


                                <localDialog:DialogPopup
                                    x:Name="deleteGroupConfirmationPopup"
                                    MaxWidth="350"
                                    DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:ClipboardViewControlBase}}}"
                                    DefaultButton="No"
                                    DialogueType="YesNo"
                                    DisableParentWindow="True"
                                    IsOpen="False"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=trashBtn}"
                                    ReturnFocusTo="{Binding ElementName=MainListView}">
                                    <localDialog:DialogPopup.Content>
                                        <TextBlock
                                            FontSize="16"
                                            Foreground="{DynamicResource ControlForegroundBrush}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap">
                                            <Run Text="{loc:Localize LBL_MAINVIEW_POPUP_DELETE_GROUP}" />
                                            <Run Text="{Binding Path=DataContext.GroupDateUndergoingDeletion, Converter={StaticResource DateTimeToHumanReadableDateString}}" /><Run Text="{loc:Localize LBL_QUESTION_MARK}" />
                                        </TextBlock>
                                    </localDialog:DialogPopup.Content>
                                </localDialog:DialogPopup>

                                <localDialog:DialogPopup
                                    x:Name="deleteGroupPinnedItemsNotificationPopup"
                                    MaxWidth="400"
                                    DialogAnswered="DeleteGroupPinnedItemsNotificationPopup_DialogAnswered"
                                    DialogText="{loc:Localize LBL_MAINVIEW_POPUP_PINNED_ITEMS_NOT_DELETED}"
                                    DialogueType="Ok"
                                    DisableParentWindow="True"
                                    IsOpen="False"
                                    Placement="Bottom"
                                    ReturnFocusTo="{Binding ElementName=MainListView}" />

                                <localDialog:DialogPopup
                                    x:Name="deleteConfirmationPopup"
                                    MaxWidth="350"
                                    DefaultButton="No"
                                    DialogAnswered="DeleteConfirmationPopup_DialogAnswered"
                                    DialogText="{loc:Localize LBL_MAINVIEW_POPUP_DELETE_ITEMS}"
                                    DialogueType="YesNo"
                                    IsOpen="False"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=trashBtn}"
                                    ReturnFocusTo="{Binding ElementName=MainListView}" />

                                <localDialog:DialogPopup
                                    x:Name="deleteSingleItemConfirmationPopup"
                                    MaxWidth="350"
                                    DefaultButton="No"
                                    DialogText="{loc:Localize LBL_MAINVIEW_POPUP_DELETE_SINGLE_ITEM}"
                                    DialogueType="YesNo"
                                    IsOpen="False"
                                    Placement="Bottom"
                                    ReturnFocusTo="{Binding ElementName=MainListView}" />
                            </StackPanel>


                            <!--  text block for the "incompatible items" message  -->
                            <TextBlock
                                Grid.Column="1"
                                Margin="15,0,0,0"
                                VerticalAlignment="Center"
                                Panel.ZIndex="100"
                                Background="Transparent"
                                FontSize="16"
                                Foreground="White"
                                IsEnabled="{Binding Path=AreSelectedItemsCombinable, ElementName=MainListView, Converter={StaticResource InverseBooleanConverter}}"
                                Text="{loc:Localize LBL_MAINVIEW_INCOMPATIBLE_ITEMS}"
                                Visibility="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <i:Interaction.Behaviors>
                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                </i:Interaction.Behaviors>
                            </TextBlock>

                            <!--  ui extension container and "keep generated item" toggle button  -->
                            <StackPanel
                                Grid.Column="1"
                                Height="40"
                                Margin="10,0,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding Path=AreAnyUIExtensionsLoaded, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <i:Interaction.Behaviors>
                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                </i:Interaction.Behaviors>
                                <StackPanel.Background>
                                    <SolidColorBrush Opacity="0.5" Color="{DynamicResource TaskbarColor}" />
                                </StackPanel.Background>

                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource ControlForegroundBrush}"
                                    Text="{loc:Localize LBL_MAINVIEW_UI_EXT_PANEL}" />
                                <WrapPanel
                                    x:Name="uiExtensionContainer"
                                    Margin="0,5,0,0"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="99" />

                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <!--
                                                    the save icon should be visible only when the flow ui extension parameters have been changed
                                                    or when more than one item is selected (in this case combinability is inevitable, unless of course when the items are incompatible,
                                                    in which case the entire panel with the extensions will not be visible)
                                                -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=MainListView, Path=SelectedItemsCount}" Value="1" />
                                                        <Condition Binding="{Binding Path=IsAnyUIExtensionParameterChanged, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!--  vertical separator  -->
                                    <Rectangle
                                        Width="1"
                                        Margin="10,10,10,10"
                                        VerticalAlignment="Stretch"
                                        Stroke="DarkGray" />

                                    <ToggleButton
                                        x:Name="keepGeneratedItemsCb"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource keepGeneratedItemToggleButton}" />
                                </StackPanel>

                            </StackPanel>


                            <!--  charge clipboard button  -->
                            <StackPanel
                                Grid.Column="2"
                                Height="40"
                                Margin="10,0,0,0"
                                Orientation="Horizontal">
                                <i:Interaction.Behaviors>
                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                </i:Interaction.Behaviors>
                                <StackPanel.Background>
                                    <SolidColorBrush Opacity="0.5" Color="{DynamicResource TaskbarColor}" />
                                </StackPanel.Background>
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=AreAnyItemsSelected, ElementName=MainListView}" Value="True" />
                                                    <Condition Binding="{Binding Path=AreSelectedItemsCombinable, ElementName=MainListView}" Value="True" />
                                                    <Condition Binding="{Binding Path=IsShowingOfPostSelectionToolboxEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button
                                    x:Name="setToClipboardBtn"
                                    Click="SetToClipboardButton_Click"
                                    Content="{loc:Localize BTN_MAINVIEW_SET_TO_CLIPBOARD}"
                                    FontSize="14"
                                    Style="{StaticResource SetToClipboardButton}"
                                    ToolTip="{loc:Localize TTP_MAINVIEW_BTN_SET_TO_CLIPBOARD}" />

                            </StackPanel>

                            <local:PopupHint
                                AreFadeAnimationsEnabled="True"
                                IsOpen="{Binding ElementName=setToClipboardBtn, Path=IsVisible, Mode=OneWay}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=setToClipboardBtn}"
                                StaysOpen="True"
                                Text="Some text to show" />
                        </Grid>
                    </ScrollViewer>
                </Grid>


                <views:ExpandableSearchBox
                    x:Name="searchTextBox"
                    Grid.Column="1"
                    Height="45"
                    Margin="5"
                    HorizontalAlignment="Right"
                    SearchRequested="ExpandableSearchBox_SearchRequested">
                    <i:Interaction.Behaviors>
                        <infBeh:FrameworkElementDpiScalingBehavior />
                    </i:Interaction.Behaviors>
                    <views:ExpandableSearchBox.Style>
                        <Style TargetType="{x:Type views:ExpandableSearchBox}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Setter Property="ToolTip" Value="{x:Null}" />
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchIndexHealthy}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="ToolTip" Value="{loc:Localize TTP_MAINVIEW_SEARCHBOX_DISABLED_DUE_TO_ERRORS}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSearchEnabled}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="ToolTip" Value="{loc:Localize TTP_MAINVIEW_SEARCH_FUNCTIONALITY_DISABLED}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ExpandableSearchBox.Style>
                </views:ExpandableSearchBox>
            </Grid>
        </Border>

        <!--  side bar  -->
        <Grid
            x:Name="SideBarGrid"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Visibility="Collapsed">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                                <Condition Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FadeInItemSideBar" Storyboard="{StaticResource FadeInItem}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FadeInItemSideBar" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding ElementName=TopBarGrid, Path=ActualHeight}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.Background>
                <SolidColorBrush Opacity="0.6" Color="{DynamicResource TaskbarColor}" />
            </Grid.Background>
            <i:Interaction.Behaviors>
                <infBeh:FrameworkElementDpiScalingBehavior />
            </i:Interaction.Behaviors>

            <Button
                Grid.Row="0"
                MaxWidth="35"
                MaxHeight="35"
                Margin="0,8,0,3"
                Padding="12"
                VerticalAlignment="Top"
                Click="BtnCloseMainWindow_Click"
                Style="{DynamicResource BtnCloseMainWindow}"
                ToolTip="{loc:Localize TTP_MAINVIEW_CLOSE_BUTTON}"
                Visibility="{Binding Path=IsManipulationEnabled, RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--
                show the cloud filter only when the cloud service is enabled (regardless of the cloud service error state
                and regardless of whether cloud syncing is actually enabled at the moment)
            -->
            <filterBand:FilterBand
                x:Name="filterBand"
                Grid.Row="1"
                ClipboardItemsDataProvider="{Binding ClipboardItemsDataProvider}"
                IsCloudSyncServiceEnabled="{Binding IsCloudSyncServiceEnabled, Mode=OneWay}"
                SearchTermsChanged="FilterBand_SearchTermsChanged"
                ShouldParentBeEnabled="{Binding Path=IsEnabled, Mode=OneWayToSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:ClipboardViewControlBase}}}">
                <filterBand:FilterBand.Style>
                    <Style TargetType="{x:Type filterBand:FilterBand}">
                        <Setter Property="IsEnabled" Value="True" />
                        <Setter Property="ToolTip" Value="{x:Null}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchIndexHealthy}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="ToolTip" Value="{loc:Localize TTP_MAINVIEW_FILTERS_DISABLED_DUE_TO_ERRORS}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSearchEnabled}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="ToolTip" Value="{loc:Localize TTP_MAINVIEW_SEARCH_FUNCTIONALITY_DISABLED}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </filterBand:FilterBand.Style>
            </filterBand:FilterBand>

            <StackPanel
                Grid.Row="2"
                Width="{Binding ElementName=BtnSettings, Path=ActualWidth}"
                VerticalAlignment="Bottom"
                Orientation="Vertical">
                <Button
                    VerticalContentAlignment="Center"
                    Click="UpdateAvailableButton_Click"
                    Foreground="#FFC17819"
                    ToolTip="{loc:Localize TTP_MAINVIEW_BTN_UPDATE_AVAILABLE}"
                    Visibility="{Binding IsUpdateAvailable, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}" Value="True">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ContentControl Margin="15" Template="{StaticResource UpdateAvailableBlinkingIcon}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}" Value="False">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ContentControl Margin="15" Template="{StaticResource UpdateAvailableIcon}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button
                    VerticalContentAlignment="Center"
                    Click="CloudErrorButton_Click"
                    Foreground="{DynamicResource AlertBrush2}"
                    ToolTip="{loc:Localize TTP_MAINVIEW_BTN_CLOUD_ERROR}"
                    Visibility="{Binding IsCloudSyncSvcInErrorState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}" Value="True">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ContentControl Margin="15" Template="{StaticResource CloudErrorBlinkingIcon}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}" Value="False">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ContentControl Margin="15" Template="{StaticResource CloudErrorIcon}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Button
                x:Name="BtnSettings"
                Grid.Row="3"
                VerticalAlignment="Bottom"
                VerticalContentAlignment="Center"
                Click="SettingsButton_Click"
                Style="{StaticResource IconButton}"
                ToolTip="{loc:Localize TTP_MAINVIEW_BTN_SETTINGS}">
                <ContentControl Margin="15" Template="{StaticResource SettingsIcon}" />
            </Button>

        </Grid>


        <!--
            This listview should scroll its contents by physical units instead of logical ones,
            thus ScrollViewer.CanContentScroll="False". Otherwise, when grouping is used,
            the scrollviewer jumps awkwardly to the next group...
        -->
        <!--  We load this view hidden, so that it can group its items before we show it; Then we show it from GroupItem's template Loaded event.  -->
        <Grid
            x:Name="MainListViewContainer"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="Hidden">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                                <Condition Binding="{Binding Path=AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="FadeInItemListView" Storyboard="{StaticResource FadeInItem}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FadeInItemListView" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!--  label "No contents"  -->
            <Label
                Grid.Row="0"
                Width="250"
                Height="100"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                Content="{loc:Localize LBL_MAINVIEW_NO_ITEMS}"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White">
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!--  if the search index is healthy and no items are available  -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ClipboardViewItemWrappers.Count}" Value="0" />
                                    <Condition Binding="{Binding IsSearchIndexHealthy}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger.Setters>
                            </MultiDataTrigger>
                            <!--  or if the search is disabled and no items are available  -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ClipboardViewItemWrappers.Count}" Value="0" />
                                    <Condition Binding="{Binding IsSearchEnabled}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger.Setters>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>

            <Grid
                Grid.Row="0"
                Width="250"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="100">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchIndexHealthy}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!--  if the search functionality is disabled, we cannot rebuild indices...  -->
                            <DataTrigger Binding="{Binding IsSearchEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>
                <Label
                    Grid.Row="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    Content="{loc:Localize LBL_MAINVIEW_SEARCH_INDEX_BROKEN}"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White" />
                <Button
                    x:Name="rebuildIndexButton"
                    Grid.Row="1"
                    Width="130"
                    Height="40"
                    Background="{DynamicResource TaskbarColorBrush}"
                    Click="RebuildIndexButton_Click"
                    Content="{loc:Localize BTN_MAINVIEW_REBUILD_SEARCH_INDEX}"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Style="{StaticResource BtnRebuild}" />
            </Grid>

            <!--  main list view  -->
            <lv:FullClipboardListView
                x:Name="MainListView"
                Margin="10"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Top"
                AllPagesItemsCount="{Binding AllPagesItemsCount, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}"
                Background="Transparent"
                BorderThickness="0"
                ClipboardItemContentControl_MouseDoubleClickDetectionStarted="MainListView_ClipboardItemContentControl_MouseDoubleClickDetectionStarted"
                ClipboardItemContentControl_MouseDoubleClickDetection_DoubleClickDetected="MainListView_ClipboardItemContentControl_MouseDoubleClickDetection_DoubleClickDetected"
                ClipboardItemContentControl_MouseDoubleClickDetection_SingleClickDetected="MainListView_ClipboardItemContentControl_MouseDoubleClickDetection_SingleClickDetected"
                ClipboardItemsPanel_KeyUp="MainListView_ClipboardItemsPanel_KeyUp"
                ClipboardViewItemMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}}"
                CombinabilityCheckRequested="MainListView_CombinabilityCheckRequested"
                DimNonFocusedItems="{Binding Path=DimNonFocusedItems, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}}"
                GroupingComplete="MainListView_GroupingComplete"
                IsFadeInOfItemsEnabled="{Binding AreFadeAnimationsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type views:MainViewClipboardContents}}}"
                IsInnerGroupingEnabled="False"
                ItemDeletionRequested="MainListView_ItemDeletionRequested"
                ItemEnableDisableSyncRequested="MainListView_ItemEnableDisableSyncRequested"
                ItemGroupDeletionRequested="MainListView_ItemGroupDeletionRequested"
                ItemProtectUnprotectRequested="MainListView_ItemProtectUnprotectRequested"
                ItemsSource="{Binding Source={StaticResource ListViewSource}}"
                LoadMoreItemsRequested="MainListView_LoadMoreItemsRequested"
                NumOfNotYetVisibleRowsToPreload="{Binding Path=NumOfNotYetVisibleRowsToPreload, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}}"
                SelectionChangeCompleted="MainListView_SelectionChangeCompleted"
                ViewItemLoadingCancelRequested="MainListView_ViewItemLoadingCancelRequested"
                ViewItemLoadingRequested="MainListView_ViewItemLoadingRequested"
                ViewItemUnloadingRequested="MainListView_ViewItemUnloadingRequested">
                <lv:FullClipboardListView.IsCloudSyncAvailable>
                    <!--
                        hide all controls which allow cloud operations when the cloud state service is not available
                        or is in error state
                    -->
                    <MultiBinding Converter="{StaticResource AndMultiValueConverter}">
                        <MultiBinding.Bindings>
                            <Binding Mode="OneWay" Path="IsCloudSyncAvailable" />
                            <Binding
                                Converter="{StaticResource InverseBooleanConverter}"
                                Mode="OneWay"
                                Path="IsCloudSyncSvcInErrorState" />
                        </MultiBinding.Bindings>
                    </MultiBinding>
                </lv:FullClipboardListView.IsCloudSyncAvailable>
            </lv:FullClipboardListView>
        </Grid>
    </Grid>
</views:ClipboardViewControlBase>
