<UserControl
    x:Class="Clipbox.Views.TrayContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <coreConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ContextMenu x:Key="TrayContextMenu" Placement="MousePoint">
            <MenuItem
                Command="{Binding ToggleMainWindowOpen}"
                Header="{loc:Localize LBL_CONTEXT_MENU_OPEN_MAIN_WINDOW}"
                IsEnabled="{Binding IsMainWindowOpen, Converter={StaticResource InverseBooleanConverter}}"
                Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/OpenMainWindow.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding ToggleMainWindowOpen}"
                Header="{loc:Localize LBL_CONTEXT_MENU_CLOSE_MAIN_WINDOW}"
                Visibility="{Binding IsMainWindowOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/OpenMainWindow.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding ToggleCloudSyncEnabled}" Header="{loc:Localize LBL_CONTEXT_MENU_DISABLE_CLOUD_SYNC}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/SyncDisabled.png" />
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCloudSyncEnabled}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToggleCloudSyncVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Command="{Binding ToggleCloudSyncEnabled}" Header="{loc:Localize LBL_CONTEXT_MENU_ENABLE_CLOUD_SYNC}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/Sync.png" />
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCloudSyncEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToggleCloudSyncVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                Header="{loc:Localize LBL_CONTEXT_MENU_PAUSE_FOR}"
                IsEnabled="{Binding IsPaused, Converter={StaticResource InverseBooleanConverter}}"
                Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/Pause.png" />
                </MenuItem.Icon>
                <MenuItem
                    Command="{Binding Pause}"
                    CommandParameter="30000"
                    Header="{loc:Localize LBL_CONTEXT_MENU_30_SEC}" />
                <MenuItem
                    Command="{Binding Pause}"
                    CommandParameter="300000"
                    Header="{loc:Localize LBL_CONTEXT_MENU_5_MIN}" />
                <MenuItem
                    Command="{Binding Pause}"
                    CommandParameter="1800000"
                    Header="{loc:Localize LBL_CONTEXT_MENU_30_MIN}" />
                <MenuItem
                    Command="{Binding Pause}"
                    CommandParameter="-1"
                    Header="{loc:Localize LBL_CONTEXT_MENU_PAUSE_FOREVER}" />
            </MenuItem>
            <MenuItem
                Command="{Binding Resume}"
                Header="{loc:Localize LBL_CONTEXT_MENU_RESUME}"
                Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/Resume.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding OpenSettingsWindow}" Header="{loc:Localize LBL_CONTEXT_MENU_SETTINGS}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/Settings.png" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding Quit}" Header="{loc:Localize LBL_CONTEXT_MENU_QUIT}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/Exit.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
</UserControl>
