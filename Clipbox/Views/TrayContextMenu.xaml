<UserControl
    x:Class="Clipbox.Views.TrayContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <coreConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ContextMenu x:Key="TrayContextMenu" Placement="MousePoint">
            <MenuItem
                Command="{Binding ToggleMainWindowOpen}"
                Header="Open Clipbox"
                IsEnabled="{Binding IsMainWindowOpen, Converter={StaticResource InverseBooleanConverter}}"
                Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/OpenMainWindow.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding ToggleMainWindowOpen}"
                Header="Close Clipbox"
                Visibility="{Binding IsMainWindowOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/OpenMainWindow.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding ToggleCloudSyncEnabled}"
                Header="Disable cloud sync"
                Visibility="{Binding IsCloudSyncEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/SyncDisabled.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding ToggleCloudSyncEnabled}"
                Header="Enable cloud sync"
                IsEnabled="{Binding IsCloudSyncEnabled, Converter={StaticResource InverseBooleanConverter}}"
                Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/Sync.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Header="Pause For"
                IsEnabled="{Binding IsPaused, Converter={StaticResource InverseBooleanConverter}}"
                Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/Pause.png" />
                </MenuItem.Icon>
                <MenuItem
                    Command="{Binding Pause}"
                    CommandParameter="30000"
                    Header="30 sec" />
                <MenuItem
                    Command="{Binding Pause}"
                    CommandParameter="300000"
                    Header="5 min" />
                <MenuItem
                    Command="{Binding Pause}"
                    CommandParameter="1800000"
                    Header="30 min" />
                <MenuItem
                    Command="{Binding Pause}"
                    CommandParameter="-1"
                    Header="Forever" />
            </MenuItem>
            <MenuItem
                Command="{Binding Resume}"
                Header="Resume"
                Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/Resume.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding OpenSettingsWindow}" Header="Settings">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/Settings.png" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding Quit}" Header="Quit">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Resources/Images/Exit.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
</UserControl>
