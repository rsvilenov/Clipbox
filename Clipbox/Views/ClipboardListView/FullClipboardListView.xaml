<lv:ClipboardListViewBase
    x:Class="Clipbox.Views.ClipboardListView.FullClipboardListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:coreCcEnums="clr-namespace:Clipbox.Core.ClipboardContent.Enums;assembly=Clipbox.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:localBindableObjects="clr-namespace:Clipbox.ViewModels.BindableObjects"
    xmlns:lv="clr-namespace:Clipbox.Views.ClipboardListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:tile="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    xmlns:vmEnums="clr-namespace:Clipbox.ViewModels.Enums"
    VerticalAlignment="Stretch"
    VerticalContentAlignment="Top"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    BorderThickness="0"
    FocusVisualStyle="{x:Null}"
    ScrollViewer.CanContentScroll="False"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    ScrollViewer.VerticalScrollBarVisibility="Visible"
    Visibility="Hidden"
    mc:Ignorable="d">

    <i:Interaction.Behaviors>
        <localBeh:ListViewGroupingBehavior GroupByPropertyName="DateCreated" IsEnabled="{Binding IsInnerGroupingEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:FullClipboardListView}}}" />
        <localBeh:ListViewOnFocusSelectFirstItemBehavior />
    </i:Interaction.Behaviors>
    <ListView.Resources>
        <infConv:BooleanToVisibilityHiddenConverter x:Key="BooleanToVisibilityHiddenConverter" />
        <conv:ObjectTypeCompareConverter x:Key="ObjectTypeCompareConverter" />
        <conv:BitmapToBitmapImageConverter x:Key="BitmapToBitmapImageConverter" />
        <conv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <infConv:OrMultiValueConverter x:Key="OrMultiValueConverter" />
        <infConv:AndMultiValueConverter x:Key="AndMultiValueConverter" />
        <infConv:MathAddConverter x:Key="MathAddConverter" />
        <infConv:BooleanToVisibilityMultiConverter x:Key="BooleanToVisibilityMultiConverter" />
        <infConv:ComparisonConverter x:Key="ComparisonConverter" />
        <infConv:MultiValueEqualityConverter x:Key="MultiValueEqualityConverter" />
        <infConv:IsEqualOrGreaterThanConverter x:Key="IsEqualOrGreaterThanConverter" />
        <infConv:NullOrEmptyCollectionToBoolConverter x:Key="NullOrEmptyCollectionToBoolConverter" />
        <conv:ContentClassListContainsConverter x:Key="ContentClassListContainsConverter" />
        <conv:DateTimeToHumanReadableDateString x:Key="DateTimeToHumanReadableDateString" />

        <Style x:Key="MultiItemPresenterStyleForSubItems_EventTriggersStyle" TargetType="{x:Type tile:MultiItemPresenter}">
            <EventSetter Event="Unloaded" Handler="MultiItemPresenter_Unloaded" />
            <EventSetter Event="Loaded" Handler="MultiItemPresenter_Loaded" />
        </Style>

        <ControlTemplate x:Key="MinimalisticScrollViewerControlTemplate" TargetType="{x:Type ScrollViewer}">
            <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollContentPresenter
                    x:Name="PART_ScrollContentPresenter"
                    Grid.Column="0"
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Stretch"
                    CanContentScroll="{TemplateBinding CanContentScroll}"
                    CanHorizontallyScroll="False"
                    CanVerticallyScroll="False"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                <!--
                    Left margin was added here to
                    compensate for the negative margin of the
                    textblock inside the VerticalScrollBarEx
                -->
                <lv:VerticalScrollBarEx
                    x:Name="PART_VerticalScrollBar"
                    Grid.Column="1"
                    Margin="50,0,0,0"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="VerticalScrollBar"
                    BottomLabelText="{Binding LastItemDate, Converter={StaticResource DateTimeToHumanReadableDateString}}"
                    Cursor="Arrow"
                    DataContext="{Binding Path=ScrollBarDataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:FullClipboardListView}}}"
                    FloatingLabelText="{Binding CurrentVisibleItemsGroupDate, Converter={StaticResource DateTimeToHumanReadableDateString}}"
                    FontSize="14"
                    Foreground="White"
                    Loaded="PART_VerticalScrollBar_Loaded"
                    Maximum="{TemplateBinding ScrollableHeight}"
                    Minimum="0"
                    ScrollBarThumbPositionChanged="PART_VerticalScrollBar_ScrollBarThumbPositionChanged"
                    TopLabelText="{Binding FirstItemDate, Converter={StaticResource DateTimeToHumanReadableDateString}}"
                    ViewportSize="{TemplateBinding ViewportHeight}"
                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                    Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />

            </Grid>
        </ControlTemplate>
    </ListView.Resources>
    <ListView.Style>
        <Style TargetType="{x:Type ListView}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.PanningMode" Value="Both" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Grid>
                            <Border
                                x:Name="Bd"
                                Padding="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                                <ScrollViewer
                                    Padding="{TemplateBinding Padding}"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Disabled"
                                    Template="{DynamicResource MinimalisticScrollViewerControlTemplate}"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ListView.Style>

    <!--  Remove the default highlighting on mouse over  -->
    <ListView.ItemContainerStyle>
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <ContentPresenter
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewItemLoaded}" Value="False">
                    <!--  disable the selection of the item  -->
                    <Setter Property="Focusable" Value="False" />
                    <!--  disable the mouse events for the item, as there are triggers on them (the mouseover border for example)  -->
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ListView.ItemContainerStyle>

    <ListView.ItemsPanel>
        <ItemsPanelTemplate>
            <WrapPanel KeyUp="WrapPanel_KeyUp" />
        </ItemsPanelTemplate>
    </ListView.ItemsPanel>

    <ListView.GroupStyle>
        <GroupStyle>
            <GroupStyle.ContainerStyle>
                <Style TargetType="{x:Type GroupItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <StackPanel Loaded="StackPanel_Loaded" Orientation="Vertical">
                                    <StackPanel Background="Transparent" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Bottom"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{TemplateBinding Foreground}"
                                            Text="{Binding Items[0].DateCreated, Converter={StaticResource DateTimeToHumanReadableDateString}}" />

                                        <Button
                                            x:Name="deleteGroupBtn"
                                            MaxWidth="20"
                                            Margin="20,0,5,0"
                                            Command="{Binding Path=ActionButtonsDataContext.DeleteClipboardEntryGroup, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                            CommandParameter="{Binding Items[0].ViewItem}"
                                            Style="{DynamicResource BtnTrash}"
                                            ToolTip="{loc:Localize TTP_MAINVIEW_BTN_DELETE_GROUP}">
                                            <i:Interaction.Behaviors>
                                                <infBeh:FrameworkElementDpiScalingBehavior />
                                            </i:Interaction.Behaviors>
                                        </Button>
                                    </StackPanel>

                                    <!--  Add some space to the top and the bottom of each group  -->
                                    <ItemsPresenter Margin="0,10,0,50" />


                                    <Button
                                        x:Name="LoadMoreControl"
                                        Margin="0,10,0,10"
                                        HorizontalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="1"
                                        Click="LoadMoreControl_Click"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="White">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="BorderBrush" Value="Gray" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                <Border.Background>
                                                                    <SolidColorBrush Opacity="0.6" Color="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Background.Color}" />
                                                                </Border.Background>
                                                                <TextBlock Margin="35,5,35,5" Text="{loc:Localize BTN_MAINVIEW_LOAD_MORE}" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource MultiValueEqualityConverter}">
                                                                <Binding
                                                                    Mode="OneWay"
                                                                    Path="LastGroupName"
                                                                    RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                                                    AncestorType=ListView}" />
                                                                <Binding Mode="OneWay" Path="Name" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource MultiValueEqualityConverter}">
                                                                <Binding
                                                                    Mode="OneWay"
                                                                    Path="AllPagesItemsCount"
                                                                    RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                                                    AncestorType=ListView}" />
                                                                <Binding
                                                                    Mode="OneWay"
                                                                    Path="Items.Count"
                                                                    RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                                                    AncestorType=ListView}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
        </GroupStyle>
    </ListView.GroupStyle>

    <ListView.ItemTemplate>
        <DataTemplate>
            <Border
                MinWidth="100"
                MinHeight="80"
                Margin="5"
                Background="Transparent"
                BorderThickness="0"
                SnapsToDevicePixels="True">

                <i:Interaction.Behaviors>
                    <localBeh:ListViewItemUnselectOnClickBehavior />
                </i:Interaction.Behaviors>

                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <!--  use IsManipulationEnabled as a bindable flag, indicating that the mouse is over the item  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="IsManipulationEnabled" Value="True" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  selected/mouseover indicator  -->
                    <Border
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.IsSelected}" Value="True" />
                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.5" Color="{DynamicResource AccentColor}" />
                                            </Setter.Value>
                                        </Setter>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsManipulationEnabled, RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.IsSelected}" Value="False" />
                                            <Condition Binding="{Binding IsSelected}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.4" Color="{DynamicResource AccentColor}" />
                                            </Setter.Value>
                                        </Setter>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!--  top band  -->
                    <Grid
                        Grid.Row="0"
                        Margin="5,3,0,0"
                        Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentControl
                            Grid.Column="0"
                            MinHeight="25"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <ContentControl.Style>
                                <Style TargetType="{x:Type ContentControl}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsViewItemLoaded}" Value="True">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <Grid
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <tile:ContentTypeIconBand
                                                                Grid.Column="0"
                                                                MaxHeight="30"
                                                                ContentClasses="{Binding Path=ViewItem.ContentClasses}"
                                                                IsGroupItem="{Binding Path=ViewItem, Converter={StaticResource ObjectTypeCompareConverter}, ConverterParameter={x:Type localBindableObjects:ClipboardViewItemGroup}}">
                                                                <i:Interaction.Behaviors>
                                                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                                                </i:Interaction.Behaviors>
                                                            </tile:ContentTypeIconBand>

                                                            <StackPanel
                                                                Grid.Column="1"
                                                                Width="Auto"
                                                                Orientation="Horizontal">

                                                                <!--  cloud item indicator separator  -->
                                                                <Rectangle
                                                                    Width="1"
                                                                    Height="15"
                                                                    Margin="5,0,0,0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Fill="LightGray"
                                                                    Visibility="{Binding Path=ViewItem.IsCloudItem, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                                <!--  cloud item indicator  -->
                                                                <ContentControl
                                                                    MaxHeight="17"
                                                                    Margin="5,0,0,0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="Transparent"
                                                                    Template="{DynamicResource PcSourceIcon}">
                                                                    <ContentControl.ToolTip>
                                                                        <TextBlock>
                                                                            <TextBlock.Text>
                                                                                <MultiBinding StringFormat="{}{0}@{1}">
                                                                                    <Binding Path="ViewItem.SourceWindowUserName" />
                                                                                    <Binding Path="ViewItem.SourceWindowMachineName" />
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                    </ContentControl.ToolTip>
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Path=ViewItem.IsCloudItem}" Value="True" />
                                                                                        <Condition Binding="{Binding Path=ViewItem.SourceMachineType}" Value="{x:Static coreCcEnums:MachineType.PC}" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                    <i:Interaction.Behaviors>
                                                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                                                    </i:Interaction.Behaviors>
                                                                </ContentControl>

                                                                <ContentControl
                                                                    MaxHeight="17"
                                                                    Margin="5,0,0,0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="Transparent"
                                                                    Template="{DynamicResource MobileSourceIcon}"
                                                                    ToolTip="{Binding Path=ViewItem.SourceWindowMachineName}">
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Path=ViewItem.IsCloudItem}" Value="True" />
                                                                                        <Condition Binding="{Binding Path=ViewItem.SourceMachineType}" Value="{x:Static coreCcEnums:MachineType.Mobile}" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                    <i:Interaction.Behaviors>
                                                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                                                    </i:Interaction.Behaviors>
                                                                </ContentControl>

                                                                <!--  source window icon separator  -->
                                                                <Rectangle
                                                                    Width="1"
                                                                    Height="15"
                                                                    Margin="5,0,0,0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Fill="LightGray" />

                                                                <!--  source window icon  -->
                                                                <Image
                                                                    MaxHeight="20"
                                                                    Margin="5,0,0,0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Source="{Binding Path=ViewItem.SourceWindowIcon}"
                                                                    ToolTip="{Binding Path=ViewItem.SourceWindowDescription}">
                                                                    <i:Interaction.Behaviors>
                                                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                                                    </i:Interaction.Behaviors>
                                                                </Image>

                                                            </StackPanel>

                                                        </Grid>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <!--
                            keep this button ouside of the changeable template above, so that it occupies its height,
                            regardless of whether the template has been set or not... So when the template is set,
                            the total hight stays the same
                        -->
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="0">
                                <ContentControl.Style>
                                    <Style TargetType="{x:Type ContentControl}">
                                        <!--  hidden by default  -->
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <!--  when the item is loaded, show the close button  -->
                                            <!--<DataTrigger Binding="{Binding Path=IsViewItemLoaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>-->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                                    <Condition Binding="{Binding Path=SelectedItems.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListView}}}" Value="0" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                                    <Condition Binding="{Binding Path=SelectedItems.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListView}}}" Value="1" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ToggleButton
                                    Name="tglBtn"
                                    MaxWidth="25"
                                    Margin="0,0,5,0"
                                    Command="{Binding Path=ActionButtonsDataContext.ProtectUnprotectClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                    CommandParameter="{Binding Path=ViewItem}"
                                    IsChecked="{Binding ViewItem.IsProtected, Mode=OneWay}"
                                    Style="{DynamicResource ToggleBtnProtect}">
                                    <i:Interaction.Behaviors>
                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                        <localBeh:ToggleButtonToolTipBehavior CheckedToolTipText="{loc:Localize TTP_MAINVIEW_UNPROTECT_ITEM}" UncheckedToolTipText="{loc:Localize TTP_MAINVIEW_PROTECT_ITEM}" />
                                    </i:Interaction.Behaviors>
                                    <!--  Visible only if the ListViewItem is highlighted or selected (IsManipulationEnabled = true) OR the toggle button is checked  -->
                                    <ToggleButton.IsEnabled>
                                        <MultiBinding Converter="{StaticResource OrMultiValueConverter}">
                                            <Binding Path="IsManipulationEnabled" RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                            <Binding Path="ViewItem.IsProtected" />
                                        </MultiBinding>
                                    </ToggleButton.IsEnabled>
                                    <ToggleButton.Visibility>
                                        <Binding
                                            Converter="{StaticResource BooleanToVisibilityHiddenConverter}"
                                            Path="IsEnabled"
                                            RelativeSource="{RelativeSource Self}" />
                                    </ToggleButton.Visibility>
                                </ToggleButton>
                            </ContentControl>

                            <ContentControl Grid.Column="1" ToolTipService.ShowOnDisabled="True">
                                <ContentControl.Style>
                                    <Style TargetType="{x:Type ContentControl}">
                                        <!--  hidden by default  -->
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <!--  when the item is loaded, show the close button  -->
                                            <!--<DataTrigger Binding="{Binding Path=IsViewItemLoaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>-->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                                    <Condition Binding="{Binding Path=SelectedItems.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListView}}}" Value="0" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                                    <Condition Binding="{Binding Path=SelectedItems.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListView}}}" Value="1" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding ViewItem.IsProtected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ViewItem.IsPinned}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="ToolTip" Value="{loc:Localize TTP_MAINVIEW_DELETE_DISABLED_ITEM_PINNED_IN_QV}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <Button
                                    MaxWidth="25"
                                    Margin="0,0,5,0"
                                    Command="{Binding Path=ActionButtonsDataContext.DeleteClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                    CommandParameter="{Binding Path=ViewItem}"
                                    Style="{DynamicResource BtnTrash}"
                                    ToolTip="{loc:Localize TTP_MAINVIEW_BTN_DELETE_THIS_ITEM}"
                                    Visibility="{Binding Path=IsManipulationEnabled, RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource BooleanToVisibilityHiddenConverter}}">
                                    <i:Interaction.Behaviors>
                                        <infBeh:FrameworkElementDpiScalingBehavior />
                                    </i:Interaction.Behaviors>
                                </Button>
                            </ContentControl>
                            <Grid
                                Grid.Column="2"
                                MaxWidth="25"
                                Margin="0,0,5,0">
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <!--
                                                for items that come from the cloud we should never show this grid, so we can safely set its visibility to collapsed.
                                                For other items, showing the grid may change the layout sizing, so in order to prevent that, we should hide it with Hidden.
                                            -->
                                            <DataTrigger Binding="{Binding Path=ViewItem.IsCloudItem}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsCloudSyncAvailable, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ContentControl Template="{DynamicResource SyncingIcon}" ToolTip="{loc:Localize TTP_MAINVIEW_ICON_SYNCING}">
                                    <ContentControl.Style>
                                        <Style TargetType="{x:Type ContentControl}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=SyncStatus}" Value="{x:Static vmEnums:CloudSyncStatus.Syncing}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <ContentControl Template="{DynamicResource SyncCompleteIcon}" ToolTip="{loc:Localize TTP_MAINVIEW_ICON_SYNC_COMPLETE}">
                                    <ContentControl.Style>
                                        <Style TargetType="{x:Type ContentControl}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=SyncStatus}" Value="{x:Static vmEnums:CloudSyncStatus.SyncComplete}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <ContentControl ToolTipService.ShowOnDisabled="True">
                                    <ContentControl.Style>
                                        <Style TargetType="{x:Type ContentControl}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=SyncStatus}" Value="{x:Static vmEnums:CloudSyncStatus.SyncDisabled}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="ToolTip" Value="{loc:Localize TTP_MAINVIEW_BTN_SYNC}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SyncStatus}" Value="{x:Static vmEnums:CloudSyncStatus.SyncRequested}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="ToolTip" Value="{loc:Localize TTP_MAINVIEW_BTN_CANCEL_SYNC}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=IsItemTransferable}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="ToolTip" Value="{loc:Localize TTP_MAINVIEW_BTN_SYNC_NON_TRANSFERABLE_ITEM}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                    <ToggleButton
                                        Command="{Binding Path=ActionButtonsDataContext.EnableDisableSyncOfClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                        CommandParameter="{Binding ViewItem}"
                                        IsChecked="{Binding Path=SyncStatus, Mode=OneWay, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vmEnums:CloudSyncStatus.SyncRequested}}"
                                        Style="{DynamicResource ToggleBtnEnableDisableSync}">
                                        <i:Interaction.Behaviors>
                                            <infBeh:FrameworkElementDpiScalingBehavior />
                                        </i:Interaction.Behaviors>

                                        <!--  Visible only if the ListViewItem is highlighted or selected (IsManipulationEnabled = true) OR the toggle button is checked  -->
                                        <ToggleButton.IsManipulationEnabled>
                                            <MultiBinding Converter="{StaticResource OrMultiValueConverter}">
                                                <Binding Path="IsManipulationEnabled" RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </ToggleButton.IsManipulationEnabled>
                                        <ToggleButton.Visibility>
                                            <Binding
                                                Converter="{StaticResource BooleanToVisibilityHiddenConverter}"
                                                Path="IsManipulationEnabled"
                                                RelativeSource="{RelativeSource Self}" />
                                        </ToggleButton.Visibility>
                                    </ToggleButton>
                                </ContentControl>
                            </Grid>
                        </Grid>

                    </Grid>


                    <ContentControl
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        PreviewMouseLeftButtonDown="ContentControl_PreviewMouseLeftButtonDown"
                        Unloaded="ContentControl_Unloaded">

                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="False">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <tile:SingleItemPresenter
                                                        IsFadeInEnabled="{Binding Path=IsFadeInOfItemsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:FullClipboardListView}}}"
                                                        IsLoadingFadeInEnabled="False"
                                                        IsLoadingIndicatorFadeInEnabled="True"
                                                        IsShownIntoView="{Binding Path=DataContext.IsShownIntoView, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                        PreviewContainerBackgroundColor="{DynamicResource TaskbarColor}"
                                                        ThumbnailAreaMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}}"
                                                        ThumbnailAreaMinHeight="{Binding Path=ThumbnailAreaMaxHeight, RelativeSource={RelativeSource Mode=Self}}"
                                                        ViewItemWrapper="{Binding Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=DataContext}">
                                                        <tile:SingleItemPresenter.IsDimmed>
                                                            <MultiBinding Converter="{StaticResource AndMultiValueConverter}">
                                                                <Binding
                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                    Path="IsManipulationEnabled"
                                                                    RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                <Binding Path="DimNonFocusedItems" RelativeSource="{RelativeSource AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                <Binding
                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                    Path="DataContext.IsSelected"
                                                                    RelativeSource="{RelativeSource AncestorType={x:Type ListViewItem}}" />
                                                            </MultiBinding>
                                                        </tile:SingleItemPresenter.IsDimmed>
                                                    </tile:SingleItemPresenter>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <tile:MultiItemPresenter
                                                        IsFadeInEnabled="{Binding Path=IsFadeInOfItemsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:FullClipboardListView}}}"
                                                        IsLoadingFadeInEnabled="False"
                                                        IsLoadingIndicatorFadeInEnabled="True"
                                                        IsShownIntoView="{Binding Path=DataContext.IsShownIntoView, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                        PreviewContainerBackgroundColor="{DynamicResource TaskbarColor}"
                                                        ViewItemWrapper="{Binding Mode=OneTime, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=DataContext}">

                                                        <tile:MultiItemPresenter.Height>
                                                            <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                <Binding Path="ClipboardViewItemMaxHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                <Binding>
                                                                    <Binding.Source>
                                                                        <!--  pad the height so that it matches the total height of the single view items  -->

                                                                        <sys:Double>60</sys:Double>
                                                                    </Binding.Source>
                                                                </Binding>
                                                            </MultiBinding>
                                                        </tile:MultiItemPresenter.Height>
                                                        <tile:MultiItemPresenter.IsDimmed>
                                                            <MultiBinding Converter="{StaticResource AndMultiValueConverter}">
                                                                <Binding
                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                    Path="IsManipulationEnabled"
                                                                    RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                <Binding Path="DimNonFocusedItems" RelativeSource="{RelativeSource AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                <Binding
                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                    Path="DataContext.IsSelected"
                                                                    RelativeSource="{RelativeSource AncestorType={x:Type ListViewItem}}" />
                                                            </MultiBinding>
                                                        </tile:MultiItemPresenter.IsDimmed>
                                                        <tile:MultiItemPresenter.Style>
                                                            <Style BasedOn="{StaticResource MultiItemPresenterStyleForSubItems_EventTriggersStyle}" TargetType="{x:Type tile:MultiItemPresenter}">
                                                                <Setter Property="PreviewContainerBackgroundColor" Value="{DynamicResource TaskbarColor}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.IsSelected}" Value="True">
                                                                        <Setter Property="PreviewContainerBackgroundColor" Value="Transparent" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </tile:MultiItemPresenter.Style>
                                                    </tile:MultiItemPresenter>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!--<MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="True" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:MultiItem ClipboardViewItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.ViewItem}" IsFadeInEnabled="{Binding Path=IsFadeInOfItemsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:FullClipboardListView}}}">
                                                            <tile:MultiItem.Height>
                                                                <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                    <Binding Path="ClipboardViewItemMaxHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                    <Binding>
                                                                        <Binding.Source>
                                    -->
                                    <!--  pad the height so that it matches the total height of the single view items  -->
                                    <!--
                                                                            <sys:Double>60</sys:Double>
                                                                        </Binding.Source>
                                                                    </Binding>
                                                                </MultiBinding>
                                                            </tile:MultiItem.Height>
                                                            <tile:MultiItem.Style>
                                                                <Style BasedOn="{StaticResource MultiItemStyleForSubItems_EventTriggersStyle}" TargetType="{x:Type tile:MultiItem}">
                                                                    <Setter Property="PreviewContainerBackgroundColor" Value="{DynamicResource TaskbarColor}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.IsSelected}" Value="True">
                                                                            <Setter Property="PreviewContainerBackgroundColor" Value="Transparent" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </tile:MultiItem.Style>
                                                        </tile:MultiItem>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="True" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:MultiItemLoading
                                                            IsFadeInEnabled="False"
                                                            IsLoadingIndicatorFadeInEnabled="{Binding Path=IsFadeInOfItemsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:FullClipboardListView}}}"
                                                            IsShownIntoView="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.IsShownIntoView}"
                                                            NumberOfItemsWithoutPreview="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.NumberOfItemsWithoutPreview}"
                                                            PreviewContainerBackgroundColor="{DynamicResource TaskbarColor}"
                                                            ViewSubItemDimensions="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.Dimensions, Mode=OneWay}">
                                                            <tile:MultiItemLoading.Height>
                                                                <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                    <Binding Path="ClipboardViewItemMaxHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                    <Binding>
                                                                        <Binding.Source>
                                    -->
                                    <!--  pad the height so that it matches the total height of the single view items  -->
                                    <!--
                                                                            <sys:Double>60</sys:Double>
                                                                        </Binding.Source>
                                                                    </Binding>
                                                                </MultiBinding>
                                                            </tile:MultiItemLoading.Height>
                                                        </tile:MultiItemLoading>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>-->
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>

                    </ContentControl>

                </Grid>
            </Border>
        </DataTemplate>
    </ListView.ItemTemplate>
</lv:ClipboardListViewBase>
