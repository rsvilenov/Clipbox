                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=True}" Value="True" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="False" />
