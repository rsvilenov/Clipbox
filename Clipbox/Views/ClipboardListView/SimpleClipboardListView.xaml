<lv:ClipboardListViewBase
    x:Class="Clipbox.Views.ClipboardListView.SimpleClipboardListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:localBindableObjects="clr-namespace:Clipbox.ViewModels.BindableObjects"
    xmlns:lv="clr-namespace:Clipbox.Views.ClipboardListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:tile="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    xmlns:vis="clr-namespace:Clipbox.Infrastructure.UI.Visuals;assembly=Clipbox.Infrastructure.UI"
    VerticalAlignment="Stretch"
    VerticalContentAlignment="Top"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    BorderThickness="0"
    ItemsSource="{Binding ClipboardViewItemWrappers}"
    ScrollViewer.HorizontalScrollBarVisibility="Auto"
    ScrollViewer.VerticalScrollBarVisibility="Hidden"
    mc:Ignorable="d">
    <ListView.Resources>
        <conv:BitmapToBitmapImageConverter x:Key="BitmapToBitmapImageConverter" />
        <conv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <infConv:OrMultiValueConverter x:Key="OrMultiValueConverter" />
        <infConv:AndMultiValueConverter x:Key="AndMultiValueConverter" />
        <infConv:MathMultiplyConverter x:Key="MathMultiplyConverter" />
        <infConv:BooleanToVisibilityHiddenConverter x:Key="BooleanToVisibilityHiddenConverter" />
        <infConv:MathAddConverter x:Key="MathAddConverter" />
        <infConv:IsEqualOrGreaterThanConverter x:Key="IsEqualOrGreaterThanConverter" />
        <infConv:NullOrEmptyCollectionToBoolConverter x:Key="NullOrEmptyCollectionToBoolConverter" />
        <conv:ContentClassListContainsConverter x:Key="ContentClassListContainsConverter" />
        <conv:ObjectTypeCompareConverter x:Key="ObjectTypeCompareConverter" />

        <!--  we cannot subscribe to an event in an inline style, so we need a resource for circumventing this limitation of WPF  -->
        <Style x:Key="MultiItemPresenterStyleForSubItems_EventTriggersStyle" TargetType="{x:Type tile:MultiItemPresenter}">
            <EventSetter Event="Unloaded" Handler="MultiItemPresenter_Unloaded" />
            <EventSetter Event="Loaded" Handler="MultiItemPresenter_Loaded" />
        </Style>
    </ListView.Resources>
    <i:Interaction.Behaviors>
        <localBeh:ListViewScrollButtonBehavior ButtonScrollDirection="Up" ScrollButton="{Binding ScrollUpButton, RelativeSource={RelativeSource AncestorType={x:Type lv:ClipboardListViewBase}}}" />
        <localBeh:ListViewScrollButtonBehavior ButtonScrollDirection="Down" ScrollButton="{Binding ScrollDownButton, RelativeSource={RelativeSource AncestorType={x:Type lv:ClipboardListViewBase}}}" />
    </i:Interaction.Behaviors>

    <!--  Remove the default highlighting on mouse over  -->
    <ListView.ItemContainerStyle>
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewItemLoaded}" Value="False">
                    <!--  disable the selection of the item  -->
                    <Setter Property="Focusable" Value="False" />
                    <!--  disable the mouse events for the item, as there are triggers on them (the mouseover border for example)  -->
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ListView.ItemContainerStyle>

    <ListView.ItemsPanel>
        <ItemsPanelTemplate>
            <!--<vis:AutoWrapPanel ItemMinHeight="150" ItemMinWidth="150" />-->
            <vis:AutoWrapPanel />
        </ItemsPanelTemplate>
    </ListView.ItemsPanel>
    <ListView.ItemTemplate>
        <DataTemplate>
            <Border
                Margin="5"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                SnapsToDevicePixels="True">
                <Border.Style>

                    <Style TargetType="{x:Type Border}">
                        <Setter Property="IsManipulationEnabled" Value="False" />
                        <Style.Triggers>
                            <!--  use IsManipulationEnabled as a bindable flag, indicating that the mouse is over the item  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="IsManipulationEnabled" Value="True" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid
                    MinWidth="100"
                    MinHeight="100"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  selected/mouseover indicator  -->
                    <Border
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.IsSelected}" Value="True" />
                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.7" Color="{DynamicResource AccentColor}" />
                                            </Setter.Value>
                                        </Setter>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsManipulationEnabled, RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.IsSelected}" Value="False" />
                                            <Condition Binding="{Binding IsSelected}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.3" Color="{DynamicResource AccentColor}" />
                                            </Setter.Value>
                                        </Setter>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <ContentControl
                        Grid.Row="0"
                        Margin="5,3,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsViewItemLoaded}" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"
                                                        DataContext="{Binding Path=DataContext.ViewItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <tile:ContentTypeIconBand
                                                            Grid.Column="0"
                                                            MaxHeight="30"
                                                            ContentClasses="{Binding ContentClasses}"
                                                            IsGroupItem="{Binding Converter={StaticResource ObjectTypeCompareConverter}, ConverterParameter={x:Type localBindableObjects:ClipboardViewItemGroup}}">
                                                            <i:Interaction.Behaviors>
                                                                <infBeh:FrameworkElementDpiScalingBehavior />
                                                            </i:Interaction.Behaviors>
                                                        </tile:ContentTypeIconBand>

                                                        <!--<Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" Width="1" Height="15" Fill="#e4e4e6" Margin="5,0,0,0" />


                                                                    <Image MaxHeight="17" Margin="5"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        Source="{Binding SourceWindowIcon}" ToolTip="{Binding SourceWindowDescription}" Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}" />-->


                                                        <Grid Grid.Column="2">
                                                            <ToggleButton
                                                                Name="tglBtn"
                                                                MaxWidth="25"
                                                                Margin="0,0,5,0"
                                                                Command="{Binding Path=ActionButtonsDataContext.PinUnpinClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                                CommandParameter="{Binding}"
                                                                IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                                Style="{DynamicResource ToggleBtnPin}">
                                                                <i:Interaction.Behaviors>
                                                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                                                    <localBeh:ToggleButtonToolTipBehavior CheckedToolTipText="{loc:Localize TTP_QUICKVIEW_UNPIN_ITEM}" UncheckedToolTipText="{loc:Localize TTP_QUICKVIEW_PIN_ITEM}" />
                                                                </i:Interaction.Behaviors>
                                                            </ToggleButton>

                                                            <!--  Visible only if the ListViewItem is highlighted or selected (IsManipulationEnabled = true) OR the toggle button is checked  -->
                                                            <Grid.IsEnabled>
                                                                <MultiBinding Converter="{StaticResource OrMultiValueConverter}">
                                                                    <Binding Path="IsManipulationEnabled" RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                    <Binding Path="IsPinned" />
                                                                </MultiBinding>
                                                            </Grid.IsEnabled>
                                                            <Grid.Visibility>
                                                                <Binding
                                                                    Converter="{StaticResource BooleanToVisibilityHiddenConverter}"
                                                                    Path="IsEnabled"
                                                                    RelativeSource="{RelativeSource Self}" />
                                                            </Grid.Visibility>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ElementName=tglBtn, Path=IsEnabled}" Value="False">
                                                                            <Setter Property="ToolTip" Value="{loc:Localize TTP_QUICKVIEW_MAX_PINNED_ITEMS_REACHED}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                        </Grid>


                                                        <ContentControl Grid.Column="3">
                                                            <ContentControl.Style>
                                                                <Style TargetType="{x:Type ContentControl}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Path=IsManipulationEnabled, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True" />
                                                                                <Condition Binding="{Binding Path=IsPinned}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                            <Button
                                                                MaxWidth="25"
                                                                Margin="0,0,5,0"
                                                                Command="{Binding Path=ActionButtonsDataContext.RemoveClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{DynamicResource BtnXRemove}"
                                                                ToolTip="{loc:Localize TTP_QUICKVIEW_REMOVE_ITEM}"
                                                                Visibility="{Binding Path=IsManipulationEnabled, RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <i:Interaction.Behaviors>
                                                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                                                </i:Interaction.Behaviors>
                                                            </Button>
                                                        </ContentControl>

                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>


                    <Rectangle
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Fill="{DynamicResource TaskbarColorBrush}"
                        Opacity="0.3">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsManipulationEnabled, RelativeSource={RelativeSource AncestorType=Border}}" Value="False" />
                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.IsSelected}" Value="False" />
                                            <Condition Binding="{Binding IsSelected}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>


                    <!--  view item tile  -->
                    <ContentControl
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="False">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <tile:SingleItemPresenter
                                                        IsFadeInEnabled="{Binding Path=IsFadeInOfItemsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:FullClipboardListView}}}"
                                                        IsLoadingFadeInEnabled="False"
                                                        IsLoadingIndicatorFadeInEnabled="True"
                                                        IsShownIntoView="True"
                                                        PreviewContainerBackgroundColor="{DynamicResource TaskbarColor}"
                                                        ThumbnailAreaMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}}"
                                                        ThumbnailAreaMinHeight="{Binding Path=ThumbnailAreaMaxHeight, RelativeSource={RelativeSource Mode=Self}}"
                                                        ViewItemWrapper="{Binding Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=DataContext}">
                                                        <tile:SingleItemPresenter.IsDimmed>
                                                            <MultiBinding Converter="{StaticResource AndMultiValueConverter}">
                                                                <Binding
                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                    Path="IsManipulationEnabled"
                                                                    RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                <Binding Path="DimNonFocusedItems" RelativeSource="{RelativeSource AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                <Binding
                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                    Path="DataContext.IsSelected"
                                                                    RelativeSource="{RelativeSource AncestorType={x:Type ListViewItem}}" />
                                                            </MultiBinding>
                                                        </tile:SingleItemPresenter.IsDimmed>
                                                    </tile:SingleItemPresenter>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <tile:MultiItemPresenter
                                                        IsFadeInEnabled="{Binding Path=IsFadeInOfItemsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:FullClipboardListView}}}"
                                                        IsLoadingFadeInEnabled="False"
                                                        IsLoadingIndicatorFadeInEnabled="True"
                                                        IsShownIntoView="False"
                                                        PreviewContainerBackgroundColor="{DynamicResource TaskbarColor}"
                                                        ViewItemWrapper="{Binding Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=DataContext}">

                                                        <tile:MultiItemPresenter.Height>
                                                            <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                <Binding Path="ClipboardViewItemMaxHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                <Binding>
                                                                    <Binding.Source>
                                                                        <!--  pad the height so that it matches the total height of the single view items  -->

                                                                        <sys:Double>60</sys:Double>
                                                                    </Binding.Source>
                                                                </Binding>
                                                            </MultiBinding>
                                                        </tile:MultiItemPresenter.Height>
                                                        <tile:MultiItemPresenter.IsDimmed>
                                                            <MultiBinding Converter="{StaticResource AndMultiValueConverter}">
                                                                <Binding
                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                    Path="IsManipulationEnabled"
                                                                    RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                <Binding Path="DimNonFocusedItems" RelativeSource="{RelativeSource AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                <Binding
                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                    Path="DataContext.IsSelected"
                                                                    RelativeSource="{RelativeSource AncestorType={x:Type ListViewItem}}" />
                                                            </MultiBinding>
                                                        </tile:MultiItemPresenter.IsDimmed>
                                                        <tile:MultiItemPresenter.Style>
                                                            <Style BasedOn="{StaticResource MultiItemPresenterStyleForSubItems_EventTriggersStyle}" TargetType="{x:Type tile:MultiItemPresenter}">
                                                                <Setter Property="PreviewContainerBackgroundColor" Value="{DynamicResource TaskbarColor}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.IsSelected}" Value="True">
                                                                        <Setter Property="PreviewContainerBackgroundColor" Value="Transparent" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </tile:MultiItemPresenter.Style>
                                                    </tile:MultiItemPresenter>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <!--<MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="False" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:SingleItemLoading
                                                            IsFadeInEnabled="False"
                                                            IsLoadingIndicatorFadeInEnabled="{Binding Path=IsFadeInOfItemsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:FullClipboardListView}}}"
                                                            IsShownIntoView="True"
                                                            ThumbnailAreaMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}}"
                                                            ThumbnailAreaMinHeight="{Binding Path=ThumbnailAreaMaxHeight, RelativeSource={RelativeSource Mode=Self}}"
                                                            ViewItemDimensions="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.Dimensions[0], FallbackValue={x:Null}}" />
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="False" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:SingleItem
                                                            ClipboardViewItem="{Binding Path=DataContext.ViewItem, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                            IsFadeInEnabled="False"
                                                            ThumbnailAreaMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}}"
                                                            ThumbnailAreaMinHeight="{Binding Path=ThumbnailAreaMaxHeight, RelativeSource={RelativeSource Mode=Self}}">
                                    -->
                                    <!--
                                        Set MinWidth to the tile.
                                        If the preview is too narrow, when the buttons appear, the tile expands and this cause flickering.
                                        This may lead to tiles moving to the next line on mouseover, which makes them impossible to be clicked.
                                    -->
                                    <!--
                                                            <tile:SingleItem.MinWidth>150</tile:SingleItem.MinWidth>
                                    -->
                                    <!--  If the setting DimNonFocusedItems is set to true, the tiles are dimmed when they are not highlighted or selected.  -->
