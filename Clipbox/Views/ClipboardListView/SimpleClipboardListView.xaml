                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>-->
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>

                    </ContentControl>
                </Grid>
            </Border>

        </DataTemplate>
    </ListView.ItemTemplate>
</lv:ClipboardListViewBase>
