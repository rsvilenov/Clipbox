<lv:ClipboardListViewBase
    x:Class="Clipbox.Views.ClipboardListView.SimpleClipboardListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:localBindableObjects="clr-namespace:Clipbox.ViewModels.BindableObjects"
    xmlns:lv="clr-namespace:Clipbox.Views.ClipboardListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:tile="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    xmlns:vis="clr-namespace:Clipbox.Infrastructure.UI.Visuals;assembly=Clipbox.Infrastructure.UI"
    VerticalAlignment="Stretch"
    VerticalContentAlignment="Top"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    BorderThickness="0"
    ItemsSource="{Binding ClipboardViewItemWrappers}"
    ScrollViewer.HorizontalScrollBarVisibility="Auto"
    ScrollViewer.VerticalScrollBarVisibility="Hidden"
    mc:Ignorable="d">
    <ListView.Resources>
        <conv:BitmapToBitmapImageConverter x:Key="BitmapToBitmapImageConverter" />
        <conv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <infConv:OrMultiValueConverter x:Key="OrMultiValueConverter" />
        <infConv:AndMultiValueConverter x:Key="AndMultiValueConverter" />
        <infConv:MathMultiplyConverter x:Key="MathMultiplyConverter" />
        <infConv:BooleanToVisibilityHiddenConverter x:Key="BooleanToVisibilityHiddenConverter" />
        <infConv:MathAddConverter x:Key="MathAddConverter" />
        <infConv:IsEqualOrGreaterThanConverter x:Key="IsEqualOrGreaterThanConverter" />
        <infConv:NullOrEmptyCollectionToBoolConverter x:Key="NullOrEmptyCollectionToBoolConverter" />
        <conv:ContentClassListContainsConverter x:Key="ContentClassListContainsConverter" />
        <conv:ObjectTypeCompareConverter x:Key="ObjectTypeCompareConverter" />

        <!--  we cannot subscribe to an event in an inline style, so we need a resource for circumventing this limitation of WPF  -->
        <Style x:Key="MultiItemStyleForSubItems_EventTriggersStyle" TargetType="{x:Type tile:MultiItem}">
            <EventSetter Event="Unloaded" Handler="MultiItem_Unloaded" />
            <EventSetter Event="Loaded" Handler="MultiItem_Loaded" />
        </Style>
    </ListView.Resources>
    <i:Interaction.Behaviors>
        <localBeh:ListViewScrollButtonBehavior ButtonScrollDirection="Up" ScrollButton="{Binding ScrollUpButton, RelativeSource={RelativeSource AncestorType={x:Type lv:ClipboardListViewBase}}}" />
        <localBeh:ListViewScrollButtonBehavior ButtonScrollDirection="Down" ScrollButton="{Binding ScrollDownButton, RelativeSource={RelativeSource AncestorType={x:Type lv:ClipboardListViewBase}}}" />
    </i:Interaction.Behaviors>

    <!--  Remove the default highlighting on mouse over  -->
    <ListView.ItemContainerStyle>
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border
                            x:Name="Bd"
                            Margin="5"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                            <!--  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"  -->

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <!--<Setter Property="Background" TargetName="Bd" Value="Blue"/>-->
                                <Setter TargetName="Bd" Property="BorderBrush" Value="DarkGray" />
                                <!--<Setter Property="BorderThickness" TargetName="Bd" Value="2"/>-->

                            </MultiTrigger>
                            <!--<MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource AccentLight3Brush}"/>
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource AccentLight3Brush}"/>
                                    </MultiTrigger>-->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <!--<Condition Binding="{Binding Selector.IsSelectionActive, RelativeSource={RelativeSource Self}}" Value="False" />-->
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Path=IsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLight3Brush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <!--<Condition Binding="{Binding Selector.IsSelectionActive, RelativeSource={RelativeSource Self}}" Value="True" />-->
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Path=IsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLight3Brush}" />
                            </MultiDataTrigger>
                            <!--<Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    </Trigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewItemLoaded}" Value="False">
                    <!--  disable the selection of the item  -->
                    <Setter Property="Focusable" Value="False" />
                    <!--  disable the mouse events for the item, as there are triggers on them (the mouseover border for example)  -->
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ListView.ItemContainerStyle>

    <ListView.ItemsPanel>
        <ItemsPanelTemplate>
            <!--<vis:AutoWrapPanel ItemMinHeight="150" ItemMinWidth="150" />-->
            <vis:AutoWrapPanel />
        </ItemsPanelTemplate>
    </ListView.ItemsPanel>
    <ListView.ItemTemplate>
        <DataTemplate>
            <Border Background="Transparent" BorderThickness="0">
                <Border.Style>

                    <Style TargetType="{x:Type Border}">
                        <Setter Property="IsManipulationEnabled" Value="False" />
                        <Style.Triggers>
                            <!--  use IsManipulationEnabled as a bindable flag, indicating that the mouse is over the item  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="IsManipulationEnabled" Value="True" />
                            </Trigger>
                            <!--
                                When the last selected item is uncombinable with the previous item(s)
                                show that to the user by running the red animation
                            -->
                            <DataTrigger Binding="{Binding Path=ViewItem.IsItemAnimationRunRequested}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="Flash">
                                        <Storyboard FillBehavior="Stop">
                                            <!--
                                                since wpf wants to freeze the storyboard, we cannot use dynamic resources here...
                                                From="{DynamicResource AccentBrush}"
                                                To="{DynamicResource AccentLight3Brush}"
                                            -->
                                            <ColorAnimation
                                                AutoReverse="True"
                                                FillBehavior="HoldEnd"
                                                RepeatBehavior="1x"
                                                Storyboard.TargetProperty="Background.Color"
                                                To="Red"
                                                Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid
                    MinWidth="100"
                    MinHeight="100"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ContentControl
                        Grid.Row="0"
                        Margin="5,3,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsViewItemLoaded}" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"
                                                        DataContext="{Binding Path=DataContext.ViewItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <tile:ItemTypeIconBand
                                                            Grid.Column="0"
                                                            MaxHeight="30"
                                                            ContentClasses="{Binding ContentClasses}"
                                                            IsGroupItem="{Binding Converter={StaticResource ObjectTypeCompareConverter}, ConverterParameter={x:Type localBindableObjects:ClipboardViewItemGroup}}">
                                                            <i:Interaction.Behaviors>
                                                                <infBeh:FrameworkElementDpiScalingBehavior />
                                                            </i:Interaction.Behaviors>
                                                        </tile:ItemTypeIconBand>

                                                        <!--<Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" Width="1" Height="15" Fill="#e4e4e6" Margin="5,0,0,0" />


                                                                    <Image MaxHeight="17" Margin="5"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        Source="{Binding SourceWindowIcon}" ToolTip="{Binding SourceWindowCaption}" Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}" />-->



                                                        <ToggleButton
                                                            Grid.Column="2"
                                                            MaxWidth="25"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding Path=ActionButtonsDataContext.PinUnpinClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                            CommandParameter="{Binding}"
                                                            IsChecked="{Binding IsPinned}"
                                                            Style="{DynamicResource ToggleBtnPin}">
                                                            <i:Interaction.Behaviors>
                                                                <infBeh:FrameworkElementDpiScalingBehavior />
                                                            </i:Interaction.Behaviors>
                                                            <!--  Visible only if the ListViewItem is highlighted or selected (IsManipulationEnabled = true) OR the toggle button is checked  -->
                                                            <ToggleButton.IsEnabled>
                                                                <MultiBinding Converter="{StaticResource OrMultiValueConverter}">
                                                                    <Binding Path="IsManipulationEnabled" RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                    <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                                                </MultiBinding>
                                                            </ToggleButton.IsEnabled>
                                                            <ToggleButton.Visibility>
                                                                <Binding
                                                                    Converter="{StaticResource BooleanToVisibilityHiddenConverter}"
                                                                    Path="IsEnabled"
                                                                    RelativeSource="{RelativeSource Self}" />
                                                            </ToggleButton.Visibility>
                                                            <ToggleButton.ToolTip>
                                                                <!--
                                                                    the tooltip is not part of the visual tree, so we need to set its datacontext to that of
                                                                    its placement target, in our case - the toggle button. Only then can we bind to properties
                                                                    of that button.
                                                                    https://wpf.2000things.com/2011/08/30/375-binding-something-in-a-tooltip-to-a-property-on-the-parent-control/
                                                                -->
                                                                <ToolTip DataContext="{Binding Path=PlacementTarget, RelativeSource={x:Static RelativeSource.Self}}">
                                                                    <ToolTip.Style>
                                                                        <Style TargetType="{x:Type ToolTip}">
                                                                            <Setter Property="Content" Value="Pin item" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Path=IsChecked}" Value="True">
                                                                                    <Setter Property="Content" Value="Unpin item" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ToolTip.Style>
                                                                </ToolTip>
                                                            </ToggleButton.ToolTip>
                                                        </ToggleButton>

                                                        <ContentControl Grid.Column="3">
                                                            <ContentControl.Style>
                                                                <Style TargetType="{x:Type ContentControl}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Path=IsManipulationEnabled, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True" />
                                                                                <Condition Binding="{Binding Path=IsPinned}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                            <Button
                                                                MaxWidth="25"
                                                                Margin="0,0,5,0"
                                                                Command="{Binding Path=ActionButtonsDataContext.RemoveClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{DynamicResource BtnClose}"
                                                                ToolTip="Remove the item from view"
                                                                Visibility="{Binding Path=IsManipulationEnabled, RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <i:Interaction.Behaviors>
                                                                    <infBeh:FrameworkElementDpiScalingBehavior />
                                                                </i:Interaction.Behaviors>
                                                            </Button>
                                                        </ContentControl>

                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>


                    <Rectangle
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Fill="{DynamicResource TaskbarColorBrush}"
                        IsEnabled="{Binding Path=IsManipulationEnabled, RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource InverseBooleanConverter}}"
                        Opacity="0.3"
                        Visibility="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />


                    <!--  view item tile  -->
                    <ContentControl
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="False" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:SingleItemLoading
                                                            ThumbnailAreaMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}}"
                                                            ThumbnailAreaMinHeight="{Binding Path=ThumbnailAreaMaxHeight, RelativeSource={RelativeSource Mode=Self}}"
                                                            ViewItemDimensions="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.Dimensions[0], FallbackValue={x:Null}}" />
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="False" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:SingleItem
                                                            ClipboardViewItem="{Binding Path=DataContext.ViewItem, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                            ThumbnailAreaMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}}"
                                                            ThumbnailAreaMinHeight="{Binding Path=ThumbnailAreaMaxHeight, RelativeSource={RelativeSource Mode=Self}}">
                                                            <!--
                                                                Set MinWidth to the tile.
                                                                If the preview is too narrow, when the buttons appear, the tile expands and this cause flickering.
                                                                This may lead to tiles moving to the next line on mouseover, which makes them impossible to be clicked.
                                                            -->
                                                            <tile:SingleItem.MinWidth>150</tile:SingleItem.MinWidth>
                                                            <!--  If the setting DimNonFocusedItems is set to true, the tiles are dimmed when they are not highlighted or selected.  -->
                                                            <tile:SingleItem.IsDimmed>
                                                                <MultiBinding Converter="{StaticResource AndMultiValueConverter}">
                                                                    <Binding
                                                                        Converter="{StaticResource InverseBooleanConverter}"
                                                                        Path="IsManipulationEnabled"
                                                                        RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                    <Binding Path="DimNonFocusedItems" RelativeSource="{RelativeSource AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                    <Binding
                                                                        Converter="{StaticResource InverseBooleanConverter}"
                                                                        Path="DataContext.IsSelected"
                                                                        RelativeSource="{RelativeSource AncestorType={x:Type ListViewItem}}" />
                                                                </MultiBinding>
                                                            </tile:SingleItem.IsDimmed>
                                                        </tile:SingleItem>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=True}" Value="True" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:MultiItemLoading NumberOfItemsWithoutPreview="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.NumberOfItemsWithoutPreview, FallbackValue=0}" ViewSubItemDimensions="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.Dimensions, FallbackValue={x:Null}, Mode=OneWay}">
                                                            <tile:MultiItemLoading.Height>
                                                                <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                    <Binding Path="ClipboardViewItemMaxHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                    <Binding>
                                                                        <Binding.Source>

                                                                            <!--  pad the height so that it matches the total height of the single view items  -->

                                                                            <sys:Double>60</sys:Double>
                                                                        </Binding.Source>
                                                                    </Binding>
                                                                </MultiBinding>
                                                            </tile:MultiItemLoading.Height>
                                                        </tile:MultiItemLoading>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="True" />
                                            <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <tile:MultiItem ClipboardViewItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=DataContext.ViewItem}" Style="{StaticResource MultiItemStyleForSubItems_EventTriggersStyle}">
                                                            <tile:MultiItem.Height>
                                                                <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                    <Binding Path="ClipboardViewItemMaxHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                    <Binding>
                                                                        <Binding.Source>
                                                                            <!--  pad the height so that it matches the total height of the single view items  -->
                                                                            <sys:Double>60</sys:Double>
                                                                        </Binding.Source>
                                                                    </Binding>
                                                                </MultiBinding>
                                                            </tile:MultiItem.Height>
                                                            <tile:MultiItem.IsDimmed>
                                                                <MultiBinding Converter="{StaticResource AndMultiValueConverter}">
                                                                    <Binding
                                                                        Converter="{StaticResource InverseBooleanConverter}"
                                                                        Path="IsManipulationEnabled"
                                                                        RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                    <Binding Path="DimNonFocusedItems" RelativeSource="{RelativeSource AncestorType={x:Type lv:ClipboardListViewBase}}" />
                                                                    <Binding
                                                                        Converter="{StaticResource InverseBooleanConverter}"
                                                                        Path="DataContext.IsSelected"
                                                                        RelativeSource="{RelativeSource AncestorType={x:Type ListViewItem}}" />
                                                                </MultiBinding>
                                                            </tile:MultiItem.IsDimmed>
                                                        </tile:MultiItem>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>

                    </ContentControl>
                </Grid>
            </Border>

        </DataTemplate>
    </ListView.ItemTemplate>
</lv:ClipboardListViewBase>
