<UserControl
    x:Class="Clipbox.Views.DateRangeSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Clipbox.Views"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:MillisecondsToHumanReadableDateStringConverter x:Key="MillisecondsToHumanReadableDateStringConverter" />
    </UserControl.Resources>
    <Border
        x:Name="mainBorder"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1">
        <Grid Margin="15" Background="{DynamicResource TaskbarColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="1.3*" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Template="{DynamicResource DateSelectionIcon}" />
                <StackPanel
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock FontSize="14" Foreground="White">
                        <Run Text="Show items from " />
                        <Run FontWeight="Bold" Text="{Binding SelectedMinDateTimeMs, Converter={StaticResource MillisecondsToHumanReadableDateStringConverter}}" />
                    </TextBlock>
                    <TextBlock
                        FontSize="14"
                        Foreground="White"
                        Visibility="{Binding AreMinAndMaxSelectedDatesDistinct, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Run Text=" to " />
                        <Run FontWeight="Bold" Text="{Binding SelectedMaxDateTimeMs, Converter={StaticResource MillisecondsToHumanReadableDateStringConverter}}" />
                    </TextBlock>
                </StackPanel>

            </Grid>

            <views:RangeSlider
                x:Name="rangeSlider"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="15,25,15,0"
                VerticalAlignment="Top"
                LowerValue="{Binding SelectedMinDateTimeMs, Mode=OneWayToSource}"
                Maximum="{Binding MaxDateTimeMs}"
                Minimum="{Binding MinDateTimeMs}"
                UpperValue="{Binding SelectedMaxDateTimeMs, Mode=OneWayToSource}" />

            <Button
                x:Name="btnOk"
                Grid.Row="2"
                Grid.Column="0"
                Width="70"
                Height="30"
                Margin="5"
                Click="BtnOk_Click"
                Content="OK"
                Foreground="White"
                Style="{DynamicResource BtnOk}" />

            <Button
                x:Name="btnCancel"
                Grid.Row="2"
                Grid.Column="1"
                Width="70"
                Height="30"
                Margin="5"
                Click="BtnCancel_Click"
                Content="Cancel"
                Foreground="White"
                Style="{DynamicResource BtnCancel}" />
        </Grid>
    </Border>
</UserControl>
