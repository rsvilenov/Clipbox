<local:ClipboardViewControlBase
    x:Class="Clipbox.Views.QuickViewClipboardContents"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bo="clr-namespace:Clipbox.ViewModels.BindableObjects"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:infEnums="clr-namespace:Clipbox.Core.Enums;assembly=Clipbox.Core"
    xmlns:infPropAp="clr-namespace:Clipbox.Infrastructure.UI.AttachedProperties;assembly=Clipbox.Infrastructure.UI"
    xmlns:infWindows="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:localBindableObjects="clr-namespace:Clipbox.ViewModels.BindableObjects"
    xmlns:localEnums="clr-namespace:Clipbox.ViewModels.Enums"
    xmlns:lv="clr-namespace:Clipbox.Views.ClipboardListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:tile="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    xmlns:vis="clr-namespace:Clipbox.Infrastructure.UI.Visuals;assembly=Clipbox.Infrastructure.UI"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BitmapToBitmapImageConverter x:Key="BitmapToBitmapImageConverter" />
        <conv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <infConv:OrMultiValueConverter x:Key="OrMultiValueConverter" />
        <infConv:AndMultiValueConverter x:Key="AndMultiValueConverter" />
        <infConv:MathMultiplyConverter x:Key="MathMultiplyConverter" />
        <infConv:BooleanToVisibilityHiddenConverter x:Key="BooleanToVisibilityHiddenConverter" />
        <infConv:MathAddConverter x:Key="MathAddConverter" />
        <infConv:IsEqualOrGreaterThanConverter x:Key="IsEqualOrGreaterThanConverter" />
        <infConv:NullOrEmptyCollectionToBoolConverter x:Key="NullOrEmptyCollectionToBoolConverter" />
        <conv:ContentClassListContainsConverter x:Key="ContentClassListContainsConverter" />
        <conv:ObjectTypeCompareConverter x:Key="ObjectTypeCompareConverter" />

        <!--  we cannot subscribe to an event in an inline style, so we need a resource for circumventing this limitation of WPF  -->
        <Style x:Key="MultiItemStyleForSubItems_EventTriggersStyle" TargetType="{x:Type tile:MultiItem}">
            <EventSetter Event="SubItems_SelectionChanged" Handler="MultiItem_SubItems_SelectionChanged" />
            <EventSetter Event="Unloaded" Handler="MultiItem_Unloaded" />
            <EventSetter Event="Loaded" Handler="MultiItem_Loaded" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <!--  Height="Auto" makes the listview unable to show its scrollviewer...  -->
            <RowDefinition />
            <!--  this is the row for the bottom buttons (extensions, clear clipboard, etc...)  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  loading indication panel  -->
        <Grid Grid.Row="0">
            <Grid.Style>

                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ClipboardItemsLoadingStage}" Value="{x:Static localEnums:ClipboardItemsLoadingStage.ViewItemsLoaded}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ContentControl
                x:Name="LoadingIndicator"
                Width="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Gray"
                Template="{DynamicResource MainLoadingIcon}" />

        </Grid>

        <!--  label "No contents"  -->
        <TextBlock
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            FontSize="16"
            Foreground="White"
            Text="{loc:Localize LBL_QV_NO_CLIPBOARD_ITEMS}"
            TextWrapping="WrapWithOverflow">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ClipboardItemsLoadingStage}" Value="{x:Static localEnums:ClipboardItemsLoadingStage.ViewItemsLoaded}" />
                                <Condition Binding="{Binding ClipboardViewItemWrappers.Count}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <i:Interaction.Behaviors>
                <infBeh:FrameworkElementDpiScalingBehavior />
            </i:Interaction.Behaviors>
        </TextBlock>

        <!--  clipboard contents grid  -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.Style>
                <!--
                    show this grid after the wrappers have been loaded,
                    the whole control - resized accordingly and the view items
                    have been loaded as well
                -->
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ClipboardItemsLoadingStage}" Value="{x:Static localEnums:ClipboardItemsLoadingStage.ViewItemsLoaded}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Button
                Name="BtnScrollUp"
                Grid.Row="0"
                Grid.Column="2"
                Height="25"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Style="{DynamicResource BtnArrowUp}" />
            <Button
                Name="BtnScrollDown"
                Grid.Row="2"
                Grid.Column="2"
                Height="25"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Style="{DynamicResource BtnArrowDown}" />

            <!--
                MaxHeight="{Binding RelativeSource={RelativeSource FindAncestor,
                AncestorType={x:Type Grid}},
                Path=RowDefinitions[0].MaxHeight}"
            -->
            <lv:SimpleClipboardListView
                x:Name="MainListView"
                Grid.Row="1"
                Margin="10"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                ClipboardViewItemMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}}"
                CombinabilityCheckRequested="MainListView_CombinabilityCheckRequested"
                DimNonFocusedItems="{Binding Path=DimNonFocusedItems, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}}"
                ItemCanPinRequested="MainListView_ItemCanPinRequested"
                ItemPinUnpinRequested="MainListView_ItemPinUnpinRequested"
                ItemRemovalRequested="MainListView_ItemRemovalRequested"
                ItemsSource="{Binding ClipboardViewItemWrappers}"
                ScrollDownButton="{Binding ElementName=BtnScrollDown}"
                ScrollUpButton="{Binding ElementName=BtnScrollUp}"
                SelectionChangeCompleted="MainListView_SelectionChangeCompleted"
                UncombinableItemsSelected="MainListView_UncombinableItemsSelected" />

        </Grid>

        <!--  footer buttons  -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ClipboardItemsLoadingStage}" Value="{x:Static localEnums:ClipboardItemsLoadingStage.ViewItemsLoaded}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ClipboardViewItemWrappers.Count}" Value="0">
                            <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel
                x:Name="uiExtensionContainer"
                Grid.Column="0"
                Height="35"
                Panel.ZIndex="99">
                <i:Interaction.Behaviors>
                    <infBeh:FrameworkElementDpiScalingBehavior />
                </i:Interaction.Behaviors>
            </WrapPanel>
            <TextBlock
                Name="ErrorTextBlock"
                Grid.Column="0"
                Height="35"
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                Panel.ZIndex="100"
                Background="Transparent"
                FontSize="16"
                Foreground="White"
                Text="{loc:Localize LBL_QV_INCOMPATIBLE_ITEMS}"
                Visibility="Collapsed">
                <i:Interaction.Behaviors>
                    <infBeh:FrameworkElementDpiScalingBehavior />
                </i:Interaction.Behaviors>
            </TextBlock>
            <!--  Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"  -->
            <Button
                Grid.Column="1"
                Width="25"
                Height="25"
                Margin="0,0,5,5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Click="ButtonClearItems_Click"
                Command="{Binding ClearClipboardEntries}"
                IsEnabled="{Binding Path=AreAnyItemsSelected, ElementName=MainListView, Converter={StaticResource InverseBooleanConverter}}"
                Style="{DynamicResource BtnWipe}"
                ToolTip="{loc:Localize BTN_QV_WIPE}">
                <i:Interaction.Behaviors>
                    <infBeh:FrameworkElementDpiScalingBehavior />
                </i:Interaction.Behaviors>
            </Button>
        </Grid>
    </Grid>
</local:ClipboardViewControlBase>
