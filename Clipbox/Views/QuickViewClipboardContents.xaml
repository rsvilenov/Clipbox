<local:ClipboardViewControlBase
    x:Class="Clipbox.Views.QuickViewClipboardContents"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bo="clr-namespace:Clipbox.ViewModels.BindableObjects"
    xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:infEnums="clr-namespace:Clipbox.Core.Enums;assembly=Clipbox.Core"
    xmlns:infPropAp="clr-namespace:Clipbox.Infrastructure.UI.AttachedProperties;assembly=Clipbox.Infrastructure.UI"
    xmlns:infWindows="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
    xmlns:local="clr-namespace:Clipbox.Views"
    xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
    xmlns:localBindableObjects="clr-namespace:Clipbox.ViewModels.BindableObjects"
    xmlns:localEnums="clr-namespace:Clipbox.ViewModels.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:tile="clr-namespace:Clipbox.Views.ClipboardViewItemTile"
    xmlns:vis="clr-namespace:Clipbox.Infrastructure.UI.Visuals;assembly=Clipbox.Infrastructure.UI"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BitmapToBitmapImageConverter x:Key="BitmapToBitmapImageConverter" />
        <conv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <infConv:OrMultiValueConverter x:Key="OrMultiValueConverter" />
        <infConv:AndMultiValueConverter x:Key="AndMultiValueConverter" />
        <infConv:MathMultiplyConverter x:Key="MathMultiplyConverter" />
        <infConv:BooleanToVisibilityHiddenConverter x:Key="BooleanToVisibilityHiddenConverter" />
        <infConv:MathAddConverter x:Key="MathAddConverter" />
        <infConv:IsEqualOrGreaterThanConverter x:Key="IsEqualOrGreaterThanConverter" />
        <infConv:NullOrEmptyCollectionToBoolConverter x:Key="NullOrEmptyCollectionToBoolConverter" />
        <conv:ContentClassListContainsConverter x:Key="ContentClassListContainsConverter" />
        <conv:ObjectTypeCompareConverter x:Key="ObjectTypeCompareConverter" />

        <!--  we cannot subscribe to an event in an inline style, so we need a resource for circumventing this limitation of WPF  -->
        <Style x:Key="MultiItemStyleForSubItems_EventTriggersStyle" TargetType="{x:Type tile:MultiItem}">
            <EventSetter Event="SubItems_SelectionChanged" Handler="MultiItem_SubItems_SelectionChanged" />
            <EventSetter Event="Unloaded" Handler="MultiItem_Unloaded" />
            <EventSetter Event="Loaded" Handler="MultiItem_Loaded" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <!--  Height="Auto" makes the listview unable to show its scrollviewer...  -->
            <RowDefinition />
            <!--  this is the row for the bottom buttons (extentions, clear clipboard, etc...)  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  loading indication panel  -->
        <Grid Grid.Row="0">
            <Grid.Style>

                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ClipboardItemsLoadingStage}" Value="{x:Static localEnums:ClipboardItemsLoadingStage.ViewItemsLoaded}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <vis:SprocketControl
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                Width="60"
                Height="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AlphaTicksPercentage="50"
                InnerRadius="0.3"
                Interval="60"
                IsIndeterminate="True"
                LowestAlpha="50"
                OuterRadius="0.5"
                StartAngle="-90"
                TickColor="White"
                TickCount="12"
                TickStyle="Triangle"
                TickWidth="3" />
        </Grid>

        <!--  label "No contents"  -->
        <Label
            Grid.Row="0"
            Width="250"
            Height="100"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="Transparent"
            Content="The clipboard is empty."
            FontSize="16"
            FontWeight="Bold"
            Foreground="White">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ClipboardItemsLoadingStage}" Value="{x:Static localEnums:ClipboardItemsLoadingStage.WrappersLoaded}" />
                                <Condition Binding="{Binding ClipboardViewItemWrappers.Count}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>

        <!--  clipboard contents grid  -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.Style>
                <!--
                    show this grid after the wrappers have been loaded,
                    the whole control - resized accordingly and the view items
                    have been loaded as well
                -->
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ClipboardItemsLoadingStage}" Value="{x:Static localEnums:ClipboardItemsLoadingStage.ViewItemsLoaded}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Button
                Name="BtnScrollUp"
                Grid.Row="0"
                Grid.Column="2"
                Height="25"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Style="{DynamicResource BtnArrowUp}" />
            <Button
                Name="BtnScrollDown"
                Grid.Row="2"
                Grid.Column="2"
                Height="25"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Style="{DynamicResource BtnArrowDown}" />

            <!--
                MaxHeight="{Binding RelativeSource={RelativeSource FindAncestor,
                AncestorType={x:Type Grid}},
                Path=RowDefinitions[0].MaxHeight}"
            -->
            <ListView
                Name="MainListView"
                Grid.Row="1"
                Margin="10"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding ClipboardViewItemWrappers}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <i:Interaction.Behaviors>
                    <localBeh:ListViewScrollButtonBehavior IsScrollUpButton="True" ScrollButton="{Binding ElementName=BtnScrollUp}" />
                    <localBeh:ListViewScrollButtonBehavior IsScrollUpButton="False" ScrollButton="{Binding ElementName=BtnScrollDown}" />
                </i:Interaction.Behaviors>

                <!--  Remove the default highlighting on mouse over  -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border
                                        x:Name="Bd"
                                        Margin="5"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                        <!--  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"  -->

                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <!--<Setter Property="Background" TargetName="Bd" Value="Blue"/>-->
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="DarkGray" />
                                            <!--<Setter Property="BorderThickness" TargetName="Bd" Value="2"/>-->

                                        </MultiTrigger>
                                        <!--<MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource AccentLight3Brush}"/>
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource AccentLight3Brush}"/>
                                    </MultiTrigger>-->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <!--<Condition Binding="{Binding Selector.IsSelectionActive, RelativeSource={RelativeSource Self}}" Value="False" />-->
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding Path=IsSelected}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLight3Brush}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <!--<Condition Binding="{Binding Selector.IsSelectionActive, RelativeSource={RelativeSource Self}}" Value="True" />-->
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding Path=IsSelected}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLight3Brush}" />
                                        </MultiDataTrigger>
                                        <!--<Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    </Trigger>-->
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--<vis:AutoWrapPanel ItemMinHeight="150" ItemMinWidth="150" />-->
                        <vis:AutoWrapPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" BorderThickness="0">
                            <Border.Style>

                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="IsManipulationEnabled" Value="False" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="IsManipulationEnabled" Value="True" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Path=ViewItem.MarkAsUnselectable}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="Flash">
                                                    <Storyboard FillBehavior="Stop">
                                                        <!--
                                                            since wpf wants to freeze the storyboard, we cannot use dynamic resources here...
                                                            From="{DynamicResource AccentBrush}"
                                                            To="{DynamicResource AccentLight3Brush}"
                                                        -->
                                                        <ColorAnimation
                                                            AutoReverse="True"
                                                            FillBehavior="HoldEnd"
                                                            RepeatBehavior="1x"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="Red"
                                                            Duration="0:0:0.3" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid
                                MinWidth="100"
                                MinHeight="100"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ContentControl
                                    Grid.Row="0"
                                    Margin="5,3,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                    <ContentControl.Style>
                                        <Style TargetType="{x:Type ContentControl}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=IsViewItemLoaded}" Value="True">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Grid
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Center"
                                                                    DataContext="{Binding Path=DataContext.ViewItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <tile:ItemTypeIconBand
                                                                        Grid.Column="0"
                                                                        MaxHeight="30"
                                                                        ContentClasses="{Binding ContentClasses}"
                                                                        IsGroupItem="{Binding Converter={StaticResource ObjectTypeCompareConverter}, ConverterParameter={x:Type localBindableObjects:ClipboardViewItemGroup}}">
                                                                        <i:Interaction.Behaviors>
                                                                            <infBeh:FrameworkElementDpiScalingBehavior />
                                                                        </i:Interaction.Behaviors>
                                                                    </tile:ItemTypeIconBand>

                                                                    <!--<Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" Width="1" Height="15" Fill="#e4e4e6" Margin="5,0,0,0" />


                                                                    <Image MaxHeight="17" Margin="5"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        Source="{Binding SourceWindowIcon}" ToolTip="{Binding SourceWindowCaption}" Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}" />-->



                                                                    <ToggleButton
                                                                        Grid.Column="2"
                                                                        MaxWidth="25"
                                                                        Margin="0,0,5,0"
                                                                        Command="{Binding Path=DataContext.PinUnpinClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsChecked="{Binding IsPinned}"
                                                                        Style="{DynamicResource ToggleBtnStar}">
                                                                        <i:Interaction.Behaviors>
                                                                            <infBeh:FrameworkElementDpiScalingBehavior />
                                                                        </i:Interaction.Behaviors>
                                                                        <!--  Visible only if the ListViewItem is highlighted or selected (IsManipulationEnabled = true) OR the toggle button is checked  -->
                                                                        <ToggleButton.IsEnabled>
                                                                            <MultiBinding Converter="{StaticResource OrMultiValueConverter}">
                                                                                <Binding Path="IsManipulationEnabled" RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                                                            </MultiBinding>
                                                                        </ToggleButton.IsEnabled>
                                                                        <ToggleButton.Visibility>
                                                                            <Binding
                                                                                Converter="{StaticResource BooleanToVisibilityHiddenConverter}"
                                                                                Path="IsEnabled"
                                                                                RelativeSource="{RelativeSource Self}" />
                                                                        </ToggleButton.Visibility>
                                                                    </ToggleButton>

                                                                    <Button
                                                                        Grid.Column="3"
                                                                        MaxWidth="25"
                                                                        Margin="0,0,5,0"
                                                                        Command="{Binding Path=DataContext.DeleteClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{DynamicResource BtnClose}"
                                                                        Visibility="{Binding Path=IsManipulationEnabled, RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <i:Interaction.Behaviors>
                                                                            <infBeh:FrameworkElementDpiScalingBehavior />
                                                                        </i:Interaction.Behaviors>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>


                                <Rectangle
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Fill="{DynamicResource TaskbarColorBrush}"
                                    IsEnabled="{Binding Path=IsManipulationEnabled, RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource InverseBooleanConverter}}"
                                    Opacity="0.3"
                                    Visibility="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />


                                <!--  view item tile  -->
                                <ContentControl
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">
                                    <ContentControl.Style>
                                        <Style TargetType="{x:Type ContentControl}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="False" />
                                                        <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.Setters>
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <tile:SingleItemLoading ViewItemDimensions="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.Dimensions[0], FallbackValue={x:Null}}" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </MultiDataTrigger.Setters>
                                                </MultiDataTrigger>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="False" />
                                                        <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.Setters>
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <tile:SingleItem
                                                                        ClipboardViewItem="{Binding Path=DataContext.ViewItem, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                                        ThumbnailAreaMaxHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}}"
                                                                        ThumbnailAreaMinHeight="{Binding Path=ClipboardViewItemMaxHeight, RelativeSource={RelativeSource Mode=Self}}">
                                                                        <!--
                                                                            Set MinWidth to the tile.
                                                                            If the preview is too narrow, when the buttons appear, the tile expands and this cause flickering.
                                                                            This may lead to tiles moving to the next line on mouseover, which makes them impossible to be clicked.
                                                                        -->
                                                                        <tile:SingleItem.MinWidth>150</tile:SingleItem.MinWidth>
                                                                        <!--  If the setting DimNonFocusedItems is set to true, the tiles are dimmed when they are not highlighted or selected.  -->
                                                                        <tile:SingleItem.IsDimmed>
                                                                            <MultiBinding Converter="{StaticResource AndMultiValueConverter}">
                                                                                <Binding
                                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                                    Path="IsManipulationEnabled"
                                                                                    RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                                <Binding Path="DimNonFocusedItems" RelativeSource="{RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}" />
                                                                                <Binding
                                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                                    Path="DataContext.IsSelected"
                                                                                    RelativeSource="{RelativeSource AncestorType={x:Type ListViewItem}}" />
                                                                            </MultiBinding>
                                                                        </tile:SingleItem.IsDimmed>
                                                                    </tile:SingleItem>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </MultiDataTrigger.Setters>
                                                </MultiDataTrigger>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=True}" Value="True" />
                                                        <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.Setters>
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <tile:MultiItemLoading NumberOfItemsWithoutPreview="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.NumberOfItemsWithoutPreview, FallbackValue=0}" ViewSubItemDimensions="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=DataContext.DimensionInfo.Dimensions, FallbackValue={x:Null}, Mode=OneWay}">
                                                                        <tile:MultiItemLoading.Height>
                                                                            <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                                <Binding Path="ClipboardViewItemMaxHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}" />
                                                                                <Binding>
                                                                                    <Binding.Source>

                                                                                        <!--  pad the height so that it matches the total height of the single view items  -->

                                                                                        <sys:Double>60</sys:Double>
                                                                                    </Binding.Source>
                                                                                </Binding>
                                                                            </MultiBinding>
                                                                        </tile:MultiItemLoading.Height>
                                                                    </tile:MultiItemLoading>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </MultiDataTrigger.Setters>
                                                </MultiDataTrigger>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Path=DimensionInfo.IsViewItemGroup, FallbackValue=False}" Value="True" />
                                                        <Condition Binding="{Binding Path=IsViewItemLoaded}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.Setters>
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <tile:MultiItem ClipboardViewItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=DataContext.ViewItem}" Style="{StaticResource MultiItemStyleForSubItems_EventTriggersStyle}">
                                                                        <tile:MultiItem.Height>
                                                                            <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                                <Binding Path="ClipboardViewItemMaxHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}" />
                                                                                <Binding>
                                                                                    <Binding.Source>
                                                                                        <!--  pad the height so that it matches the total height of the single view items  -->
                                                                                        <sys:Double>60</sys:Double>
                                                                                    </Binding.Source>
                                                                                </Binding>
                                                                            </MultiBinding>
                                                                        </tile:MultiItem.Height>
                                                                        <tile:MultiItem.IsDimmed>
                                                                            <MultiBinding Converter="{StaticResource AndMultiValueConverter}">
                                                                                <Binding
                                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                                    Path="IsManipulationEnabled"
                                                                                    RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
                                                                                <Binding Path="DimNonFocusedItems" RelativeSource="{RelativeSource AncestorType={x:Type local:ClipboardViewControlBase}}" />
                                                                                <Binding
                                                                                    Converter="{StaticResource InverseBooleanConverter}"
                                                                                    Path="DataContext.IsSelected"
                                                                                    RelativeSource="{RelativeSource AncestorType={x:Type ListViewItem}}" />
                                                                            </MultiBinding>
                                                                        </tile:MultiItem.IsDimmed>
                                                                    </tile:MultiItem>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </MultiDataTrigger.Setters>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>

                                </ContentControl>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>


        </Grid>

        <!--  footer buttons  -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ClipboardItemsLoadingStage}" Value="{x:Static localEnums:ClipboardItemsLoadingStage.ViewItemsLoaded}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ClipboardViewItemWrappers.Count}" Value="0">
                            <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel
                x:Name="uiExtentionContainer"
                Grid.Column="0"
                Height="35"
                Panel.ZIndex="99">
                <i:Interaction.Behaviors>
                    <infBeh:FrameworkElementDpiScalingBehavior />
                </i:Interaction.Behaviors>
            </WrapPanel>
            <TextBlock
                Name="ErrorTextBlock"
                Grid.Column="0"
                Height="35"
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                Panel.ZIndex="100"
                Background="Transparent"
                FontSize="16"
                Foreground="White"
                Visibility="Collapsed">
                <i:Interaction.Behaviors>
                    <infBeh:FrameworkElementDpiScalingBehavior />
                </i:Interaction.Behaviors>
            </TextBlock>
            <Button
                Grid.Column="1"
                Width="25"
                Height="25"
                Margin="0,0,5,5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Click="ButtonClearItems_Click"
                Command="{Binding ClearClipboardEntries}"
                IsEnabled="{Binding Path=AreAnyItemsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ClipboardViewControlBase}}, Converter={StaticResource InverseBooleanConverter}}"
                Style="{DynamicResource BtnTrash}"
                Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <i:Interaction.Behaviors>
                    <infBeh:FrameworkElementDpiScalingBehavior />
                </i:Interaction.Behaviors>
            </Button>
        </Grid>
    </Grid>
</local:ClipboardViewControlBase>
