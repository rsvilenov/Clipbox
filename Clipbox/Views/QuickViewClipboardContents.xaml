<local:ClipboardViewControl x:Class="Clipbox.Views.QuickViewClipboardContents"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:infEnums="clr-namespace:Clipbox.Core.Enums;assembly=Clipbox.Core"
                            xmlns:coreConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
                            xmlns:vis="clr-namespace:Clipbox.Infrastructure.UI.Visuals;assembly=Clipbox.Infrastructure.UI"
                            xmlns:infWindows="clr-namespace:Clipbox.Infrastructure.UI.Windows;assembly=Clipbox.Infrastructure.UI"
                            xmlns:infPropAp="clr-namespace:Clipbox.Infrastructure.UI.AttachedProperties;assembly=Clipbox.Infrastructure.UI"
                            xmlns:conv="clr-namespace:Clipbox.Technical.Converters"
                            xmlns:bo="clr-namespace:Clipbox.ViewModels.BindableObjects"
                            xmlns:localBeh="clr-namespace:Clipbox.Behaviors"
                            xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                            xmlns:sys="clr-namespace:System;assembly=mscorlib"
                            xmlns:local="clr-namespace:Clipbox.Views"
                            mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <conv:BitmapToBitmapImageConverter x:Key="BitmapToBitmapImageConverter" />
        <conv:ObjectToTypeStringConverter x:Key="ObjectToTypeStringConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <coreConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <coreConv:OrMultiValueConverter x:Key="OrMultiValueConverter" />
        <coreConv:AndMultiValueConverter x:Key="AndMultiValueConverter" />
        <coreConv:MathAddConverter x:Key="MathAddConverter" />
        <coreConv:IsEqualOrGreaterThanConverter x:Key="IsEqualOrGreaterThanConverter" />
        <coreConv:NullOrEmptyCollectionToBoolConverter x:Key="NullOrEmptyCollectionToBoolConverter" />
        <conv:ContentClassListContainsConverter x:Key="ContentClassListContainsConverter" />
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <!-- Height="Auto" makes the listview unable to show its scrollviewer... -->
            <RowDefinition />
            <!-- this is the row for the bottom buttons (extentions, clear clipboard, etc...)-->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- label "No contents" -->
        <Label Grid.Row="0" Foreground="White" Background="Transparent" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
               FontSize="16" FontWeight="Bold"
               Width="250" Height="100" Content="The clipboard is empty.">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ClipboardViewItems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Name="BtnScrollUp" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                    Height="25" Grid.Column="2" Style="{DynamicResource BtnArrowUp}" Tag="{Binding ElementName=MainListView}">
                <i:Interaction.Behaviors>
                    <localBeh:ListViewScrollButtonBehavior ScrollUp="True" />
                </i:Interaction.Behaviors>
            </Button>
            <Button Grid.Row="2" Name="BtnScrollDown" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Height="25" Grid.Column="2" Style="{DynamicResource BtnArrowDown}" Tag="{Binding ElementName=MainListView}">
                <i:Interaction.Behaviors>
                    <localBeh:ListViewScrollButtonBehavior ScrollUp="False" />
                </i:Interaction.Behaviors>
            </Button>

            <!--MaxHeight="{Binding RelativeSource={RelativeSource FindAncestor,
                           AncestorType={x:Type Grid}},
                           Path=RowDefinitions[0].MaxHeight}"-->
             <ListView Grid.Row="1" Margin="10"
                   VerticalAlignment="Stretch"
                  Name="MainListView"
                  BorderThickness="0"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ItemsSource="{Binding ClipboardViewItems}"
                  VerticalContentAlignment="Top" Background="Transparent">

            <!-- Remove the default highlighting on mouse over -->
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border x:Name="Bd" Margin="5"
                                        BorderBrush="Transparent" BorderThickness="1"
                                        Background="Transparent"
                                        SnapsToDevicePixels="True">
                                    <!--BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"  -->

                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <!--<Setter Property="Background" TargetName="Bd" Value="Blue"/>-->
                                        <Setter Property="BorderBrush" TargetName="Bd" Value="DarkGray"/>
                                        <!--<Setter Property="BorderThickness" TargetName="Bd" Value="2"/>-->

                                    </MultiTrigger>
                                    <!--<MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource AccentLight3Brush}"/>
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource AccentLight3Brush}"/>
                                    </MultiTrigger>-->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <!--<Condition Binding="{Binding Selector.IsSelectionActive, RelativeSource={RelativeSource Self}}" Value="False" />-->
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource AccentLight3Brush}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <!--<Condition Binding="{Binding Selector.IsSelectionActive, RelativeSource={RelativeSource Self}}" Value="True" />-->
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource AccentLight3Brush}"/>
                                    </MultiDataTrigger>
                                    <!--<Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    </Trigger>-->
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--<vis:AutoWrapPanel ItemMinHeight="150" ItemMinWidth="150" />-->
                    <vis:AutoWrapPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0" Background="Transparent">
                        <Border.Style>

                            <Style TargetType="{x:Type Border}">
                                <Setter Property="IsManipulationEnabled" Value="False" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="IsManipulationEnabled" Value="True" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding MarkAsUnselectable}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="Flash">
                                                            <Storyboard
                                                    FillBehavior="Stop">
                                                                <!--
                                                                since wpf wants to freeze the storyboard, we cannot use dynamic resources here...
                                                                From="{DynamicResource AccentBrush}"
                                                                To="{DynamicResource AccentLight3Brush}"
                                                                -->
                                                    <ColorAnimation
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="Red"
                                                            Duration="0:0:0.3"
                                                            FillBehavior="HoldEnd"
                                                            RepeatBehavior="1x"
                                                            AutoReverse="True" /> 
                                                </Storyboard>
                                                        </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Background="Transparent" MinWidth="100" MinHeight="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="5, 0, 0, 0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl ItemsSource="{Binding ContentClasses}" MaxHeight="30" Grid.Column="0" Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <ContentControl Template="{DynamicResource ClassImageIcon}" Foreground="#e4e4e6" MaxHeight="17" Margin="5,0,0,0" ToolTip="Image">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.Image}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>

                                                    <ContentControl Template="{DynamicResource ClassFileIcon}" Foreground="#e4e4e6" MaxHeight="17" Margin="5,0,0,0" ToolTip="File/Folder">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition  Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.File}" />
                                                                            <Condition  Binding="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewItemSingle" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>

                                                    <ContentControl Template="{DynamicResource ClassFileCollectionIcon}" Foreground="#e4e4e6" MaxHeight="20" Margin="5,0,0,0" ToolTip="File/Folder collection">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition  Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.File}" />
                                                                            <Condition  Binding="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewItemGroup" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>

                                                    <ContentControl Template="{DynamicResource ClassTextIcon}" Foreground="#e4e4e6" MaxHeight="16" Margin="5,0,0,0" ToolTip="Text">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.Text}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>

                                                    <ContentControl Template="{DynamicResource ClassGeneralContentIcon}" Foreground="#e4e4e6" MaxHeight="17" Margin="5,0,0,0" ToolTip="Content">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition  Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.GeneralContent}" />
                                                                            <Condition  Binding="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewItemSingle" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>

                                                    <ContentControl Template="{DynamicResource ClassGeneralContentCollectionIcon}" Foreground="#e4e4e6" MaxHeight="20" Margin="5,0,0,0" ToolTip="Content collection">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition  Binding="{Binding}" Value="{x:Static infEnums:ClipboardContentClass.GeneralContent}" />
                                                                            <Condition  Binding="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewItemGroup" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                <!--<Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" Width="1" Height="15" Fill="#e4e4e6" Margin="5,0,0,0" />


                                        <Image MaxHeight="17" Margin="5"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Source="{Binding SourceWindowIcon}" ToolTip="{Binding SourceWindowCaption}" Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}" />-->
                                    
                                
                                
                                 <ToggleButton MaxWidth="25"  Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}"
                                    Style="{DynamicResource ToggleBtnStar}" 
                                    Grid.Column="2" Margin="0,0,5,0" 
                                    Command="{Binding Path=DataContext.PinUnpinClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                    CommandParameter="{Binding}" 
                                    IsChecked="{Binding IsPinned}">
                                        <!-- Visible only if the ListViewItem is highlighted or selected (IsManipulationEnabled = true) OR the toggle button is checked -->
                                        <ToggleButton.IsEnabled>
                                            <MultiBinding Converter="{StaticResource OrMultiValueConverter}">
                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type Border}}" Path="IsManipulationEnabled"/>
                                                <Binding RelativeSource="{RelativeSource Self}" Path="IsChecked"/>
                                            </MultiBinding>
                                        </ToggleButton.IsEnabled>
                                        <ToggleButton.Visibility>
                                            <Binding RelativeSource="{RelativeSource Self}" Path="IsEnabled" Converter="{StaticResource BooleanToVisibilityConverter}" />
                                        </ToggleButton.Visibility>
                                    </ToggleButton>

                                    <Button MaxWidth="25" Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}"
                                    Style="{DynamicResource BtnClose}"  Grid.Column="3" Margin="0,0,5,0" Visibility="{Binding 
                                    Path=IsManipulationEnabled, 
                                    RelativeSource={RelativeSource AncestorType={x:Type Border}},
                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Command="{Binding Path=DataContext.DeleteClipboardEntry, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                    CommandParameter="{Binding}"/>
                            </Grid>

                            <Rectangle Grid.Row="1" Fill="{DynamicResource TaskbarColorBrush}" Opacity="0.3"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsEnabled="{Binding 
                                    Path=IsManipulationEnabled, 
                                    RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource InverseBooleanConverter}}" Visibility="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>


                            <!-- single item -->
                            <ContentControl Grid.Row="1">
                                <ContentControl.Style>
                                    <Style TargetType="{x:Type ContentControl}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewItemSingle">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="40" />
                                                            </Grid.RowDefinitions>

                                                            <!-- In order to access the PreviewItem property, we need to cast (in XAML) the ClipboardViewItem to ClipboardViewItemSingle -->
                                                            <Image Grid.Row="0" Margin="10"
                                                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Uniform"
                                                                Source="{Binding Path=(bo:ClipboardViewItemSingle.PreviewItem).(bo:ClipboardPreviewItem.Image)}"
                                                                ToolTip="{Binding PreviewItem.Description}" />

                                                                <Rectangle Grid.Row="0" Fill="Black" Opacity="0.3"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Rectangle.IsEnabled>
                                                                        <MultiBinding Converter="{StaticResource AndMultiValueConverter}">
                                                                            <Binding 
                                                                                Path="IsManipulationEnabled"
                                                                                RelativeSource="{RelativeSource AncestorType={x:Type Border}}" 
                                                                                Converter="{StaticResource InverseBooleanConverter}" />
                                                                            <Binding 
                                                                                Path="DimNonFocusedItems" 
                                                                                RelativeSource="{RelativeSource AncestorType={x:Type local:ClipboardViewControl}}" />
                                                                            <Binding 
                                                                                Path="DataContext.IsSelected"
                                                                                RelativeSource="{RelativeSource AncestorType={x:Type ListViewItem}}" 
                                                                                Converter="{StaticResource InverseBooleanConverter}" />
                                                                        </MultiBinding>
                                                                    </Rectangle.IsEnabled>
                                                                </Rectangle>


                                                                <Label Grid.Row="1" 
                                                                    Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}"
                                                                       HorizontalContentAlignment="Center" 
                                                                       VerticalContentAlignment="Center" 
                               Foreground="White" FontSize="12">
                                                                    <Label.Content>
                                                                        <!-- TODO: calculate the MaxWidth dynamically -->
                                                                        <TextBlock MaxWidth="200"
                                                                            TextBlock.TextTrimming="CharacterEllipsis"
                                                                            Text="{Binding PreviewItem.Text}" ToolTipService.Placement="Center">
                                                                            <TextBlock.ToolTip>
                                                                                <!-- the tooltip won't scale with the textblock, probably because it is not part of its visual tree-->
                                                                                <ToolTip>
                                                                                    <ToolTip.Content>
                                                                                        <TextBlock  FontSize="12" Text="{Binding PreviewItem.Text}">
                                                                                            <!--<TextBlock.LayoutTransform>
                                                                                                <ScaleTransform CenterX="0" CenterY="0" ScaleX="{Binding Path=ScaleFactor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=infWindows:PerMonitorDpiWindow}}" ScaleY="{Binding}" />
                                                                                            </TextBlock.LayoutTransform>-->
                                                                                        </TextBlock>
                                                                                    </ToolTip.Content>
                                                                                </ToolTip>
                                                                            </TextBlock.ToolTip>
                                                                        </TextBlock>
                                                                    </Label.Content>
                                                                </Label>

                                                            </Grid>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>

                            <!-- multiple items -->
                                <Grid Grid.Row="1" Margin="0, 0, 0, 0">
                                    <Grid.Height>
                                        <MultiBinding Converter="{StaticResource MathAddConverter}">
                                            <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" Path="ClipboardViewItemHeight" />
                                            <Binding>
                                                <Binding.Source>
                                                    <!-- pad the height so that it matches the total height of the single view items -->
                                                    <sys:Double>60</sys:Double>
                                                </Binding.Source>
                                            </Binding>
                                        </MultiBinding>
                                    </Grid.Height>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="15" />
                                        <RowDefinition />
                                        <RowDefinition Height="15" />
                                        <RowDefinition Height="25" />
                                    </Grid.RowDefinitions>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewItemGroup">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Button Grid.Row="0" Name="BtnScrollUpSubItem" HorizontalAlignment="Stretch" 
                                            VerticalAlignment="Center" Height="15" Grid.Column="2" Style="{DynamicResource BtnArrowUp}" 
                                            Tag="{Binding ElementName=subItemsListView}">
                                        <i:Interaction.Behaviors>
                                            <localBeh:ListViewScrollButtonBehavior ScrollUp="True" />
                                        </i:Interaction.Behaviors>
                                    </Button>
                                    <Button Grid.Row="2" Name="BtnScrollDownSubItem" HorizontalAlignment="Stretch" 
                                            VerticalAlignment="Center" Height="15" Grid.Column="2" Style="{DynamicResource BtnArrowDown}" 
                                            Tag="{Binding ElementName=subItemsListView}">
                                        <i:Interaction.Behaviors>
                                            <localBeh:ListViewScrollButtonBehavior ScrollUp="False" />
                                        </i:Interaction.Behaviors>
                                    </Button>

                                    <Label Grid.Row="3" Height="25"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <Label.Content>
                                            <TextBlock Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} of {1} selected">
                                                        <Binding ElementName="subItemsListView" Path="SelectedItems.Count" />
                                                        <Binding Path="TotalClipboardItemsCount" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Label.Content>
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding 
                                                        Path=SelectedItems.Count,
                                                        ElementName=subItemsListView}" Value="0" >
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>

                                    <Label Grid.Row="3" Height="25"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <Label.Content>
                                            <TextBlock Foreground="White" 
                                                Text="{Binding 
                                                Path=TotalClipboardItemsCount,
                                                StringFormat={}{0} items}" />
                                        </Label.Content>
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding 
                                                        Path=SelectedItems.Count,
                                                        ElementName=subItemsListView}" Value="0" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>

                                    <ListView Grid.Row="1" BorderThickness="1" Name="subItemsListView"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          SelectionChanged="MultiItemListView_SelectionChanged"
                                          Background="Transparent">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListViewItem}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                            <Border x:Name="Bd" Margin="5"
                                                                    
                                        BorderBrush="Transparent" BorderThickness="1"
                                        Background="Transparent"
                                        SnapsToDevicePixels="True">
                                                                <Border.Height>
                                                                    <MultiBinding Converter="{StaticResource MathAddConverter}">
                                                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ListBox}" />
                                                                        <Binding>
                                                                            <Binding.Source>
                                                                                <!-- take into account the margin of the border (5 on top and 5 on bottom + 1 for border top and 1 for border bottom) -->
                                                                                <sys:Double>-15</sys:Double>
                                                                            </Binding.Source>
                                                                        </Binding>
                                                                    </MultiBinding>
                                                                </Border.Height>
                                                                <!--BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"  -->

                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItemNMore">
                                                                    <!-- Make the "+N" indicator non-selectable. Despite this, the item can still be selected via click, so we will use a behavior on the content (see the ListViewItem template below).
                                                                    Note that we cannot just set IsEnabled to False, because this will also disable the tooltips and we do not want that. -->
                                                                    <Setter Property="Focusable" Value="False" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                        <!-- show the border only for real subitems, not for the "+N" indicator -->
                                                                        <Condition Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItem" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <!--<Setter Property="Background" TargetName="Bd" Value="Blue"/>-->
                                                                    <Setter Property="BorderBrush" TargetName="Bd" Value="DarkGray"/>
                                                                    <!--<Setter Property="BorderThickness" TargetName="Bd" Value="2"/>-->

                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <!--<Condition Binding="{Binding Selector.IsSelectionActive, RelativeSource={RelativeSource Self}}" Value="False" />-->
                                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource AccentLight3Brush}"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <!--<Condition Binding="{Binding Selector.IsSelectionActive, RelativeSource={RelativeSource Self}}" Value="True" />-->
                                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource AccentLight3Brush}"/>
                                                                </MultiDataTrigger>
                                                                <!--<Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    </Trigger>-->
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.Style>
                                            <Style TargetType="{x:Type ListView}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="ItemsSource" Value="{x:Null}" />
                                                <Setter Property="infPropAp:ListViewUnselectAllAttachedProperty.UnselectAll" Value="False" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentLight3Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItems.Count}" Value="0">
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewItemGroup">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <!--cast the ClipboardViewItem to ClipboardViewItemGroup-->
                                                        <Setter Property="ItemsSource" Value="{Binding Path=(bo:ClipboardViewItemGroup.PreviewItems)}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding
                                                    RelativeSource={RelativeSource
                                                    Mode=FindAncestor,
                                                    AncestorType={x:Type ListBoxItem}},
                                                    Path=IsSelected}"
                                                    Value="True" >
                                                        <Setter Property="infPropAp:ListViewUnselectAllAttachedProperty.UnselectAll" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.Style>
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!--<WrapPanel />-->
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <ContentControl x:Name="ccSubItem">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItem">

                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate>
                                                                                <Grid>
                                                                                    <Grid.Background>
                                                                                        <SolidColorBrush Color="DarkGray" Opacity="0.1" />
                                                                                    </Grid.Background>
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="*" />
                                                                                        <RowDefinition Height="30" />
                                                                                    </Grid.RowDefinitions>
                                                                                    <Image Name="subItemPreviewImage" Grid.Row="0" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Uniform"
                                                                                    Source="{Binding Path=PreviewItem.Image}" 
                                                                                    ToolTip="{Binding Path=PreviewItem.Description}" />
                                                                                    <Label Grid.Row="1" 
                                                                                            Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}"
                                                                                           HorizontalContentAlignment="Center" 
                                                                                           VerticalContentAlignment="Center" 
                                                                                            Foreground="White" FontSize="12">
                                                                                        <Label.Content>
                                                                                            <TextBlock MaxWidth="{Binding ElementName=subItemPreviewImage, Path=ActualWidth}"
                                                                                                TextBlock.TextTrimming="CharacterEllipsis"
                                                                                                Text="{Binding PreviewItem.Text}" ToolTip="{Binding PreviewItem.Text}" ToolTipService.Placement="Center" />
                                                                                        </Label.Content>
                                                                                    </Label>
                                                                                </Grid>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>

                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding Converter={StaticResource ObjectToTypeStringConverter}}" Value="ClipboardViewSubItemNMore">

                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate>
                                                                                <Grid Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" Width="{Binding Path=Height, RelativeSource={RelativeSource Self}}">
                                                                                    <i:Interaction.Behaviors>
                                                                                        <!-- ClipboardViewSubItemNMore elements are still selectable with a click despite ListViewItem.Focusable=False, so we need a behavior to cancel the click events -->
                                                                                        <localBeh:FrameworkElementDisableClickBehavior AncestorElement="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}" />
                                                                                    </i:Interaction.Behaviors>
                                                                                    <Grid.ToolTip>
                                                                                        <TextBlock Text="{Binding Path=(bo:ClipboardViewSubItemNMore.NumberOfItems), StringFormat='{}{0:#} more files.'}">
                                                                                        </TextBlock>
                                                                                    </Grid.ToolTip>
                                                                                    <Grid.Background>
                                                                                        <SolidColorBrush Color="DarkGray" Opacity="0.1" />
                                                                                    </Grid.Background>

                                                                                    <TextBlock
                                                                                           HorizontalAlignment="Center" 
                                                                                           VerticalAlignment="Center"  
                                                                                            FontWeight="Bold"
                                                                                            FontSize="16"
                                                                                            Foreground="White"
                                                                                            Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}" 
                                                                                           Text="{Binding Path=(bo:ClipboardViewSubItemNMore.NumberOfItems), StringFormat={}{0:+#}}">
                                                                                    </TextBlock>
                                                                                </Grid>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>

                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>

                                                    </ContentControl.Style>
                                                </ContentControl>

                                            </DataTemplate>
                                        </ListView.ItemTemplate>

                                    </ListView>

                                    <Rectangle Grid.Row="1" Fill="Black" Opacity="0.3"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=IsManipulationEnabled,
                                                                                RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=DataContext.IsSelected,
                                                                                RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding 
                                                        Path=SelectedItems.Count,
                                                        ElementName=subItemsListView,
                                                        Converter={StaticResource IsEqualOrGreaterThanConverter},
                                                        ConverterParameter=1}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding 
                                                                                Path=DimNonFocusedItems,
                                                                                RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardViewControl}} }" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </Grid>

                            </Grid>
                    </Border>

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="35" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" x:Name="uiExtentionContainer" Panel.ZIndex="99"  Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}" />
            <TextBlock Grid.Column="0" Name="ErrorTextBlock" Background="Transparent" Margin="15, 0, 0, 15" VerticalAlignment="Center" Foreground="White" FontSize="16" Visibility="Collapsed" Panel.ZIndex="100"  Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}" />
            <Button Width="25" Height="25" Grid.Column="1" Margin="0, 0, 5, 5" Style="{DynamicResource BtnTrash}"  Command="{Binding ClearClipboardEntries}" 
                    Click="ButtonClearItems_Click"
                    Visibility="{Binding AreClipboardItemsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Tag="{x:Static infWindows:PerMonitorDpiWindow.SCALE_ELEMENT_TAG}" />
        </Grid>
    </Grid>
</local:ClipboardViewControl>
