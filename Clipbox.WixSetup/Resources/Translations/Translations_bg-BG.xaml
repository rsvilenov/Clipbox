    <sys:String x:Key="TrLangEN">Английски</sys:String>
    <sys:String x:Key="TrBtnInstall">ИНСТАЛИРАЙ</sys:String>
    <sys:String x:Key="TrBtnCancel">Прекрати</sys:String>
