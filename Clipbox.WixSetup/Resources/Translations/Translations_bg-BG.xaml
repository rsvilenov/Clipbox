    <sys:String x:Key="TrLblInstallReadyAnnotation2">Натиснете и задръжте Ctrl+V и ще видите съдържанието на клипборда.</sys:String>
    <sys:String x:Key="TrBtnInstallReady">OK</sys:String>
    <sys:String x:Key="TrLblInstallError">Грешка :(</sys:String>
    <sys:String x:Key="TrBtnRetry">Опитай отново</sys:String>
