<?xml version="1.0" encoding="Windows-1252"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:netfx="http://schemas.microsoft.com/wix/NetFxExtension" xmlns:bal="http://schemas.microsoft.com/wix/BalExtension">
  <Bundle Name="My Product" UpgradeCode="6f330b47-2577-43ad-9095-1861bb25889a" Version="1.0.0.0" >
    <BootstrapperApplicationRef Id="ManagedBootstrapperApplicationHost">
      <Payload SourceFile="Clipbox.WixSetup.exe" />
      <Payload SourceFile="BootstrapperCore.config" />
      <Payload SourceFile="bin\Debug\Microsoft.Deployment.WindowsInstaller.dll" />
    </BootstrapperApplicationRef>

    <Variable Name="UserInput" Value="&lt;none&gt;" Persisted="yes" />

    <Chain>
      <PackageGroupRef Id="NetFx40Web" />

      <MsiPackage Id="MyProductPackageId" DisplayInternalUI="yes" SourceFile="Clipbox.msi">
        <MsiProperty Name="USERINPUT" Value="[UserInput]" />
        <MsiProperty Name="WIXBUNDLEORIGINALSOURCE" Value="[WixBundleOriginalSource]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>

