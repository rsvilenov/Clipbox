<Window
    x:Class="Setup.WixSetup.View.InstallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    Width="1012"
    Height="674"
    AllowsTransparency="True"
    Background="#2d364c"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Style.xaml" />
                <ResourceDictionary Source="/Resources/Translations/Translations_en-US.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border
            x:Name="DisableCurtain"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Panel.ZIndex="100"
            Background="Black"
            Opacity="0.5"
            Visibility="Collapsed" />
        <Popup
            Name="ConfirmQuitPopup"
            Width="380"
            Height="200"
            Panel.ZIndex="101"
            Placement="Center"
            PlacementTarget="{Binding ElementName=MainGrid}"
            Visibility="Collapsed">
            <Border
                Background="White"
                BorderBrush="#808080"
                BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Background="#2d364c">
                        <Button
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="BtnConfirmQuitNo_Click"
                            Style="{StaticResource BtnClose}" />
                    </Border>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="Black"
                        Text="{DynamicResource TrLblQuitConfirmation}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Width="55"
                        Height="35"
                        Margin="10"
                        HorizontalAlignment="Right"
                        Click="BtnConfirmQuitYes_Click"
                        Content="{DynamicResource TrBtnYes}"
                        FontSize="16"
                        Style="{StaticResource BtnDefaultAction}" />
                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="55"
                        Height="35"
                        Margin="10"
                        HorizontalAlignment="Left"
                        Click="BtnConfirmQuitNo_Click"
                        Content="{DynamicResource TrBtnNo}"
                        FontSize="16"
                        Style="{StaticResource BtnActionLight}" />
                </Grid>
            </Border>
        </Popup>
        <!--  title bar  -->
        <Grid
            Grid.Row="0"
            Background="Transparent"
            MouseDown="CaptionGrid_MouseDown">
            <StackPanel
                Height="24"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ContentControl
                    Height="24"
                    Foreground="#f0f0f0"
                    Template="{StaticResource LogoIcon}" />
                <TextBlock
                    Margin="10,0,0,0"
                    FontSize="16"
                    Foreground="#f0f0f0"
                    Text="{DynamicResource TrWindowTitle}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ComboBox
                    Name="ComboBoxLanguage"
                    Margin="0,6,10,6"
                    FontSize="14"
                    FontWeight="Light"
                    SelectionChanged="ComboBoxLanguage_SelectionChanged"
                    Style="{StaticResource FlatComboBoxStyle}">
                    <ComboBoxItem
                        Background="#2d364c"
                        Content="{DynamicResource TrLangEN}"
                        IsSelected="True"
                        Tag="en-US" />
                    <ComboBoxItem
                        Background="#2d364c"
                        Content="{DynamicResource TrLangBG}"
                        Tag="bg-BG" />
                </ComboBox>
                <Button
                    Name="BtnCloseWindow"
                    Width="24"
                    Height="24"
                    Margin="10,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CloseInstallWindowCommand}"
                    Style="{StaticResource BtnClose}" />
            </StackPanel>
        </Grid>


        <!--  first page  -->
        <Grid
            Name="FirstPage"
            Grid.Row="1"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl
                Grid.Row="0"
                Height="100"
                Margin="0,70,0,0"
                Foreground="White"
                Template="{StaticResource LogoIcon}" />
            <Grid
                Grid.Row="1"
                Margin="0,50,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,30"
                    HorizontalAlignment="Center"
                    FontSize="46"
                    Foreground="White"
                    Text="Clipbox" />
                <TextBlock
                    Grid.Row="1"
                    FontSize="16"
                    Foreground="White"
                    TextAlignment="Center">
                    <Run Text="By installing or using the product, you agree to its" />
                    <LineBreak />
                    <Run
                        Cursor="Hand"
                        Hyperlink.Click="Run_Click"
                        Text="End User License Agreement"
                        TextDecorations="Underline" />
                    <Run Text="and" />
                    <Run
                        Cursor="Hand"
                        Hyperlink.Click="Run_Click"
                        Text="Privacy Policy"
                        TextDecorations="Underline" />
                </TextBlock>

                <Button
                    Grid.Row="2"
                    Width="180"
                    Height="50"
                    Margin="0,30,0,0"
                    BorderThickness="0"
                    Content="{DynamicResource TrBtnInstall}"
                    FontSize="18"
                    Style="{StaticResource BtnDefaultAction}" />

                <TextBlock
                    Grid.Row="3"
                    Width="Auto"
                    Margin="0,10,0,0"
                    Cursor="Hand"
                    FontSize="18"
                    Foreground="White"
                    MouseLeftButtonUp="Customize_MouseLeftButtonUp"
                    Text="{DynamicResource TrLnkCustomInstall}"
                    TextAlignment="Center"
                    TextDecorations="Underline" />

            </Grid>
        </Grid>

        <!--  custom install  -->
        <Grid
            Name="CustomInstallPage"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="931*" />
                <ColumnDefinition Width="81*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="10,0,0,0"
                Orientation="Horizontal">
                <Button
                    Name="BtnInstalloptionsBack"
                    Width="50"
                    Height="40"
                    Click="BtnInstalloptionsBack_Click"
                    Style="{StaticResource BtnBack}" />
                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="30"
                    Foreground="White"
                    Text="{DynamicResource TrLblInstallOptions}"
                    TextAlignment="Left" />
            </StackPanel>
            <Grid
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="80,80">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontSize="16"
                    Foreground="#f0f0bd"
                    Text="Clipbox will install into" />

                <Grid
                    Grid.Row="1"
                    Height="50"
                    HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Height="40"
                        Padding="5"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderBrush="#f0f0bd"
                        BorderThickness="1"
                        FontSize="18"
                        Foreground="#f0f0bd"
                        Style="{StaticResource DefaultTextBox}"
                        Text="{Binding InstallationDirectory}" />
                    <Button
                        Name="BtnChangeInstallDirectory"
                        Grid.Column="1"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        VerticalContentAlignment="Center"
                        Click="BtnChangeInstallDirectory_Click"
                        Content="Change"
                        FontSize="16"
                        Style="{StaticResource BtnActionDark}" />
                </Grid>

                <ToggleButton
                    Grid.Row="3"
                    Height="30"
                    Margin="0,30,0,0"
                    HorizontalAlignment="Left"
                    Content="{DynamicResource TrChkBoxDesktopShortcut}"
                    FontSize="16"
                    Foreground="#f0f0bd"
                    IsChecked="{Binding CreateDesktopShortcut}"
                    Style="{StaticResource CheckBox}" />

            </Grid>
            <Button
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Width="180"
                Height="50"
                Margin="0,25,15,25"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                BorderThickness="0"
                Content="INSTALL"
                FontSize="18"
                Style="{StaticResource BtnDefaultAction}" />
        </Grid>

    </Grid>
