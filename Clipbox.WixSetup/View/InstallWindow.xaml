<Window
    x:Class="Setup.WixSetup.View.InstallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mainNs="clr-namespace:Clipbox.WixSetup"
    xmlns:shell="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    xmlns:vmEnums="clr-namespace:Clipbox.WixSetup.ViewModel.Enums"
    Width="1012"
    Height="674"
    AllowsTransparency="True"
    Background="#2d364c"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Style.xaml" />
                <ResourceDictionary Source="/Resources/Translations/Translations_en-US.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border
            x:Name="DisableCurtain"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Panel.ZIndex="100"
            Background="Black"
            Opacity="0.5"
            Visibility="Collapsed" />
        <Popup
            Name="ConfirmQuitPopup"
            Width="380"
            Height="200"
            Panel.ZIndex="101"
            Placement="Center"
            PlacementTarget="{Binding ElementName=MainGrid}"
            Visibility="Collapsed">
            <Border
                Background="White"
                BorderBrush="#808080"
                BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Background="#2d364c">
                        <Button
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="BtnConfirmQuitNo_Click"
                            Style="{StaticResource BtnClose}" />
                    </Border>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="Black"
                        Text="{DynamicResource TrLblQuitConfirmation}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Width="55"
                        Height="35"
                        Margin="10"
                        HorizontalAlignment="Right"
                        Click="BtnConfirmQuitYes_Click"
                        Content="{DynamicResource TrBtnYes}"
                        FontSize="16"
                        Style="{StaticResource BtnDefaultAction}" />
                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="55"
                        Height="35"
                        Margin="10"
                        HorizontalAlignment="Left"
                        Click="BtnConfirmQuitNo_Click"
                        Content="{DynamicResource TrBtnNo}"
                        FontSize="16"
                        Style="{StaticResource BtnActionLight}" />
                </Grid>
            </Border>
        </Popup>
        <!--  title bar  -->
        <Grid
            Grid.Row="0"
            Background="Transparent"
            MouseDown="CaptionGrid_MouseDown">
            <StackPanel
                Height="24"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ContentControl
                    Height="24"
                    Foreground="#f0f0f0"
                    Template="{StaticResource LogoIcon}" />
                <TextBlock
                    Margin="10,0,0,0"
                    FontSize="16"
                    Foreground="#f0f0f0"
                    Text="{DynamicResource TrWindowTitle}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ComboBox
                    Name="ComboBoxLanguage"
                    Margin="0,6,10,6"
                    FontSize="14"
                    FontWeight="Light"
                    SelectionChanged="ComboBoxLanguage_SelectionChanged">
                    <ComboBox.Style>
                        <Style BasedOn="{StaticResource FlatComboBoxStyle}" TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Welcome}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBoxItem
                        Background="#2d364c"
                        Content="{DynamicResource TrLangEN}"
                        IsSelected="True"
                        Tag="en-US" />
                    <ComboBoxItem
                        Background="#2d364c"
                        Content="{DynamicResource TrLangBG}"
                        Tag="bg-BG" />
                </ComboBox>
                <Button
                    Name="BtnCloseWindow"
                    Width="24"
                    Height="24"
                    Margin="10,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CloseInstallWindowCommand}"
                    Style="{StaticResource BtnClose}" />
            </StackPanel>
        </Grid>


        <!--  initial loading indicator  -->
        <Grid Name="Loading" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Loading}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="LightGray"
                Text="{DynamicResource TrLblInitialLoading}"
                TextAlignment="Center" />
        </Grid>

        <!--  newer version already installed  -->
        <Grid Name="NewerVersionInstalled" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNewerVersionAlreadyInstalled}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="26"
                Foreground="LightGray"
                Text="{DynamicResource TrLblNewerVersionInstalled}"
                TextAlignment="Center" />
            <ContentControl
                Grid.Row="1"
                Width="100"
                Height="100"
                Foreground="#c17819"
                Template="{StaticResource SmileIcon}" />
            <Button
                Grid.Row="2"
                Width="170"
                Height="45"
                HorizontalAlignment="Center"
                Command="{Binding QuitCommand}"
                Content="{DynamicResource TrBtnQuit}"
                FontSize="16"
                Style="{StaticResource BtnActionDark}" />
        </Grid>

        <!--  welcome page  -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SetupWorkflow}" Value="{x:Static vmEnums:ClipboxSetupWorkflow.Install}" />
                                <Condition Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Welcome}" />
                                <Condition Binding="{Binding IsNewerVersionAlreadyInstalled}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!--  first page  -->
            <Grid Name="FirstPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl
                    Grid.Row="0"
                    Height="100"
                    Margin="0,70,0,0"
                    Foreground="White"
                    Template="{StaticResource LogoIcon}" />
                <Grid
                    Grid.Row="1"
                    Margin="0,50,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,30"
                        HorizontalAlignment="Center"
                        FontSize="46"
                        Foreground="White"
                        Text="{x:Static mainNs:ProductConstants.PRODUCT_NAME}" />
                    <TextBlock
                        Grid.Row="1"
                        FontSize="16"
                        Foreground="White"
                        TextAlignment="Center">
                        <Run Text="{DynamicResource TrLblAgreementIntro}" />
                        <LineBreak />
                        <Run
                            Cursor="Hand"
                            MouseLeftButtonUp="LicenseAgreementLink_MouseLeftButtonUp"
                            Text="{DynamicResource TrLblAgreementEULA}"
                            TextDecorations="Underline" />
                        <Run Text="{DynamicResource TrLblAgreementAnd}" />
                        <Run
                            Cursor="Hand"
                            MouseLeftButtonUp="PrivacyPolicyLink_MouseLeftButtonUp"
                            Text="{DynamicResource TrLblAgreementPrivacyPolicy}"
                            TextDecorations="Underline" />
                    </TextBlock>

                    <Button
                        Grid.Row="2"
                        Width="180"
                        Height="50"
                        Margin="0,30,0,0"
                        BorderThickness="0"
                        Command="{Binding InstallCommand}"
                        Content="{DynamicResource TrBtnInstall}"
                        FontSize="18"
                        Style="{StaticResource BtnDefaultAction}" />

                    <TextBlock
                        Grid.Row="3"
                        Width="Auto"
                        Margin="0,10,0,0"
                        Cursor="Hand"
                        FontSize="18"
                        Foreground="White"
                        MouseLeftButtonUp="Customize_MouseLeftButtonUp"
                        Text="{DynamicResource TrLnkCustomInstall}"
                        TextAlignment="Center"
                        TextDecorations="Underline" />

                </Grid>
            </Grid>

            <!--  custom install  -->
            <Grid
                Name="CustomInstallPage"
                Grid.Row="1"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="931*" />
                    <ColumnDefinition Width="81*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="10,0,0,0"
                    Orientation="Horizontal">
                    <Button
                        Name="BtnInstalloptionsBack"
                        Width="50"
                        Height="40"
                        Click="BtnInstalloptionsBack_Click"
                        Style="{StaticResource BtnBack}" />
                    <TextBlock
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        Foreground="White"
                        Text="{DynamicResource TrLblInstallOptions}"
                        TextAlignment="Left" />
                </StackPanel>
                <Grid
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="80,80">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontSize="16"
                        Foreground="#f0f0bd"
                        Text="{DynamicResource TrLblInstallLocation}" />

                    <Grid
                        Grid.Row="1"
                        Height="50"
                        HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Height="40"
                            Padding="5"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="#f0f0bd"
                            BorderThickness="1"
                            FontSize="18"
                            Foreground="#f0f0bd"
                            Style="{StaticResource DefaultTextBox}"
                            Text="{Binding InstallationDirectory}" />
                        <Button
                            Name="BtnChangeInstallDirectory"
                            Grid.Column="1"
                            Width="100"
                            Height="40"
                            Margin="10,0,0,0"
                            VerticalContentAlignment="Center"
                            Click="BtnChangeInstallDirectory_Click"
                            Content="{DynamicResource TrBtnChangeInstallDir}"
                            FontSize="16"
                            Style="{StaticResource BtnActionDark}" />
                    </Grid>

                    <ToggleButton
                        Grid.Row="3"
                        Height="30"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Left"
                        Content="{DynamicResource TrChkBoxDesktopShortcut}"
                        FontSize="16"
                        Foreground="#f0f0bd"
                        IsChecked="{Binding CreateDesktopShortcut}"
                        Style="{StaticResource CheckBox}" />

                </Grid>
                <Button
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Width="180"
                    Height="50"
                    Margin="0,25,15,25"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{Binding InstallCommand}"
                    Content="{DynamicResource TrBtnInstall}"
                    FontSize="18"
                    Style="{StaticResource BtnDefaultAction}" />
            </Grid>

        </Grid>

        <!--  update welcome page  -->
        <Grid Name="UpdateFirstPage" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SetupWorkflow}" Value="{x:Static vmEnums:ClipboxSetupWorkflow.Update}" />
                                <Condition Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Welcome}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl
                Grid.Row="0"
                Height="100"
                Margin="0,70,0,0"
                Foreground="White"
                Template="{StaticResource LogoIcon}" />
            <Grid
                Grid.Row="1"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,30"
                    HorizontalAlignment="Center"
                    FontSize="46"
                    Foreground="White"
                    Text="{x:Static mainNs:ProductConstants.PRODUCT_NAME}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,100,0,0"
                    FontSize="16"
                    Foreground="White"
                    Text="{DynamicResource TrLblReadyForUpdate}"
                    TextAlignment="Center" />

                <Button
                    Grid.Row="2"
                    Width="180"
                    Height="50"
                    Margin="0,30,0,0"
                    BorderThickness="0"
                    Command="{Binding UpdateCommand}"
                    Content="{DynamicResource TrBtnUpdate}"
                    FontSize="18"
                    Style="{StaticResource BtnDefaultAction}" />
            </Grid>
        </Grid>

        <!--  progress page  -->
        <Grid Name="ProgressPage" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Preparing}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Processing}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <ContentControl
                Grid.Row="0"
                Height="80"
                Margin="0,70,0,0"
                Foreground="#f0f0f0"
                Template="{StaticResource LogoIcon}" />
            <TextBlock
                Grid.Row="1"
                Margin="0,30,0,0"
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="Medium"
                Foreground="#fefefe">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{DynamicResource TrLblInstalling}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModifyAction}" Value="{x:Static vmEnums:ClipboxModifyAction.Uninstall}">
                                <Setter Property="Text" Value="{DynamicResource TrLblUninstalling}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ModifyAction}" Value="{x:Static vmEnums:ClipboxModifyAction.Repair}">
                                <Setter Property="Text" Value="{DynamicResource TrLblRepairing}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ModifyAction}" Value="{x:Static vmEnums:ClipboxModifyAction.Modify}">
                                <Setter Property="Text" Value="{DynamicResource TrLblModifying}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ProgressBar
                Grid.Row="2"
                Height="10"
                Margin="50,70,50,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Style="{StaticResource DefaultProgressBar}"
                Value="{Binding Progress}" />
            <TextBlock
                Grid.Row="3"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="Thin"
                Foreground="#fefefe"
                Text="{DynamicResource TrLblInstallingWarning}" />
            <Button
                Grid.Row="4"
                Width="180"
                Height="40"
                Margin="20,20,50,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                BorderBrush="Gray"
                BorderThickness="1"
                Command="{Binding CancelCommand}"
                Content="{DynamicResource TrBtnCancel}"
                FontSize="18"
                Style="{StaticResource BtnActionDark}" />
        </Grid>

        <!--  ready page  -->
        <Grid Name="ReadyPage" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SetupWorkflow}" Value="{x:Static vmEnums:ClipboxSetupWorkflow.Install}" />
                                <Condition Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Done}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="30"
                FontWeight="Thin"
                Foreground="White"
                Text="{DynamicResource TrLblInstallReady}" />
            <ContentControl
                Grid.Row="1"
                Width="60"
                Foreground="#FF21BD69"
                Template="{StaticResource ReadyIcon}" />
            <Ellipse
                Grid.Row="1"
                Width="150"
                Height="150"
                Stroke="#8a9ed3"
                StrokeThickness="3" />
            <TextBlock
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Thin"
                Foreground="White"
                TextAlignment="Center">
                <Run Text="{DynamicResource TrLblInstallReadyAnnotation1}" />
                <LineBreak />
                <Run Text="{DynamicResource TrLblInstallReadyAnnotation2}" />
            </TextBlock>
            <Button
                Grid.Row="3"
                Grid.Column="0"
                Width="170"
                Height="45"
                Margin="10"
                HorizontalAlignment="Center"
                Command="{Binding QuitCommand}"
                Content="{DynamicResource TrBtnOperationComplete}"
                FontSize="16"
                Style="{StaticResource BtnDefaultAction}" />
        </Grid>

        <!--  error page  -->
        <Grid Name="ErrorPage" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Error}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="30"
                FontWeight="Thin"
                Foreground="White"
                Text="{DynamicResource TrLblInstallError}" />
            <ContentControl
                Grid.Row="1"
                Width="60"
                Foreground="Red"
                Template="{StaticResource ErrorIcon}" />
            <Ellipse
                Grid.Row="1"
                Width="150"
                Height="150"
                Stroke="#8a9ed3"
                StrokeThickness="3" />
            <TextBlock
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Thin"
                Foreground="White"
                TextAlignment="Center">
                <Run Text="{DynamicResource TrLblErrorTitle}" />
                <LineBreak />
                <Run Text="{Binding ErrorMessage, TargetNullValue=(none)}" />
            </TextBlock>
            <StackPanel
                Grid.Row="3"
                Grid.Column="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="170"
                    Height="45"
                    Margin="10"
                    Command="{Binding RetryCommand}"
                    Content="{DynamicResource TrBtnRetry}"
                    FontSize="16"
                    Style="{StaticResource BtnActionDark}" />
                <Button
                    Width="170"
                    Height="45"
                    Margin="10"
                    Command="{Binding QuitCommand}"
                    Content="{DynamicResource TrBtnQuit}"
                    FontSize="16"
                    Style="{StaticResource BtnActionDark}" />
            </StackPanel>

        </Grid>

        <Grid Name="UninstallModifyPage" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SetupWorkflow}" Value="{x:Static vmEnums:ClipboxSetupWorkflow.Modify}" />
                                <Condition Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Welcome}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,50,0,0"
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="#dedee1"
                Text="{DynamicResource TrLblConfigure}" />
            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,80,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl
                    Grid.Row="0"
                    Height="64"
                    Foreground="#dedee1"
                    Template="{StaticResource LogoIcon}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,50,0,0"
                    HorizontalAlignment="Center"
                    FontSize="26"
                    Foreground="#dedee1"
                    Text="{DynamicResource TrLblDisable}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="40,20,40,0"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="#b2b2b2"
                    Text="{DynamicResource TrLblDisableInfo}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Row="3"
                    Width="255"
                    Height="35"
                    Margin="50"
                    HorizontalAlignment="Center"
                    Content="{DynamicResource TrBtnDisable}"
                    FontSize="16"
                    Style="{StaticResource BtnDefaultAction}" />
            </Grid>
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,80,0,80"
                BorderBrush="#495268"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="40,0,40,40"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Foreground="#b2b2b2"
                        Text="{DynamicResource TrLblModifyInfo}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Row="1"
                        Width="150"
                        Height="40"
                        Margin="10,0,0,20"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Command="{Binding UpdateLinkCommand}"
                        FontSize="16"
                        Style="{StaticResource BtnActionDark}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Margin="8" Template="{StaticResource UpdateIcon}" />
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="{DynamicResource TrBtnUpdate}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="2"
                        Width="150"
                        Height="40"
                        Margin="10,0,0,20"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Command="{Binding RepairCommand}"
                        FontSize="16"
                        Style="{StaticResource BtnActionDark}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Margin="8" Template="{StaticResource RepairIcon}" />
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="{DynamicResource TrBtnRepair}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="3"
                        Width="150"
                        Height="40"
                        Margin="10,0,0,20"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Command="{Binding ModifyCommand}"
                        FontSize="16"
                        Style="{StaticResource BtnActionDark}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Margin="8" Template="{StaticResource ModifyIcon}" />
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="{DynamicResource TrBtnModify}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="4"
                        Width="150"
                        Height="40"
                        Margin="10,30,0,0"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Command="{Binding UninstallCommand}"
                        FontSize="16"
                        Style="{StaticResource BtnActionDark}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Margin="8" Template="{StaticResource UninstallIcon}" />
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="{DynamicResource TrBtnUninstall}" />
                        </StackPanel>
                    </Button>

                </Grid>
            </Border>


        </Grid>

        <Grid Name="ModifyReadyPage" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SetupWorkflow}" Value="{x:Static vmEnums:ClipboxSetupWorkflow.Modify}" />
                                <Condition Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Done}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SetupWorkflow}" Value="{x:Static vmEnums:ClipboxSetupWorkflow.Update}" />
                                <Condition Binding="{Binding SetupState}" Value="{x:Static vmEnums:ClipboxSetupState.Done}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="40,60,40,0"
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="White"
                TextAlignment="Center"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{DynamicResource TrLblUninstalled}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModifyAction}" Value="{x:Static vmEnums:ClipboxModifyAction.Repair}">
                                <Setter Property="Text" Value="{DynamicResource TrLblRepaired}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ModifyAction}" Value="{x:Static vmEnums:ClipboxModifyAction.Modify}">
                                <Setter Property="Text" Value="{DynamicResource TrLblModified}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SetupWorkflow}" Value="{x:Static vmEnums:ClipboxSetupWorkflow.Update}">
                                <Setter Property="Text" Value="{DynamicResource TrLblUpdated}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock
                Grid.Row="1"
                Margin="0,60,0,35"
                HorizontalAlignment="Center"
                FontSize="16"
                Foreground="#b2b2b2"
                Text="{DynamicResource TrLblRestartRequired}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{Binding IsRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Grid.Row="2"
                Width="220"
                Height="50"
                Margin="10,0,0,0"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                Click="ButtonRestartNow_Click"
                Content="{DynamicResource TrBtnRestartNow}"
                FontSize="16"
                Style="{StaticResource BtnDefaultAction}"
                Visibility="{Binding IsRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Grid.Row="3"
                Width="220"
                Height="40"
                Margin="10,20,0,0"
                VerticalContentAlignment="Center"
                Command="{Binding QuitCommand}"
                Content="{DynamicResource TrBtnRestartLater}"
                FontSize="16"
                Style="{StaticResource BtnActionDark}"
                Visibility="{Binding IsRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Button
                Grid.Row="2"
                Width="170"
                Height="45"
                Margin="0,100,0,0"
                HorizontalAlignment="Center"
                Command="{Binding QuitCommand}"
                Content="{DynamicResource TrBtnOperationComplete}"
                FontSize="16">
                <Button.Style>
                    <Style BasedOn="{StaticResource BtnDefaultAction}" TargetType="Button">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRestartRequired}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

    </Grid>
