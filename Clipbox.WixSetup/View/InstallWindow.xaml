                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="White"
                Text="Clipbox Installer" />
        </Grid>
        <Viewbox Grid.Row="1" Height="100">
