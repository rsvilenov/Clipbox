        <Style x:Key="ToggleBtnCut" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Name="btnBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentControl Name="content" Foreground="{TemplateBinding Foreground}" Template="{DynamicResource CutIcon}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

                <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDark1Brush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDark2Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleBtnCopy" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Name="btnBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentControl Name="content" Foreground="{TemplateBinding Foreground}" Template="{DynamicResource CopyIcon}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDark1Brush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDark2Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </UserControl.Resources>
    <Grid HorizontalAlignment="Left" Margin="10,0,0,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ToggleButton Name="TgCopy" Grid.Column="0"
            Checked="TgCopy_Checked"
            Style="{DynamicResource ToggleBtnCopy}"
            ToolTip="Copy"
            Width="30" Height="30" />
        <ToggleButton Name="TgCut" Grid.Column="1"
            Checked="TgCut_Checked"
            Style="{DynamicResource ToggleBtnCut}"
            ToolTip="Cut"
            Width="30" Height="30" />
    </Grid>
</UserControl>
