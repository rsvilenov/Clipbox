<UserControl
    x:Class="Clipbox.Infrastructure.UI.ColorPicker.ColorPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Clipbox.Infrastructure.UI.ColorPicker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="350"
    mc:Ignorable="d">
    <Border
        x:Name="mainBorder"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1">
        <Grid Margin="15" Background="{DynamicResource TaskbarColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <local:ColorPicker
                x:Name="colorPicker"
                Grid.Row="0"
                Grid.ColumnSpan="2" />
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Text="{Binding ElementName=colorPicker, StringFormat={}R: {0}, Path=SelectedColor.R}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Text="{Binding ElementName=colorPicker, StringFormat={}G: {0}, Path=SelectedColor.G}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Text="{Binding ElementName=colorPicker, StringFormat={}B: {0}, Path=SelectedColor.B}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Text="{Binding ElementName=colorPicker, StringFormat={}H: {0}, Path=SelectedColorHSV.HueRounded}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Text="{Binding ElementName=colorPicker, StringFormat={}S: {0}%, Path=SelectedColorHSV.SaturationPercentRounded}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    Text="{Binding ElementName=colorPicker, StringFormat={}V: {0}%, Path=SelectedColorHSV.ValuePercentRounded}" />
            </Grid>

            <customControls:SearchTextBox
                x:Name="searchTextBox"
                Grid.Row="1"
                Grid.Column="1"
                Height="30"
                Margin="25,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                Foreground="{DynamicResource ControlForegroundBrush}"
                SearchRequested="SearchTextBox_SearchRequested" />

            <Button
                Grid.Row="3"
                Grid.Column="0"
                Width="100"
                Height="25"
                Margin="0,25,0,0"
                HorizontalAlignment="Left"
                Command="{Binding OkClicked}"
                Content="OK"
                Foreground="{DynamicResource ControlForegroundBrush}"
                Style="{DynamicResource BtnOk}" />
            <Button
                Grid.Row="3"
                Grid.Column="1"
                Width="100"
                Height="25"
                Margin="0,25,0,0"
                HorizontalAlignment="Right"
                Command="{Binding CancelClicked}"
                Content="Cancel"
                Foreground="{DynamicResource ControlForegroundBrush}"
                Style="{DynamicResource BtnCancel}" />

        </Grid>
    </Border>
</UserControl>
