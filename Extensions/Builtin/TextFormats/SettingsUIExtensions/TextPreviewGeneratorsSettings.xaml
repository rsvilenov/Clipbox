<UserControl
    x:Class="Clipbox.Extensions.BuiltIn.TextFormats.SettingsUIExtensions.TextPreviewGeneratorsSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Extensions.BuiltIn.TextFormats.SettingsUIExtensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="Auto"
    Height="Auto"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Slider.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,20,0,0"
            VerticalAlignment="Center"
            Text="{loc:Localize LBL_COMPACTIFY,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />

        <customControls:ToggleSwitch
            Grid.Row="1"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            IsChecked="{Binding IsCompactifyToggled, Mode=TwoWay}"
            OffText="Off"
            OnText="On" />

        <TextBlock
            Grid.Row="2"
            Margin="0,20,0,0"
            VerticalAlignment="Center"
            Text="{loc:Localize TTP_PRESERVE_ORIG_FONT_PROPS,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />

        <customControls:ToggleSwitch
            Grid.Row="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            IsChecked="{Binding IsPreserveOriginalFontPropertiesToggled, Mode=TwoWay}"
            OffText="Off"
            OnText="On" />

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.ColumnSpan="3"
                Margin="0,20,0,0"
                VerticalAlignment="Center"
                Text="{loc:Localize LBL_FONT_SIZE,
                                    ResourceLookupMode=CurrentAssembly}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{loc:Localize LBL_SMALLER,
                                    ResourceLookupMode=CurrentAssembly}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{loc:Localize LBL_LARGER,
                                    ResourceLookupMode=CurrentAssembly}"
                TextWrapping="Wrap" />
            <Slider
                Grid.Row="1"
                Grid.Column="1"
                Margin="20"
                Maximum="32"
                Minimum="6"
                Template="{StaticResource MinimalisticSlider}"
                TickFrequency="1"
                Value="{Binding SelectedFontSize}" />
        </Grid>

    </Grid>
</UserControl>
