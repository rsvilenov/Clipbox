                                    RenderTransformOrigin="0.5,0.5"
                                    Stretch="Uniform" />
                            </Grid>
                        </Viewbox>
                    </ControlTemplate>

                    <ControlTemplate x:Key="ColorPickerIcon">
                        <Viewbox>
                            <Grid
                                Width="128"
                                Height="128"
                                Visibility="Visible">
                                <Path
                                    Width="88"
                                    Height="88"
                                    Margin="0,0,0,0"
