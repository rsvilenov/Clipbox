<infUI:SettingUIPart
    x:Class="Clipbox.Extensions.BuiltIn.TextFormats.SettingsUIExtensions.SettingUIParts.PasswordLengthSettingUIPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Extensions.BuiltIn.TextFormats.SettingsUIExtensions.SettingUIParts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="sys:String"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infConv:BooleanToVisibilityHiddenConverter x:Key="BooleanToVisibilityHiddenConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{loc:Localize LBL_SKIP_PASSWORD_LEN_MIN,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />
        <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Width="30"
            Margin="15,0,0,0"
            VerticalAlignment="Center"
            Background="Transparent"
            CaretBrush="White"
            Foreground="White"
            PreviewTextInput="TextBox_PreviewTextInput"
            Text="{Binding MinPasswordLength, TargetNullValue='', FallbackValue=0, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="TextBox_TextChanged" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{loc:Localize LBL_SKIP_PASSWORD_LEN_MAX,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Width="30"
            Margin="15,0,0,0"
            VerticalAlignment="Center"
            Background="Transparent"
            CaretBrush="White"
            Foreground="White"
            PreviewTextInput="TextBox_PreviewTextInput"
            Text="{Binding MaxPasswordLength, TargetNullValue='', FallbackValue=0, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="TextBox_TextChanged" />
    </Grid>
</infUI:SettingUIPart>
