<infUI:SettingUIPart
    x:Class="Clipbox.Extensions.BuiltIn.TextFormats.SettingsUIExtensions.SettingUIParts.ProcessCCNumbersSettingUIPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Extensions.BuiltIn.TextFormats.SettingsUIExtensions.SettingUIParts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="sys:Boolean"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ControlTemplate x:Key="WarningIcon">
                <Viewbox>
                    <Grid
                        Width="128"
                        Height="128"
                        Background="Transparent"
                        Visibility="Visible">
                        <Path
                            Width="94"
                            Height="94"
                            Margin="0,0,0,0"
                            Data="M15.054998,24.963038L17.054998,24.963038 17.054998,27.975014 15.054998,27.975014z M15.07899,11.655045L17.07899,11.655045 17.07899,21.945045 15.07899,21.945045z M16.059,4.4720001L3.2419996,30 28.77,30z M16.067,0L31.999999,32 0,32z"
                            Fill="{TemplateBinding Foreground}"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="Uniform">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <TransformGroup.Children>
                                        <RotateTransform Angle="0" />
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </TransformGroup.Children>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Viewbox>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{loc:Localize LBL_PROCESS_CC_NUMBERS,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />


        <ContentControl
            Grid.Row="0"
            Grid.Column="1"
            Width="35"
            Height="35"
            Margin="5,0,0,0"
            Foreground="Yellow"
            Template="{StaticResource WarningIcon}"
            ToolTip="{loc:Localize TTP_PROCESS_CC_NUMBERS_WARNING,
                                   ResourceLookupMode=CurrentAssembly}" />



        <customControls:ToggleSwitch
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            IsChecked="{Binding IsProcessCCNumbersToggled, Mode=TwoWay}"
            OffText="{loc:Localize TGL_BTN_LBL_Off,
                                   ResourceLookupMode=CurrentAssembly}"
            OnText="{loc:Localize TGL_BTN_LBL_On,
                                  ResourceLookupMode=CurrentAssembly}" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            VerticalAlignment="Center"
            Foreground="DarkGray"
            Text="{loc:Localize LBL_PROCESS_CC_NUMBERS_INFO,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />

    </Grid>
</infUI:SettingUIPart>
