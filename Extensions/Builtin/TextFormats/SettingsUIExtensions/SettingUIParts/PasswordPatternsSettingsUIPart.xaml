<infUI:SettingUIPart
    x:Class="Clipbox.Extensions.BuiltIn.TextFormats.SettingsUIExtensions.SettingUIParts.PasswordPatternsSettingsUIPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Extensions.BuiltIn.TextFormats.SettingsUIExtensions.SettingUIParts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="sys:Int32"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            Text="{loc:Localize LBL_SKIP_PASSWORDS_PATTERN_DESC,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />

        <!--  pattern 1  -->
        <ToggleButton
            Grid.Row="1"
            Grid.Column="0"
            Width="27"
            Height="27"
            Margin="0,8,12,0"
            IsChecked="{Binding IsPasswordPattern1Toggled}"
            Style="{StaticResource CheckBox}" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Bottom"
            Text="{loc:Localize LBL_SKIP_PASSWORDS_PATTERN1,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />

        <!--  pattern 2  -->
        <ToggleButton
            Grid.Row="2"
            Grid.Column="0"
            Width="27"
            Height="27"
            Margin="0,8,12,0"
            IsChecked="{Binding IsPasswordPattern2Toggled}"
            Style="{StaticResource CheckBox}" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="1"
            VerticalAlignment="Bottom"
            Text="{loc:Localize LBL_SKIP_PASSWORDS_PATTERN2,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />

        <!--  pattern 3  -->
        <ToggleButton
            Grid.Row="3"
            Grid.Column="0"
            Width="27"
            Height="27"
            Margin="0,8,12,0"
            IsChecked="{Binding IsPasswordPattern3Toggled}"
            Style="{StaticResource CheckBox}" />

        <TextBlock
            Grid.Row="3"
            Grid.Column="1"
            VerticalAlignment="Bottom"
            Text="{loc:Localize LBL_SKIP_PASSWORDS_PATTERN3,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />

        <!--  pattern 4  -->
        <ToggleButton
            Grid.Row="4"
            Grid.Column="0"
            Width="27"
            Height="27"
            Margin="0,8,12,0"
            IsChecked="{Binding IsPasswordPattern4Toggled}"
            Style="{StaticResource CheckBox}" />

        <TextBlock
            Grid.Row="4"
            Grid.Column="1"
            VerticalAlignment="Bottom"
            Text="{loc:Localize LBL_SKIP_PASSWORDS_PATTERN4,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />
    </Grid>
</infUI:SettingUIPart>