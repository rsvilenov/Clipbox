<infUI:SettingUIPart
    x:Class="Clipbox.Extensions.BuiltIn.TextFormats.SettingsUIExtensions.SettingUIParts.SkipShortStringsSettingsUIPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:infUI="clr-namespace:Clipbox.Infrastructure.UI.Extensibility;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:local="clr-namespace:Clipbox.Extensions.BuiltIn.TextFormats.SettingsUIExtensions.SettingUIParts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="sys:Int32"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI.CustomControls;component/Styles/ToggleSwitchWindows10.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infConv:BooleanToVisibilityHiddenConverter x:Key="BooleanToVisibilityHiddenConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            VerticalAlignment="Center"
            Text="{loc:Localize LBL_SKIP_SHORT_STRINGS,
                                ResourceLookupMode=CurrentAssembly}"
            TextWrapping="Wrap" />

        <customControls:ToggleSwitch
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            IsChecked="{Binding IsShipShortStringsToggled, Mode=TwoWay}"
            OffText="{loc:Localize TGL_BTN_LBL_Off,
                                   ResourceLookupMode=CurrentAssembly}"
            OnText="{loc:Localize TGL_BTN_LBL_On,
                                  ResourceLookupMode=CurrentAssembly}" />

        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Visibility="{Binding IsShipShortStringsToggled, Converter={StaticResource BooleanToVisibilityHiddenConverter}}">
            <TextBlock
                VerticalAlignment="Center"
                Text="{loc:Localize LBL_SKIP_SHORTER_THAN,
                                    ResourceLookupMode=CurrentAssembly}"
                TextWrapping="Wrap" />
            <customControls:IntUpDown
                Grid.Row="1"
                Width="75"
                Height="28"
                Margin="10,0,10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="White"
                Maximum="99"
                Minimum="1"
                Value="{Binding MinTextLength, TargetNullValue='', FallbackValue=0, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{loc:Localize LBL_SKIP_SHORTER_THAN_CHARS,
                                    ResourceLookupMode=CurrentAssembly}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</infUI:SettingUIPart>
