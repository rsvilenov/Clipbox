<UserControl x:Class="Clipbox.Extensions.BuiltIn.TextFormats.UIExtensions.MultipleTextSelectionsAlignment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="300">
    <UserControl.Resources>
        <ControlTemplate x:Key="JustifyIcon">
            <Viewbox>
                <Grid Width="128" Height="128" Visibility="Visible">
                    <Path Data="M0,28.340997L32,28.340997 32,30.340998 0,30.340998z M2.384186E-06,14.169986L32.000004,14.169986 32.000004,16.169986 2.384186E-06,16.169986z M2.384186E-06,0L32.000004,0 32.000004,2 2.384186E-06,2z" Stretch="Uniform" Fill="#FFFFFFFF" Width="68" Height="68" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <TransformGroup.Children>
                                    <RotateTransform Angle="0" />
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </TransformGroup.Children>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Viewbox>
        </ControlTemplate>

        <Style x:Key="ToggleBtnJustify" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Name="btnBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentControl Name="content" Foreground="{TemplateBinding Foreground}" Template="{DynamicResource JustifyIcon}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDark1Brush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDark2Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Left" Margin="10,0,0,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ToggleButton Name="TgNoSeparator" Grid.Column="0"
            Checked="ToggleButtonNoSeparator_Checked"
            Style="{DynamicResource ToggleBtnJustify}"
            ToolTip="Paste without formatting"
            Width="30" Height="30" />
        <ToggleButton Name="TgSpace" Grid.Column="1"
            Checked="ToggleButtonSpace_Checked"
            Style="{DynamicResource ToggleBtnJustify}"
            ToolTip="Paste without formatting"
            Width="30" Height="30" />
        <ToggleButton Name="TgNewLine" Grid.Column="2"
            Checked="ToggleButtonNewLine_Checked"
            Style="{DynamicResource ToggleBtnJustify}"
            ToolTip="Paste without formatting"
            Width="30" Height="30" />
    </Grid>
</UserControl>
