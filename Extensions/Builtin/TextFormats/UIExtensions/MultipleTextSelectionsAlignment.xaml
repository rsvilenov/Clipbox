                                    </TransformGroup.Children>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Viewbox>

            </ControlTemplate>



            <Style
                x:Key="NoSeparatorToggleBtnStyle"
                BasedOn="{StaticResource ToggleBtnSeparatorBase}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentControl Foreground="{TemplateBinding Foreground}" Template="{DynamicResource NoSeparatorIcon}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="SpaceSeparatorToggleBtnStyle"
                BasedOn="{StaticResource ToggleBtnSeparatorBase}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentControl Foreground="{TemplateBinding Foreground}" Template="{DynamicResource SpaceSeparatorIcon}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="NewLineSeparatorToggleBtnStyle"
                BasedOn="{StaticResource ToggleBtnSeparatorBase}"
                TargetType="{x:Type ToggleButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentControl Foreground="{TemplateBinding Foreground}" Template="{DynamicResource NewLineSeparatorIcon}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid
        Margin="10,0,0,5"
        HorizontalAlignment="Left"
        VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ToggleButton
            Name="TgNoSeparator"
            Grid.Column="0"
            Margin="2,0"
            Checked="ToggleButtonNoSeparator_Checked"
            Style="{StaticResource NoSeparatorToggleBtnStyle}"
            ToolTip="Paste items one next to the other" />
        <ToggleButton
            Name="TgSpace"
            Grid.Column="1"
            Margin="2,0"
            Checked="ToggleButtonSpace_Checked"
            Style="{StaticResource SpaceSeparatorToggleBtnStyle}"
            ToolTip="Paste with a space between items" />
        <ToggleButton
            Name="TgNewLine"
            Grid.Column="2"
            Margin="2,0"
            Checked="ToggleButtonNewLine_Checked"
            Style="{StaticResource NewLineSeparatorToggleBtnStyle}"
            ToolTip="Paste each item on a new line" />
    </Grid>
</UserControl>
