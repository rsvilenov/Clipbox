<UserControl
    x:Class="Clipbox.Extensions.BuiltIn.General.SettingsUIExtensions.SettingUIParts.InstalledApplicationSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Clipbox.Infrastructure.UI.CustomControls;assembly=Clipbox.Infrastructure.UI.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:infBeh="clr-namespace:Clipbox.Infrastructure.UI.Behaviors;assembly=Clipbox.Infrastructure.UI"
    xmlns:infConv="clr-namespace:Clipbox.Infrastructure.UI.Converters;assembly=Clipbox.Infrastructure.UI"
    xmlns:loc="clr-namespace:Clipbox.Infrastructure.UI.Localization;assembly=Clipbox.Infrastructure.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clipbox.Infrastructure.UI;component/Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infConv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <Style BasedOn="{StaticResource MinimalisticScrollBarStyle}" TargetType="ScrollBar">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Margin" Value="0,5,2,5" />
            </Style>

            <ControlTemplate x:Key="BrowseIcon">
                <Viewbox>
                    <Grid
                        Width="128"
                        Height="128"
                        Visibility="Visible">
                        <Path
                            Width="92"
                            Height="92"
                            Margin="0,0,0,0"
                            Data="M0.9370065,0L13.389938,0C13.620893,1.9479558E-07,13.843915,0.085998713,14.015911,0.2390138L16.510893,2.4770197C16.894861,2.8220209 16.927881,3.4129938 16.581875,3.7990109 16.235868,4.1870111 15.645906,4.2160028 15.259923,3.8699943L13.031908,1.8730159 1.872975,1.8730159 1.872975,22.477016 27.112821,22.477016 29.922802,8.3500046 8.2189473,8.3350204 6.65493,14.111996C6.524926,14.61401 6.0219382,14.916012 5.5139454,14.786007 5.0129717,14.656002 4.7129858,14.145016 4.8409756,13.644009L6.5849231,7.165007C6.6919783,6.7510055,7.0649622,6.4620041,7.4929379,6.4620041L31.063787,6.4770187C31.345829,6.4770187 31.610781,6.6029953 31.787783,6.8189987 31.96582,7.0370163 32.036802,7.3220199 31.981811,7.5960067L28.798847,23.597009C28.712849,24.03399,28.326803,24.35,27.880821,24.35L0.9370065,24.35C0.41900396,24.35,0,23.930993,0,23.413995L0,0.93600464C0,0.41900644,0.41900396,1.9479558E-07,0.9370065,0z"
                            Fill="{TemplateBinding Foreground}"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="Uniform">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <TransformGroup.Children>
                                        <RotateTransform Angle="0" />
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </TransformGroup.Children>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Viewbox>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        x:Name="mainBorder"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1">
        <Grid
            Width="600"
            Height="550"
            Margin="15"
            Background="{DynamicResource TaskbarColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2.5*" />
                <RowDefinition Height="2.5*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Template="{DynamicResource SourceWindowsIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl
                    Grid.Column="0"
                    Width="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Template="{DynamicResource LoadingSolidIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <StackPanel
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="18"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Text="{loc:Localize LBL_INSTALLED_APP_SELECTOR_TITLE,
                                            ResourceLookupMode=CurrentAssembly}" />
                </StackPanel>

            </Grid>


            <GroupBox
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Padding="15"
                VerticalAlignment="Stretch"
                BorderBrush="DarkGray"
                BorderThickness="0.3"
                Foreground="{DynamicResource ControlForegroundBrush}">
                <GroupBox.Header>
                    <TextBlock Text="{loc:Localize LBL_BLACKLISTED_APPS_LIST, ResourceLookupMode=CurrentAssembly}">
                        <i:Interaction.Behaviors>
                            <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                        </i:Interaction.Behaviors>
                    </TextBlock>
                </GroupBox.Header>

                <Grid>
                    <ListView
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        ItemsSource="{Binding SelectedApps}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="10" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <ContentPresenter
                                                Margin="5,0,0,5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderBrush="DarkGray"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                    <Grid Margin="5,3,3,5" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            MaxHeight="20"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="{Binding Path=Icon}"
                                            ToolTip="{Binding Path=ProductName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="{Binding ProductName}">
                                            <i:Interaction.Behaviors>
                                                <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                                            </i:Interaction.Behaviors>
                                        </TextBlock>
                                        <Button
                                            Grid.Column="2"
                                            MaxWidth="15"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveApplication, ElementName=mainBorder}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource BtnRemove}"
                                            ToolTip="{loc:Localize TTP_BLACKLISTED_APPS_REMOVE,
                                                                   ResourceLookupMode=CurrentAssembly}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Text="{loc:Localize LBL_BLACKLISTED_APPS_SELECT_APPS_MSG,
                                            ResourceLookupMode=CurrentAssembly}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=SelectedApps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </GroupBox>


            <GroupBox
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Padding="15"
                VerticalAlignment="Stretch"
                BorderBrush="DarkGray"
                BorderThickness="0.3"
                Foreground="{DynamicResource ControlForegroundBrush}">
                <GroupBox.Header>
                    <TextBlock Text="{loc:Localize LBL_BLACKLISTED_APPS_INSTALLED_LIST, ResourceLookupMode=CurrentAssembly}">
                        <i:Interaction.Behaviors>
                            <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                        </i:Interaction.Behaviors>
                    </TextBlock>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <customControls:SearchTextBox
                            x:Name="searchTextBox"
                            Grid.Column="0"
                            Height="30"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            OverlayText="{loc:Localize LBL_BLACKLIST_SEARCH_OVERLAY}"
                            SearchRequested="SearchTextBox_SearchRequested" />
                        <Button
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Margin="10,0,0,0"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Command="{Binding BrowseApplication}"
                            Foreground="{DynamicResource ControlForegroundBrush}"
                            Style="{StaticResource IconButton}"
                            ToolTip="{loc:Localize TTP_BROWSE_APP,
                                                   ResourceLookupMode=CurrentAssembly}">
                            <ContentControl Template="{StaticResource BrowseIcon}" />
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="availableAppsListView"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                        ItemsSource="{Binding AppInfoCollection}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="10" Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <ContentPresenter
                                                Margin="5,0,0,5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderBrush="DarkGray"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                    <Grid Margin="5,3,3,5" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            MaxHeight="20"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="{Binding Path=Icon}"
                                            ToolTip="{Binding Path=ProductName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="{Binding ProductName}">
                                            <i:Interaction.Behaviors>
                                                <infBeh:FrameworkElementDpiScalingBehavior MaxScaleFactor="1.5" />
                                            </i:Interaction.Behaviors>
                                        </TextBlock>
                                        <Button
                                            Grid.Column="2"
                                            MaxWidth="15"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.AddApplication, ElementName=mainBorder}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource BtnAdd}"
                                            ToolTip="{loc:Localize TTP_BLACKLISTED_APPS_ADD,
                                                                   ResourceLookupMode=CurrentAssembly}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </GroupBox>


            <Button
                x:Name="btnOk"
                Grid.Row="3"
                Grid.Column="0"
                Width="70"
                Height="30"
                Margin="10"
                VerticalAlignment="Center"
                Command="{Binding OkClicked}"
                Content="{loc:Localize BTN_LBL_Ok,
                                       ResourceLookupMode=CurrentAssembly}"
                Foreground="White"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                Style="{DynamicResource BtnOk}" />

            <Button
                x:Name="btnCancel"
                Grid.Row="3"
                Grid.Column="1"
                Width="90"
                Height="30"
                Margin="10"
                VerticalAlignment="Center"
                Command="{Binding CancelClicked}"
                Content="{loc:Localize BTN_LBL_Cancel,
                                       ResourceLookupMode=CurrentAssembly}"
                Foreground="White"
                Style="{DynamicResource BtnCancel}" />
        </Grid>
    </Border>
</UserControl>
